--- a/build/cmake/CMakeLists.txt
+++ b/build/cmake/CMakeLists.txt
@@ -33,11 +33,16 @@
 set(ZSTD_SHORT_VERSION "${zstd_VERSION_MAJOR}.${zstd_VERSION_MINOR}")
 set(ZSTD_FULL_VERSION "${zstd_VERSION_MAJOR}.${zstd_VERSION_MINOR}.${zstd_VERSION_PATCH}")
 
+set(zstd_LANGUAGES C ASM CXX)
+if(CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
+  # The Emscripten CMake toolchain does not define an assembler, so enabling
+  # the ASM language fails the generate step with
+  # "Missing variable is: CMAKE_ASM_COMPILE_OBJECT".
+  list(REMOVE_ITEM zstd_LANGUAGES ASM)
+endif()
 project(zstd
   VERSION "${ZSTD_FULL_VERSION}"
-  LANGUAGES C   # Main library is in C
-            ASM # And ASM
-            CXX # Testing contributed code also utilizes CXX
+  LANGUAGES ${zstd_LANGUAGES}
   )
 
 message(STATUS "ZSTD VERSION: ${zstd_VERSION}")
--- a/build/cmake/lib/CMakeLists.txt
+++ b/build/cmake/lib/CMakeLists.txt
@@ -7,7 +7,12 @@
 # in the COPYING file in the root directory of this source tree).
 # ################################################################
 
-project(libzstd C ASM)
+if(CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
+  # Same as the parent zstd project: there is no assembler under Emscripten.
+  project(libzstd C)
+else()
+  project(libzstd C ASM)
+endif()
 
 set(CMAKE_INCLUDE_CURRENT_DIR TRUE)
 option(ZSTD_BUILD_STATIC "BUILD STATIC LIBRARIES" ON)
