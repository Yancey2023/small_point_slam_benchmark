+        const slam_benchmark::SensorDefinition &camera,
+        const slam_benchmark::SensorDefinition *imu,
+        const std::filesystem::path &config_path);
+    void process_image(const slam_benchmark::SensorSample &sample,
+                       const slam_benchmark::ImageFrame &frame);
+
+    Mode mode_;
+    slam_benchmark::SensorId camera_id_{};
+    slam_benchmark::SensorId imu_id_{};
+    bool rgb_{};
+    bool finalized_{};
+    Eigen::Matrix4f camera_from_body_{Eigen::Matrix4f::Identity()};
+    std::filesystem::path settings_path_;
