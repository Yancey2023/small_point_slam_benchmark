+cv::Mat OrbSlam3Adapter::convert_image(
+    const slam_benchmark::ImageFrame &frame) const {
+    if (frame.compressed) {
+        const cv::Mat encoded(1, static_cast<int>(frame.data.size()), CV_8UC1,
+                              const_cast<std::byte *>(frame.data.data()));
+        cv::Mat image = cv::imdecode(encoded, cv::IMREAD_COLOR);
+        if (image.empty())
+            throw std::runtime_error("failed to decode compressed camera image");
+        if (rgb_) cv::cvtColor(image, image, cv::COLOR_BGR2RGB);
+        return image;
+    }
+    if (frame.width == 0 || frame.height == 0 || frame.row_stride == 0)
+        throw std::runtime_error("invalid raw camera image dimensions");
+    if (frame.data.size() <
+        static_cast<std::size_t>(frame.row_stride) * frame.height)
+        throw std::runtime_error("raw camera image buffer is truncated");
+    if (frame.encoding == "mono8" || frame.encoding == "8UC1") {
+        return cv::Mat(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                       CV_8UC1, const_cast<std::byte *>(frame.data.data()),
+                       frame.row_stride).clone();
+    }
+    if (frame.encoding != "rgb8" && frame.encoding != "bgr8")
+        throw std::runtime_error("unsupported raw camera encoding: " + frame.encoding);
+    const cv::Mat source(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                         CV_8UC3, const_cast<std::byte *>(frame.data.data()),
+                         frame.row_stride);
+    const bool source_is_rgb = frame.encoding == "rgb8";
+    if (source_is_rgb == rgb_) return source.clone();
+    cv::Mat converted;
+    cv::cvtColor(source, converted,
+                 source_is_rgb ? cv::COLOR_RGB2BGR : cv::COLOR_BGR2RGB);
+    return converted;
+}
+
+void OrbSlam3Adapter::process(const slam_benchmark::SensorSample &sample) {
+    if (mode_ == Mode::ImuMonocular && sample.sensor_id == imu_id_) {
+        const auto started = std::chrono::steady_clock::now();
+        const auto *imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload);
+        if (!imu)
+            throw std::runtime_error("IMU sensor carried a non-IMU payload");
+        pending_imu_.emplace_back(
+            static_cast<float>(imu->linear_acceleration_m_s2[0]),
+            static_cast<float>(imu->linear_acceleration_m_s2[1]),
+            static_cast<float>(imu->linear_acceleration_m_s2[2]),
+            static_cast<float>(imu->angular_velocity_rad_s[0]),
+            static_cast<float>(imu->angular_velocity_rad_s[1]),
+            static_cast<float>(imu->angular_velocity_rad_s[2]),
+            seconds(sample.timestamp_ns));
+        sink_->report_timing({sample.timestamp_ns, "imu_preprocess",
+            std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - started).count()});
+        return;
+    }
+    if (sample.sensor_id == camera_id_) {
+        const auto *frame = std::get_if<slam_benchmark::ImageFrame>(&sample.payload);
+        if (!frame)
+            throw std::runtime_error("camera sensor carried a non-image payload");
+        process_image(sample, *frame);
+    }
+}
+
+void OrbSlam3Adapter::process_image(
+    const slam_benchmark::SensorSample &sample,
+    const slam_benchmark::ImageFrame &frame) {
+    auto started = std::chrono::steady_clock::now();
+    cv::Mat image = convert_image(frame);
+    sink_->report_timing({sample.timestamp_ns, "image_preprocess",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count()});
+
+    started = std::chrono::steady_clock::now();
+    std::vector<ORB_SLAM3::IMU::Point> measurements;
+    if (mode_ == Mode::ImuMonocular) measurements.swap(pending_imu_);
+    const Sophus::SE3f camera_from_world =
+        system_->TrackMonocular(
+            image, seconds(sample.timestamp_ns), measurements);
+    sink_->report_timing({sample.timestamp_ns, "visual_tracking",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count()});
+
+    if (system_->GetTrackingState() != ORB_SLAM3::Tracking::OK) return;
+    const Eigen::Matrix4f world_from_body =
+        camera_from_world.inverse().matrix() * camera_from_body_;
+    const Eigen::Vector3f translation = world_from_body.block<3, 1>(0, 3);
+    Eigen::Quaternionf orientation(world_from_body.block<3, 3>(0, 0));
+    orientation.normalize();
+    if (!translation.allFinite() || !orientation.coeffs().allFinite()) return;
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = sample.timestamp_ns;
+    pose.translation_m = {translation.x(), translation.y(), translation.z()};
+    pose.rotation_xyzw = {orientation.x(), orientation.y(), orientation.z(),
+                          orientation.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void OrbSlam3Adapter::finalize() {
+    if (finalized_) return;
+    finalized_ = true;
+    if (system_) system_->Shutdown();
+    pending_imu_.clear();
+    sink_->report_final_trajectory(trajectory_);
+    std::error_code ignored;
+    std::filesystem::remove(settings_path_, ignored);
+}
