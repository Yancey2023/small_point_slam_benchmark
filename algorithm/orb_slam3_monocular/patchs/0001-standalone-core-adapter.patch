+    src/Atlas.cc
+    src/Map.cc
+    src/Optimizer.cc
+    src/Frame.cc
+    src/KeyFrameDatabase.cc
+    src/Sim3Solver.cc
+    src/ImuTypes.cc
+    src/G2oTypes.cc
+    src/CameraModels/Pinhole.cpp
+    src/CameraModels/KannalaBrandt8.cpp
+    src/OptimizableTypes.cpp
+    src/MLPnPsolver.cpp
+    src/GeometricTools.cc
+    src/TwoViewReconstruction.cc
+    src/Config.cc
+    src/Settings.cc)
+target_compile_features(orb_slam3_frontend PUBLIC cxx_std_20)
+target_include_directories(orb_slam3_frontend PUBLIC
+    "${CMAKE_CURRENT_SOURCE_DIR}"
+    "${CMAKE_CURRENT_SOURCE_DIR}/include"
+    "${CMAKE_CURRENT_SOURCE_DIR}/include/CameraModels"
+    "${CMAKE_CURRENT_SOURCE_DIR}/Thirdparty/Sophus")
+target_link_libraries(orb_slam3_frontend PUBLIC
+    Eigen3::Eigen DBoW2 g2o ${OpenCV_LIBS}
+    Boost::serialization OpenSSL::Crypto spdlog::spdlog)
+target_compile_options(orb_slam3_frontend PUBLIC
+    "-include${CMAKE_CURRENT_SOURCE_DIR}/include/BenchmarkLog.h")
+set_target_properties(orb_slam3_frontend PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+set(_vocabulary_dir "${CMAKE_CURRENT_BINARY_DIR}/Vocabulary")
+set(_vocabulary "${_vocabulary_dir}/ORBvoc.txt")
+add_custom_command(
+    OUTPUT "${_vocabulary}"
+    COMMAND "${CMAKE_COMMAND}" -E make_directory "${_vocabulary_dir}"
+    COMMAND "${CMAKE_COMMAND}" -E chdir "${_vocabulary_dir}"
+            "${CMAKE_COMMAND}" -E tar xzf
+            "${CMAKE_CURRENT_SOURCE_DIR}/Vocabulary/ORBvoc.txt.tar.gz"
+    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Vocabulary/ORBvoc.txt.tar.gz"
+    COMMENT "Extracting ORB-SLAM3 vocabulary")
+add_custom_target(orb_slam3_vocabulary DEPENDS "${_vocabulary}")
+
+function(add_orb_slam3_profile target main_source)
+    add_executable(${target}
+        ${main_source}
+        standalone/orb_slam3_adapter.cpp)
+    target_compile_features(${target} PRIVATE cxx_std_20)
+    target_compile_definitions(${target} PRIVATE
+        ORB_SLAM3_VOCABULARY_PATH="${_vocabulary}")
+    target_link_libraries(${target} PRIVATE
+        orb_slam3_frontend slam_benchmark::core yaml-cpp::yaml-cpp)
+    add_dependencies(${target} orb_slam3_vocabulary)
+endfunction()
+
+add_orb_slam3_profile(
+    orb_slam3_monocular_benchmark standalone/main_monocular.cpp)
+add_orb_slam3_profile(
+    orb_slam3_imu_monocular_benchmark standalone/main_imu_monocular.cpp)
+if(ORB_SLAM3_ENABLE_ASAN AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+    foreach(_target DBoW2 g2o orb_slam3_frontend
+                    orb_slam3_monocular_benchmark
+                    orb_slam3_imu_monocular_benchmark)
+        target_compile_options(${_target} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
+    endforeach()
+    target_link_options(orb_slam3_monocular_benchmark PRIVATE -fsanitize=address)
+    target_link_options(orb_slam3_imu_monocular_benchmark PRIVATE -fsanitize=address)
 endif()
