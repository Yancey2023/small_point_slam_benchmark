+double seconds(slam_benchmark::TimestampNs timestamp) {
+    return static_cast<double>(timestamp) * 1e-9;
+}
+
+template <typename T>
+T parameter(const YAML::Node &root, const char *key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+
+Eigen::Matrix4f matrix(const slam_benchmark::SensorCalibration &calibration) {
+    Eigen::Matrix4f result;
+    for (int row = 0; row < 4; ++row)
+        for (int column = 0; column < 4; ++column)
+            result(row, column) = static_cast<float>(
+                calibration.body_from_sensor[row * 4 + column]);
+    return result;
+}
+
+Eigen::Matrix4f matrix(const slam_benchmark::TransformMatrix &transform) {
+    Eigen::Matrix4f result;
+    for (int row = 0; row < 4; ++row)
+        for (int column = 0; column < 4; ++column)
+            result(row, column) = static_cast<float>(
+                transform[row * 4 + column]);
+    return result;
+}
