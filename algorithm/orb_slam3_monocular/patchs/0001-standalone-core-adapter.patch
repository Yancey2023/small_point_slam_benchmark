diff --git a/include/BenchmarkLog.h b/include/BenchmarkLog.h
new file mode 100644
index 0000000..f9ee48f
--- /dev/null
+++ b/include/BenchmarkLog.h
@@ -0,0 +1,60 @@
+#ifndef ORB_SLAM3_BENCHMARK_LOG_H
+#define ORB_SLAM3_BENCHMARK_LOG_H
+
+#include <spdlog/spdlog.h>
+
+#include <ostream>
+#include <sstream>
+#include <utility>
+
+namespace ORB_SLAM3 {
+
+class BenchmarkLogStream {
+public:
+    explicit BenchmarkLogStream(
+        spdlog::level::level_enum level = spdlog::level::info)
+        : level_(level) {}
+
+    BenchmarkLogStream(const BenchmarkLogStream &) = delete;
+    BenchmarkLogStream &operator=(const BenchmarkLogStream &) = delete;
+    BenchmarkLogStream(BenchmarkLogStream &&) = default;
+
+    ~BenchmarkLogStream() {
+        const std::string message = stream_.str();
+        if (!message.empty()) spdlog::log(level_, "{}", message);
+    }
+
+    template <typename T>
+    BenchmarkLogStream &operator<<(T &&value) {
+        stream_ << std::forward<T>(value);
+        return *this;
+    }
+
+    BenchmarkLogStream &operator<<(std::ostream &(*manipulator)(std::ostream &)) {
+        manipulator(stream_);
+        return *this;
+    }
+
+    BenchmarkLogStream &operator<<(std::ios &(*manipulator)(std::ios &)) {
+        manipulator(stream_);
+        return *this;
+    }
+
+    BenchmarkLogStream &operator<<(std::ios_base &(*manipulator)(std::ios_base &)) {
+        manipulator(stream_);
+        return *this;
+    }
+
+private:
+    spdlog::level::level_enum level_;
+    std::ostringstream stream_;
+};
+
+inline BenchmarkLogStream log_stream(
+    spdlog::level::level_enum level = spdlog::level::info) {
+    return BenchmarkLogStream(level);
+}
+
+}  // namespace ORB_SLAM3
+
+#endif
