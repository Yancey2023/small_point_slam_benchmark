+slam_benchmark::InitializationResult OrbSlam3Adapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path &config_path,
+    slam_benchmark::ResultSink &sink) {
+    const bool use_imu = mode_ == Mode::ImuMonocular;
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.imu = use_imu, .camera = true});
+    if (!compatibility) return compatibility;
+    const auto camera = compatibility.selected_sensor(
+        sensors, slam_benchmark::SensorType::Camera);
+    const auto imu = compatibility.selected_sensor(
+        sensors, slam_benchmark::SensorType::Imu);
+    if (camera == sensors.end() || (use_imu && imu == sensors.end()))
+        return slam_benchmark::InitializationResult::unsupported("ORB-SLAM3 could not select its configured inputs");
+    if (camera->calibration.intrinsics.size() != 4 ||
+        camera->calibration.image_width == 0 ||
+        camera->calibration.image_height == 0)
+        return slam_benchmark::InitializationResult::unsupported(
+            "相机标定需要 [fx, fy, cx, cy] 内参和有效分辨率");
+    if (!camera->calibration.distortion.empty() &&
+        camera->calibration.distortion.size() != 4 &&
+        camera->calibration.distortion.size() != 5)
+        return slam_benchmark::InitializationResult::unsupported(
+            "ORB-SLAM3 针孔相机畸变参数必须包含 4 或 5 个系数");
+
+    camera_id_ = camera->id;
+    if (use_imu) imu_id_ = imu->id;
+    sink_ = &sink;
+    camera_from_body_ = matrix(camera->calibration).inverse();
+    settings_path_ = write_settings(
+        *camera, use_imu ? &*imu : nullptr, config_path);
+
+    system_ = std::make_unique<ORB_SLAM3::System>(
+        ORB_SLAM3_VOCABULARY_PATH, settings_path_.string(),
+        use_imu ? ORB_SLAM3::System::IMU_MONOCULAR
+                : ORB_SLAM3::System::MONOCULAR,
+        false);
+    return compatibility;
+}
+
+std::filesystem::path OrbSlam3Adapter::write_settings(
+    const slam_benchmark::SensorDefinition &camera,
+    const slam_benchmark::SensorDefinition *imu,
+    const std::filesystem::path &config_path) {
+    const YAML::Node config = YAML::LoadFile(config_path.string());
+    rgb_ = parameter(config, "rgb", true);
+    const auto settings = std::filesystem::temp_directory_path() /
+        ("slam_benchmark_" + std::string(name()) + "_" +
+         std::to_string(reinterpret_cast<std::uintptr_t>(this)) + ".yaml");
+    std::ofstream output(settings);
+    if (!output)
+        throw std::runtime_error("failed to create ORB-SLAM3 settings file");
+    output << std::setprecision(12) << std::showpoint;
+    output << "%YAML:1.0\n"
+           << "File.version: \"1.0\"\n"
+           << "Camera.type: \"PinHole\"\n";
+    const auto &intrinsics = camera.calibration.intrinsics;
+    output << "Camera1.fx: " << intrinsics[0] << '\n'
+           << "Camera1.fy: " << intrinsics[1] << '\n'
+           << "Camera1.cx: " << intrinsics[2] << '\n'
+           << "Camera1.cy: " << intrinsics[3] << '\n';
+    const auto &distortion = camera.calibration.distortion;
+    if (!distortion.empty()) {
+        output << "Camera1.k1: " << distortion[0] << '\n'
+               << "Camera1.k2: " << distortion[1] << '\n'
+               << "Camera1.p1: " << distortion[2] << '\n'
+               << "Camera1.p2: " << distortion[3] << '\n';
+        if (distortion.size() == 5)
+            output << "Camera1.k3: " << distortion[4] << '\n';
+    }
+    output << "Camera.width: " << camera.calibration.image_width << '\n'
+           << "Camera.height: " << camera.calibration.image_height << '\n'
+           << "Camera.fps: "
+           << static_cast<int>(std::lround(parameter(config, "camera_fps", 10.0)))
+           << '\n'
+           << "Camera.RGB: " << (rgb_ ? 1 : 0) << '\n'
+           << "ORBextractor.nFeatures: "
+           << parameter(config, "orb_features", 1000) << '\n'
+           << "ORBextractor.scaleFactor: "
+           << parameter(config, "orb_scale_factor", 1.2) << '\n'
+           << "ORBextractor.nLevels: " << parameter(config, "orb_levels", 8)
+           << '\n'
+           << "ORBextractor.iniThFAST: "
+           << parameter(config, "orb_initial_fast_threshold", 20) << '\n'
+           << "ORBextractor.minThFAST: "
+           << parameter(config, "orb_minimum_fast_threshold", 7) << '\n'
+           << "loopClosing: 1\n";
+    if (imu) {
+        const Eigen::Matrix4f imu_from_camera = matrix(
+            slam_benchmark::target_from_source(
+                imu->calibration, camera.calibration));
+        const double frequency = parameter(config, "imu_frequency", 200.0);
+        const double noise_gyro = parameter(config, "imu_noise_gyro", 0.00017);
+        const double noise_acc = parameter(config, "imu_noise_acc", 0.002);
+        const double gyro_walk = parameter(config, "imu_gyro_walk", 0.000019393);
+        const double acc_walk = parameter(config, "imu_acc_walk", 0.003);
+        if (!std::isfinite(frequency) || frequency <= 0.0 ||
+            !std::isfinite(noise_gyro) || noise_gyro <= 0.0 ||
+            !std::isfinite(noise_acc) || noise_acc <= 0.0 ||
+            !std::isfinite(gyro_walk) || gyro_walk <= 0.0 ||
+            !std::isfinite(acc_walk) || acc_walk <= 0.0)
+            throw std::runtime_error(
+                "ORB-SLAM3 IMU frequency and noise parameters must be positive");
+        output << "IMU.T_b_c1: !!opencv-matrix\n"
+               << "   rows: 4\n"
+               << "   cols: 4\n"
+               << "   dt: f\n"
+               << "   data: [";
+        for (int index = 0; index < 16; ++index) {
+            if (index) output << ", ";
+            output << imu_from_camera(index / 4, index % 4);
+        }
+        output << "]\n"
+               << "IMU.NoiseGyro: " << noise_gyro << '\n'
+               << "IMU.NoiseAcc: " << noise_acc << '\n'
+               << "IMU.GyroWalk: " << gyro_walk << '\n'
+               << "IMU.AccWalk: " << acc_walk << '\n'
+               << "IMU.Frequency: " << frequency << '\n'
+               << "IMU.InsertKFsWhenLost: "
+               << (parameter(config, "imu_insert_keyframes_when_lost", true)
+                       ? 1 : 0)
+               << '\n';
+    }
+    output
+           << "Viewer.KeyFrameSize: 0.05\n"
+           << "Viewer.KeyFrameLineWidth: 1.0\n"
+           << "Viewer.GraphLineWidth: 0.9\n"
+           << "Viewer.PointSize: 2.0\n"
+           << "Viewer.CameraSize: 0.08\n"
+           << "Viewer.CameraLineWidth: 3.0\n"
+           << "Viewer.ViewpointX: 0.0\n"
+           << "Viewer.ViewpointY: -0.7\n"
+           << "Viewer.ViewpointZ: -3.5\n"
+           << "Viewer.ViewpointF: 500.0\n";
+    if (!output)
+        throw std::runtime_error("failed to write ORB-SLAM3 settings file");
+    return settings;
+}
