+#include "coin_lio_adapter.hpp"
+
+#include <slam_benchmark/calibration.hpp>
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+#include <omp.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+namespace {
+
+template <typename T>
+T parameter(const YAML::Node& root, const char* key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+
+std::vector<double> doubles(const YAML::Node& root, const char* key) {
+    return root[key] ? root[key].as<std::vector<double>>() : std::vector<double>{};
+}
+
+std::vector<int> integers(const YAML::Node& root, const char* key,
+                          std::vector<int> fallback = {}) {
+    return root[key] ? root[key].as<std::vector<int>>() : std::move(fallback);
+}
+
+double milliseconds_since(const std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration<double, std::milli>(
+               std::chrono::steady_clock::now() - start)
+        .count();
+}
+
+}  // namespace
+
+slam_benchmark::InitializationResult CoinLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .point_time = true,
+                  .intensity = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors,
+                                                      slam_benchmark::SensorType::Lidar);
+    const auto imu = compatibility.selected_sensor(sensors,
+                                                    slam_benchmark::SensorType::Imu);
+    if (lidar == sensors.end() || imu == sensors.end())
+        throw std::runtime_error("COIN-LIO requires one LiDAR and one IMU");
+
+    sink_ = &sink;
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    const int parallel_threads = parameter(root, "parallel_threads", MP_PROC_NUM);
+    if (parallel_threads <= 0) {
+        throw std::runtime_error("parallel_threads must be positive");
+    }
+    omp_set_dynamic(0);
+    omp_set_num_threads(parallel_threads);
+    CoinLioEngine::Options options;
+    options.scan_voxel_size = parameter(root, "filter_size_scan_m", 0.2);
+    options.map_voxel_size = parameter(root, "filter_size_map_m", 0.2);
+    options.cube_side_length = parameter(root, "cube_side_length_m", 1000.0);
+    options.detection_range = parameter(root, "detection_range_m", 150.0F);
+    options.point_filter_stride = parameter(root, "point_filter_stride", 4);
+    options.max_iterations = parameter(root, "max_iterations", 5);
+    options.minimum_geometric_contributions =
+        parameter(root, "minimum_geometric_contributions", 25);
+    options.estimate_extrinsics = parameter(root, "estimate_extrinsics", false);
+    options.geometric_noise = parameter(root, "geometric_noise", 0.001);
+    options.photometric_scale = parameter(root, "photometric_scale", 0.00095);
+    options.gyroscope_covariance.setConstant(parameter(root, "gyroscope_noise", 0.1));
+    options.accelerometer_covariance.setConstant(
+        parameter(root, "accelerometer_noise", 0.1));
+    options.gyroscope_bias_covariance.setConstant(
+        parameter(root, "gyroscope_bias_noise", 0.0001));
+    options.accelerometer_bias_covariance.setConstant(
+        parameter(root, "accelerometer_bias_noise", 0.0001));
+
+    const auto transform =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    options.lidar_rotation << transform[0], transform[1], transform[2],
+        transform[4], transform[5], transform[6], transform[8], transform[9],
+        transform[10];
+    options.lidar_translation << transform[3], transform[7], transform[11];
+
+    const YAML::Node projection = root["intensity_projection"];
+    options.projector.rows = parameter(projection, "rows", std::size_t{64});
+    options.projector.cols = parameter(projection, "columns", std::size_t{1024});
+    if (options.projector.rows < 2)
+        throw std::invalid_argument(
+            "COIN-LIO intensity_projection.rows must be at least 2");
+    options.projector.beam_offset_m = parameter(projection, "beam_offset_m", 0.0);
+    options.projector.column_shift = parameter(projection, "column_shift", 0);
+    options.projector.destagger = parameter(projection, "destagger", false);
+    options.projector.pixel_shift_by_row = integers(
+        projection, "pixel_shift_by_row",
+        std::vector<int>(options.projector.rows, 0));
+    options.projector.elevation_angles_deg = doubles(projection, "elevation_angles_deg");
+    if (options.projector.elevation_angles_deg.empty()) {
+        const double upper = parameter(projection, "elevation_upper_deg", 45.0);
+        const double lower = parameter(projection, "elevation_lower_deg", -45.0);
+        options.projector.elevation_angles_deg.resize(options.projector.rows);
+        for (std::size_t row = 0; row < options.projector.rows; ++row) {
+            const double ratio = static_cast<double>(row) /
+                                 static_cast<double>(options.projector.rows - 1);
+            options.projector.elevation_angles_deg[row] = upper + ratio * (lower - upper);
+        }
+    }
+
+    const YAML::Node image = root["intensity_image"];
+    options.image.reflectivity = parameter(image, "reflectivity", false);
+    options.image.remove_lines = parameter(image, "remove_lines", false);
+    options.image.brightness_filter = parameter(image, "brightness_filter", true);
+    options.image.blur = parameter(image, "blur", true);
+    options.image.intensity_scale = parameter(image, "intensity_scale", 0.25);
+    options.image.erosion_margin = parameter(image, "erosion_margin", 2);
+    options.image.window = integers(image, "window", {41, 7});
+    options.image.masks = integers(image, "masks");
+    options.image.highpass = doubles(image, "highpass");
+    options.image.lowpass = doubles(image, "lowpass");
+
+    const YAML::Node features = root["intensity_features"];
+    options.features.margin = parameter(features, "margin", 10);
+    options.features.min_range = parameter(features, "min_range_m", 0.7);
+    options.features.max_range = parameter(features, "max_range_m", 30.0);
+    options.features.minimum_gradient = parameter(features, "minimum_gradient", 16.5);
+    options.features.ncc_threshold = parameter(features, "ncc_threshold", 0.7075);
+    options.features.range_threshold = parameter(features, "range_threshold_m", 0.2);
+    options.features.suppression_radius = parameter(features, "suppression_radius", 10);
+    options.features.patch_size = parameter(features, "patch_size", 5);
+    options.features.feature_count = parameter(features, "feature_count", 60);
+    options.features.maximum_lifetime = parameter(features, "maximum_lifetime", 25);
+    options.features.selection_mode =
+        parameter(features, "selection_mode", std::string("comp"));
+
+    engine_.set_pose_callback(
+        [this](double timestamp, const state_ikfom& state) { accept_pose(timestamp, state); });
+    engine_.set_timing_callback([this](double timestamp, const char* stage, double duration) {
+        sink_->report_timing(
+            {time_origin_ns_ + static_cast<slam_benchmark::TimestampNs>(
+                                   std::llround(timestamp * 1e9)),
+             stage, duration});
+    });
+    engine_.initialize(options);
+    spdlog::info("COIN-LIO using {} OpenMP compute threads", parallel_threads);
+    spdlog::info("COIN-LIO standalone adapter initialized");
+    return compatibility;
+}
+
+void CoinLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (!have_time_origin_) {
+        time_origin_ns_ = sample.timestamp_ns;
+        have_time_origin_ = true;
+    }
+    const double timestamp =
+        static_cast<double>(sample.timestamp_ns - time_origin_ns_) * 1e-9;
+
+    if (const auto* source = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        const auto started = std::chrono::steady_clock::now();
+        auto value = std::make_shared<ImuData>();
+        value->timestamp = timestamp;
+        value->angular_velocity << source->angular_velocity_rad_s[0],
+            source->angular_velocity_rad_s[1], source->angular_velocity_rad_s[2];
+        value->linear_acceleration << source->linear_acceleration_m_s2[0],
+            source->linear_acceleration_m_s2[1], source->linear_acceleration_m_s2[2];
+        imu_queue_.push_back(std::move(value));
+        sink_->report_timing(
+            {sample.timestamp_ns, "imu_preprocess", milliseconds_since(started)});
+    } else if (const auto* source =
+                   std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (source->points.size() != source->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        MeasureGroup measures;
+        measures.lidar_beg_time = timestamp;
+        measures.lidar_end_time = timestamp;
+        measures.lidar->reserve(source->points.size());
+        for (std::size_t index = 0; index < source->points.size(); ++index) {
+            const auto& input = source->points[index];
+            if (!std::isfinite(input.x) || !std::isfinite(input.y) ||
+                !std::isfinite(input.z) || !std::isfinite(input.intensity))
+                continue;
+            PointType point;
+            point.x = input.x;
+            point.y = input.y;
+            point.z = input.z;
+            point.intensity = input.intensity;
+            point.normal_x = -1.0F;
+            point.normal_y = std::sqrt(input.x * input.x + input.y * input.y +
+                                       input.z * input.z);
+            point.normal_z = 0.0F;
+            const double offset_ms =
+                static_cast<double>(source->point_time_offset_ns[index]) * 1e-6;
+            point.curvature = static_cast<float>(offset_ms);
+            measures.lidar_end_time =
+                std::max(measures.lidar_end_time, timestamp + offset_ms * 1e-3);
+            measures.lidar->push_back(point);
+        }
+        lidar_queue_.push_back(std::move(measures));
+        sink_->report_timing(
+            {sample.timestamp_ns, "lidar_preprocess", milliseconds_since(started)});
+    }
+    process_ready_scans();
+}
+
+void CoinLioAdapter::process_ready_scans() {
+    while (!lidar_queue_.empty() && !imu_queue_.empty() &&
+           imu_queue_.back()->timestamp >= lidar_queue_.front().lidar_end_time) {
+        auto measures = std::move(lidar_queue_.front());
+        lidar_queue_.pop_front();
+        while (!imu_queue_.empty() &&
+               imu_queue_.front()->timestamp <= measures.lidar_end_time) {
+            measures.imu.push_back(imu_queue_.front());
+            imu_queue_.pop_front();
+        }
+        if (!measures.imu.empty()) engine_.process(measures);
+    }
+}
+
+void CoinLioAdapter::accept_pose(double timestamp, const state_ikfom& state) {
+    const auto coefficients = state.rot.coeffs();
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = time_origin_ns_ + static_cast<slam_benchmark::TimestampNs>(
+                                             std::llround(timestamp * 1e9));
+    pose.translation_m = {state.pos[0], state.pos[1], state.pos[2]};
+    pose.rotation_xyzw = {coefficients[0], coefficients[1], coefficients[2],
+                          coefficients[3]};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void CoinLioAdapter::finalize() {
+    process_ready_scans();
+    sink_->report_final_trajectory(trajectory_);
+}
