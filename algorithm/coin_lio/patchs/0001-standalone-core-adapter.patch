diff --git a/include/ikd-Tree/thread_compat.hpp b/include/ikd-Tree/thread_compat.hpp
new file mode 100644
index 0000000..e4d003f
--- /dev/null
+++ b/include/ikd-Tree/thread_compat.hpp
@@ -0,0 +1,54 @@
+#pragma once
+
+#ifdef _WIN32
+
+#include <chrono>
+#include <mutex>
+#include <thread>
+
+struct pthread_mutex_t {
+    std::mutex value;
+};
+
+struct pthread_t {
+    std::thread value;
+
+    explicit operator bool() const noexcept { return value.joinable(); }
+};
+
+inline int pthread_mutex_init(pthread_mutex_t*, const void*) { return 0; }
+inline int pthread_mutex_destroy(pthread_mutex_t*) { return 0; }
+inline int pthread_mutex_lock(pthread_mutex_t* mutex) {
+    mutex->value.lock();
+    return 0;
+}
+inline int pthread_mutex_trylock(pthread_mutex_t* mutex) {
+    return mutex->value.try_lock() ? 0 : 1;
+}
+inline int pthread_mutex_unlock(pthread_mutex_t* mutex) {
+    mutex->value.unlock();
+    return 0;
+}
+
+inline int pthread_create(pthread_t* thread, const void*, void* (*entry)(void*), void* argument) {
+    thread->value = std::thread([entry, argument] { static_cast<void>(entry(argument)); });
+    return 0;
+}
+
+inline int pthread_join(pthread_t& thread, void**) {
+    if (thread.value.joinable()) {
+        thread.value.join();
+    }
+    return 0;
+}
+
+inline void usleep(unsigned int microseconds) {
+    std::this_thread::sleep_for(std::chrono::microseconds(microseconds));
+}
+
+#else
+
+#include <pthread.h>
+#include <unistd.h>
+
+#endif
