new file mode 100644
index 0000000..48090a5
--- /dev/null
+++ b/standalone/fast_lio_adapter.cpp
@@ -0,0 +1,139 @@
+#include "fast_lio_adapter.hpp"
+
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+namespace {
+
+double seconds(slam_benchmark::TimestampNs value) {
+    return static_cast<double>(value) * 1e-9;
+}
+
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+
+template <typename T>
+T parameter(const YAML::Node& root, const char* key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+
+}  // namespace
+
+void FastLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    const auto lidar = std::ranges::find(sensors, slam_benchmark::SensorType::Lidar,
+                                         &slam_benchmark::SensorDefinition::type);
+    const auto imu = std::ranges::find(sensors, slam_benchmark::SensorType::Imu,
+                                       &slam_benchmark::SensorDefinition::type);
+    if (lidar == sensors.end() || imu == sensors.end())
+        throw std::runtime_error("FAST-LIO requires one LiDAR and one IMU");
+
+    sink_ = &sink;
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    FastLioEngine::Options options;
+    options.scan_voxel_size = parameter(root, "filter_size_scan_m", 0.5);
+    options.map_voxel_size = parameter(root, "filter_size_map_m", 0.5);
+    options.cube_side_length = parameter(root, "cube_side_length_m", 200.0);
+    options.detection_range = parameter(root, "detection_range_m", 300.0F);
+    options.max_iterations = parameter(root, "max_iterations", 4);
+    options.estimate_extrinsics = parameter(root, "estimate_extrinsics", false);
+    options.gyroscope_covariance.setConstant(parameter(root, "gyroscope_noise", 0.1));
+    options.accelerometer_covariance.setConstant(parameter(root, "accelerometer_noise", 0.1));
+    options.gyroscope_bias_covariance.setConstant(
+        parameter(root, "gyroscope_bias_noise", 0.0001));
+    options.accelerometer_bias_covariance.setConstant(
+        parameter(root, "accelerometer_bias_noise", 0.0001));
+    const auto& transform = lidar->calibration.body_from_sensor;
+    options.lidar_rotation << transform[0], transform[1], transform[2], transform[4],
+        transform[5], transform[6], transform[8], transform[9], transform[10];
+    options.lidar_translation << transform[3], transform[7], transform[11];
+
+    engine_.set_pose_callback(
+        [this](double timestamp, const state_ikfom& state) { accept_pose(timestamp, state); });
+    engine_.set_timing_callback([this](double timestamp, const char* stage, double duration) {
+        sink_->report_timing({nanoseconds(timestamp), stage, duration});
+    });
+    engine_.initialize(options);
+    spdlog::info("FAST-LIO standalone adapter initialized");
+}
+
+void FastLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        auto value = std::make_shared<ImuData>();
+        value->header.stamp.seconds = seconds(sample.timestamp_ns);
+        value->angular_velocity = {imu->angular_velocity_rad_s[0],
+                                   imu->angular_velocity_rad_s[1],
+                                   imu->angular_velocity_rad_s[2]};
+        value->linear_acceleration = {imu->linear_acceleration_m_s2[0],
+                                      imu->linear_acceleration_m_s2[1],
+                                      imu->linear_acceleration_m_s2[2]};
+        imu_queue_.push_back(std::move(value));
+    } else if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        MeasureGroup measures;
+        measures.lidar_beg_time = seconds(sample.timestamp_ns);
+        measures.lidar->reserve(cloud->points.size());
+        double maximum_offset = 0.0;
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto& source = cloud->points[index];
+            PointType point;
+            point.x = source.x;
+            point.y = source.y;
+            point.z = source.z;
+            point.intensity = source.intensity;
+            point.normal_x = point.normal_y = point.normal_z = 0.0F;
+            const double offset_ms =
+                static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-6;
+            point.curvature = static_cast<float>(offset_ms);
+            maximum_offset = std::max(maximum_offset, offset_ms * 1e-3);
+            measures.lidar->push_back(point);
+        }
+        measures.lidar_end_time = measures.lidar_beg_time + maximum_offset;
+        lidar_queue_.push_back(std::move(measures));
+        const double duration = std::chrono::duration<double, std::milli>(
+                                    std::chrono::steady_clock::now() - started)
+                                    .count();
+        sink_->report_timing({sample.timestamp_ns, "lidar_preprocess", duration});
+    }
+    drain();
+}
+
+void FastLioAdapter::drain() {
+    while (!lidar_queue_.empty() && !imu_queue_.empty() &&
+           imu_queue_.back()->header.stamp.toSec() >= lidar_queue_.front().lidar_end_time) {
+        MeasureGroup measures = std::move(lidar_queue_.front());
+        lidar_queue_.pop_front();
+        while (!imu_queue_.empty() &&
+               imu_queue_.front()->header.stamp.toSec() <= measures.lidar_end_time) {
+            measures.imu.push_back(imu_queue_.front());
+            imu_queue_.pop_front();
+        }
+        if (!measures.imu.empty()) engine_.process(measures);
+    }
+}
+
+void FastLioAdapter::accept_pose(double timestamp, const state_ikfom& state) {
+    const auto coefficients = state.rot.coeffs();
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(timestamp);
+    pose.translation_m = {state.pos[0], state.pos[1], state.pos[2]};
+    pose.rotation_xyzw = {coefficients[0], coefficients[1], coefficients[2], coefficients[3]};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void FastLioAdapter::finalize() {
+    drain();
+    sink_->report_final_trajectory(trajectory_);
+}
