diff --git a/standalone/ctlo_adapter.cpp b/standalone/ctlo_adapter.cpp
new file mode 100644
index 0000000..329ea0f
--- /dev/null
+++ b/standalone/ctlo_adapter.cpp
@@ -0,0 +1,88 @@
+#include "ctlo_adapter.hpp"
+
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+#include <omp.h>
+
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+slam_benchmark::InitializationResult CtloAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(
+        sensors, slam_benchmark::SensorType::Lidar);
+    if (lidar == sensors.end()) {
+        return slam_benchmark::InitializationResult::unsupported("CTLO requires one LiDAR");
+    }
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    const int parallel_threads = root["parallel_threads"]
+        ? root["parallel_threads"].as<int>()
+        : OPENMPTHREAD;
+    if (parallel_threads <= 0) {
+        throw std::runtime_error("parallel_threads must be positive");
+    }
+    omp_set_dynamic(0);
+    omp_set_num_threads(parallel_threads);
+    const auto& transform = lidar->calibration.body_from_sensor;
+    Eigen::Matrix3d rotation;
+    rotation << transform[0], transform[1], transform[2],
+        transform[4], transform[5], transform[6],
+        transform[8], transform[9], transform[10];
+    const ctlo::transform::Rigid3d body_from_lidar(
+        Eigen::Vector3d(transform[3], transform[7], transform[11]),
+        Eigen::Quaterniond(rotation));
+    lidar_from_body_ = body_from_lidar.inversed();
+    sink_ = &sink;
+    odometry_.setTimingCallback([this](const char* stage, double duration_ms) {
+        sink_->report_timing({current_timestamp_, stage, duration_ms});
+    });
+    spdlog::info("CTLO standalone adapter initialized with {} OpenMP compute threads",
+                 parallel_threads);
+    return compatibility;
+}
+
+void CtloAdapter::process(const slam_benchmark::SensorSample& sample) {
+    const auto* source = std::get_if<slam_benchmark::PointCloud>(&sample.payload);
+    if (source == nullptr) return;
+    current_timestamp_ = sample.timestamp_ns;
+
+    const auto started = std::chrono::steady_clock::now();
+    pcl::PointCloud<pcl::PointXYZI> cloud;
+    cloud.reserve(source->points.size());
+    for (const auto& point : source->points) {
+        if (!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z)) {
+            continue;
+        }
+        pcl::PointXYZI converted;
+        converted.x = point.x;
+        converted.y = point.y;
+        converted.z = point.z;
+        converted.intensity = point.intensity;
+        cloud.push_back(converted);
+    }
+    const double conversion_ms = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - started).count();
+    sink_->report_timing({sample.timestamp_ns, "lidar_preprocess", conversion_ms});
+
+    if (cloud.empty()) return;
+    odometry_.process(cloud);
+    const auto state = odometry_.currentPose() * lidar_from_body_;
+    const Eigen::Quaterniond quaternion(state.rotation());
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = sample.timestamp_ns;
+    pose.translation_m = {state.translation().x(), state.translation().y(), state.translation().z()};
+    pose.rotation_xyzw = {quaternion.x(), quaternion.y(), quaternion.z(), quaternion.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void CtloAdapter::finalize() {
+    sink_->report_final_trajectory(trajectory_);
+}
diff --git a/standalone/ctlo_adapter.hpp b/standalone/ctlo_adapter.hpp
new file mode 100644
index 0000000..870600b
--- /dev/null
+++ b/standalone/ctlo_adapter.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <lidar_odometry.hpp>
+#include <slam_benchmark/algorithm.hpp>
+
+class CtloAdapter final : public slam_benchmark::SlamAlgorithm {
+public:
+    [[nodiscard]] std::string_view name() const noexcept override { return "ctlo"; }
+    slam_benchmark::InitializationResult initialize(std::span<const slam_benchmark::SensorDefinition> sensors,
+                    const std::filesystem::path& config_path,
+                    slam_benchmark::ResultSink& sink) override;
+    void process(const slam_benchmark::SensorSample& sample) override;
+    void finalize() override;
+
+private:
+    slam_benchmark::ResultSink* sink_{};
+    ctlo::LidarOdometry odometry_;
+    ctlo::transform::Rigid3d lidar_from_body_ =
+        ctlo::transform::Rigid3d::Identity();
+    slam_benchmark::TimestampNs current_timestamp_{};
+    slam_benchmark::Trajectory trajectory_;
+};
