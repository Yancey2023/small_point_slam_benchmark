new file mode 100644
index 0000000..cd061a6
--- /dev/null
+++ b/standalone/small_point_lio_adapter.cpp
@@ -0,0 +1,110 @@
+#include "small_point_lio_adapter.hpp"
+
+#include <slam_benchmark/calibration.hpp>
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+namespace {
+double seconds(slam_benchmark::TimestampNs value) {
+    return static_cast<double>(value) * 1e-9;
+}
+
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+
+double elapsed_ms(const std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration<double, std::milli>(
+               std::chrono::steady_clock::now() - start).count();
+}
+}  // namespace
+
+slam_benchmark::InitializationResult SmallPointLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .point_time = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = std::ranges::find(sensors, slam_benchmark::SensorType::Lidar,
+                                         &slam_benchmark::SensorDefinition::type);
+    const auto imu = std::ranges::find(sensors, slam_benchmark::SensorType::Imu,
+                                       &slam_benchmark::SensorDefinition::type);
+    if (lidar == sensors.end() || imu == sensors.end())
+        throw std::runtime_error("Small Point LIO requires one LiDAR and one IMU");
+
+    const YAML::Node config = YAML::LoadFile(config_path.string());
+    const auto transform =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    Eigen::Vector3d translation(transform[3], transform[7], transform[11]);
+    Eigen::Matrix3d rotation;
+    rotation << transform[0], transform[1], transform[2],
+        transform[4], transform[5], transform[6],
+        transform[8], transform[9], transform[10];
+
+    sink_ = &sink;
+    algorithm_ = std::make_unique<small_point_lio::SmallPointLio>(
+        config, translation, rotation);
+    algorithm_->set_odometry_callback(
+        [this](const common::Odometry& odometry) { accept_odometry(odometry); });
+    algorithm_->set_timing_callback([this](double timestamp, const char* stage, double duration) {
+        sink_->report_timing({nanoseconds(timestamp), stage, duration});
+    });
+    spdlog::info("Small Point LIO standalone adapter initialized");
+    return {};
+}
+
+void SmallPointLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        const auto started = std::chrono::steady_clock::now();
+        common::ImuMsg message;
+        message.timestamp = seconds(sample.timestamp_ns);
+        message.angular_velocity = Eigen::Vector3d(
+            imu->angular_velocity_rad_s[0], imu->angular_velocity_rad_s[1],
+            imu->angular_velocity_rad_s[2]);
+        message.linear_acceleration = Eigen::Vector3d(
+            imu->linear_acceleration_m_s2[0], imu->linear_acceleration_m_s2[1],
+            imu->linear_acceleration_m_s2[2]);
+        algorithm_->on_imu_callback(message);
+        sink_->report_timing({sample.timestamp_ns, "imu_preprocess", elapsed_ms(started)});
+    } else if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        auto started = std::chrono::steady_clock::now();
+        std::vector<common::Point> points;
+        points.reserve(cloud->points.size());
+        const double base_time = seconds(sample.timestamp_ns);
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto& source = cloud->points[index];
+            if (!std::isfinite(source.x) || !std::isfinite(source.y) || !std::isfinite(source.z))
+                continue;
+            points.push_back({base_time + static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-9,
+                              Eigen::Vector3f(source.x, source.y, source.z)});
+        }
+        sink_->report_timing({sample.timestamp_ns, "lidar_preprocess", elapsed_ms(started)});
+        const double downsampling_duration = algorithm_->on_point_cloud_callback(points);
+        sink_->report_timing(
+            {sample.timestamp_ns, "downsampling", downsampling_duration});
+    }
+    algorithm_->handle_once();
+}
+
+void SmallPointLioAdapter::accept_odometry(const common::Odometry& odometry) {
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(odometry.timestamp);
+    pose.translation_m = {odometry.position.x(), odometry.position.y(), odometry.position.z()};
+    pose.rotation_xyzw = {odometry.orientation.x(), odometry.orientation.y(),
+                          odometry.orientation.z(), odometry.orientation.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void SmallPointLioAdapter::finalize() {
+    algorithm_->handle_once();
+    sink_->report_final_trajectory(trajectory_);
+}
