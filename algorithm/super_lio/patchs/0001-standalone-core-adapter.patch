+++ b/standalone/super_lio_adapter.cpp
@@ -0,0 +1,153 @@
+#include "super_lio_adapter.hpp"
+
+#include "lio/params.h"
+
+#include <yaml-cpp/yaml.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <stdexcept>
+
+namespace {
+
+double seconds(slam_benchmark::TimestampNs value) {
+    return static_cast<double>(value) * 1e-9;
+}
+
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+
+template <typename T>
+T parameter(const YAML::Node& root, const char* key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+
+void load_parameters(const YAML::Node& root,
+                     std::span<const slam_benchmark::SensorDefinition> sensors) {
+    using namespace LI2Sup;
+    g_time_eva = false;
+    g_save_map = false;
+    g_if_filter = true;
+    g_map_ds_size = parameter(root, "filter_size_map_m", 0.5F);
+    g_pcd_save_interval = -1;
+    g_filter_rate = 1;
+    const double blind = parameter(root, "min_range_m", 0.5);
+    const double max_range = parameter(root, "max_range_m", 100.0);
+    g_blind2 = static_cast<float>(blind * blind);
+    g_maxrange2 = static_cast<float>(max_range * max_range);
+    g_enable_downsample = true;
+    g_voxel_fliter_size = parameter(root, "filter_size_scan_m", 0.5F);
+    g_gravity_norm = parameter(root, "gravity_norm_m_s2", 9.81);
+    g_imu_na = parameter(root, "accelerometer_noise", 0.01);
+    g_imu_ng = parameter(root, "gyroscope_noise", 0.1);
+    g_imu_nba = parameter(root, "accelerometer_bias_noise", 0.0001);
+    g_imu_nbg = parameter(root, "gyroscope_bias_noise", 0.0001);
+    g_ivox_capacity = parameter<std::size_t>(root, "map_capacity", 100000);
+    g_ivox_resolution = parameter(root, "map_voxel_size_m", 0.5F);
+    g_kf_max_iterations = parameter(root, "max_iterations", 4);
+    g_kf_quit_eps = parameter(root, "convergence_epsilon", 1e-4);
+    g_visual_map = false;
+    g_flg_map_init = true;
+
+    g_lidar_imu = BASIC::SE3{};
+    g_odom_robo = BASIC::SE3{};
+    g_lidar_robo_yaw = BASIC::M3::Identity();
+    const auto lidar = std::ranges::find(sensors, slam_benchmark::SensorType::Lidar,
+                                         &slam_benchmark::SensorDefinition::type);
+    if (lidar == sensors.end()) throw std::runtime_error("Super-LIO requires a LiDAR");
+    BASIC::M3 rotation;
+    BASIC::V3 translation;
+    const auto& transform = lidar->calibration.body_from_sensor;
+    rotation << transform[0], transform[1], transform[2],
+                transform[4], transform[5], transform[6],
+                transform[8], transform[9], transform[10];
+    translation << transform[3], transform[7], transform[11];
+    g_lidar_imu = BASIC::SE3(rotation, translation);
+}
+
+}  // namespace
+
+void SuperLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    const bool has_imu = std::ranges::any_of(sensors, [](const auto& sensor) {
+        return sensor.type == slam_benchmark::SensorType::Imu;
+    });
+    if (!has_imu) throw std::runtime_error("Super-LIO requires an IMU");
+    sink_ = &sink;
+    load_parameters(YAML::LoadFile(config_path.string()), sensors);
+    algorithm_.setPoseCallback([this](const LI2Sup::NavState& state) { accept_pose(state); });
+    algorithm_.setTimingCallback([this](const char* stage, double time, double duration) {
+        sink_->report_timing({nanoseconds(time), stage, duration});
+    });
+    algorithm_.init();
+    spdlog::info("Super-LIO standalone adapter initialized");
+}
+
+void SuperLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        LI2Sup::IMUData value;
+        value.secs = seconds(sample.timestamp_ns);
+        value.acc << imu->linear_acceleration_m_s2[0], imu->linear_acceleration_m_s2[1],
+                     imu->linear_acceleration_m_s2[2];
+        value.gyr << imu->angular_velocity_rad_s[0], imu->angular_velocity_rad_s[1],
+                     imu->angular_velocity_rad_s[2];
+        imu_queue_.push_back(value);
+    } else if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        LI2Sup::LidarData value;
+        value.start_time = seconds(sample.timestamp_ns);
+        value.pc.reset(new pcl::PointCloud<LI2Sup::PointXTZIT>());
+        value.pc->reserve(cloud->points.size());
+        double maximum_offset = 0.0;
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto& point = cloud->points[index];
+            const double offset = static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-9;
+            maximum_offset = std::max(maximum_offset, offset);
+            value.pc->emplace_back(point.x, point.y, point.z, point.intensity, offset);
+        }
+        value.end_time = value.start_time + maximum_offset;
+        lidar_queue_.push_back(std::move(value));
+        sink_->report_timing(
+            {sample.timestamp_ns, "lidar_preprocess",
+             std::chrono::duration<double, std::milli>(
+                 std::chrono::steady_clock::now() - started)
+                 .count()});
+    }
+    drain();
+}
+
+void SuperLioAdapter::drain() {
+    while (!lidar_queue_.empty() && !imu_queue_.empty() &&
+           imu_queue_.back().secs >= lidar_queue_.front().end_time) {
+        LI2Sup::MeasureGroup measures;
+        measures.lidar = std::move(lidar_queue_.front());
+        lidar_queue_.pop_front();
+        while (!imu_queue_.empty() && imu_queue_.front().secs <= measures.lidar.end_time) {
+            measures.imu.push_back(imu_queue_.front());
+            imu_queue_.pop_front();
+        }
+        if (!measures.imu.empty()) algorithm_.process(measures);
+    }
+}
+
+void SuperLioAdapter::accept_pose(const LI2Sup::NavState& state) {
+    const auto quaternion = state.R.quaternion();
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(state.timestamp);
+    pose.translation_m = {state.p.x(), state.p.y(), state.p.z()};
+    pose.rotation_xyzw = {quaternion.x(), quaternion.y(), quaternion.z(), quaternion.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void SuperLioAdapter::finalize() {
+    drain();
+    sink_->report_final_trajectory(trajectory_);
+}
