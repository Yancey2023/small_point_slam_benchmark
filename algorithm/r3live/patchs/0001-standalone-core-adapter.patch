+#include "r3live_adapter.h"
+
+#include <slam_benchmark/calibration.hpp>
+
+#include <opencv2/imgcodecs.hpp>
+#include <opencv2/imgproc.hpp>
+#include <yaml-cpp/yaml.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+namespace {
+double seconds(slam_benchmark::TimestampNs value) {
+    return static_cast<double>(value) * 1e-9;
+}
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+template <class T>
+T parameter(const YAML::Node &node, const char *key, T fallback) {
+    return node[key] ? node[key].as<T>() : fallback;
+}
+Eigen::Matrix3d rotation(const slam_benchmark::TransformMatrix &transform) {
+    Eigen::Matrix3d result;
+    result << transform[0], transform[1], transform[2],
+              transform[4], transform[5], transform[6],
+              transform[8], transform[9], transform[10];
+    return result;
+}
+Eigen::Vector3d translation(const slam_benchmark::TransformMatrix &transform) {
+    return {transform[3], transform[7], transform[11]};
+}
+}  // namespace
+
+slam_benchmark::InitializationResult R3LiveAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path &config_path,
+    slam_benchmark::ResultSink &sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .camera = true, .point_time = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Lidar);
+    const auto imu = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Imu);
+    const auto camera = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Camera);
+    if (lidar == sensors.end() || imu == sensors.end() || camera == sensors.end())
+        return slam_benchmark::InitializationResult::unsupported("R3LIVE requires LiDAR, IMU and camera inputs");
+    if (camera->calibration.intrinsics.size() != 4 ||
+        camera->calibration.image_width == 0 || camera->calibration.image_height == 0)
+        return slam_benchmark::InitializationResult::unsupported(
+            "R3LIVE 相机标定需要 [fx, fy, cx, cy] 内参和有效分辨率");
+
+    const auto imu_from_lidar = slam_benchmark::target_from_source(
+        imu->calibration, lidar->calibration);
+    if (!rotation(imu_from_lidar).isApprox(Eigen::Matrix3d::Identity(), 1e-6))
+        return slam_benchmark::InitializationResult::unsupported(
+            "当前 R3LIVE 上游前端只支持 LiDAR 与 IMU 轴向平行的标定");
+
+    frontend_ = std::make_unique<R3LIVE>();
+    const YAML::Node config = YAML::LoadFile(config_path.string());
+    frontend_->NUM_MAX_ITERATIONS = parameter(config, "maximum_iterations", 4);
+    frontend_->m_voxel_downsample_size_surf =
+        parameter(config, "lidar_voxel_size_m", 0.5);
+    frontend_->m_voxel_downsample_size_axis_z = frontend_->m_voxel_downsample_size_surf;
+    frontend_->filter_size_map_min = parameter(config, "map_voxel_size_m", 0.5);
+    frontend_->m_long_rang_pt_dis = parameter(config, "maximum_point_range_m", 100.0);
+    frontend_->m_image_downsample_ratio = parameter(config, "visual_downsample", 1.0);
+    frontend_->m_maximum_image_buffer = parameter(config, "maximum_image_buffer", 2);
+    Lidar_offset_to_IMU = translation(imu_from_lidar);
+
+    const auto &intrinsics = camera->calibration.intrinsics;
+    frontend_->m_vio_image_width = camera->calibration.image_width;
+    frontend_->m_vio_image_heigh = camera->calibration.image_height;
+    frontend_->m_camera_intrinsic << intrinsics[0], 0.0, intrinsics[2],
+                                     0.0, intrinsics[1], intrinsics[3],
+                                     0.0, 0.0, 1.0;
+    frontend_->m_camera_dist_coeffs.setZero();
+    for (std::size_t i = 0; i < std::min<std::size_t>(
+             5, camera->calibration.distortion.size()); ++i)
+        frontend_->m_camera_dist_coeffs(static_cast<Eigen::Index>(i)) =
+            camera->calibration.distortion[i];
+    const auto imu_from_camera = slam_benchmark::target_from_source(
+        imu->calibration, camera->calibration);
+    frontend_->m_camera_ext_R = rotation(imu_from_camera);
+    frontend_->m_camera_ext_t = translation(imu_from_camera);
+
+    lidar_id_ = lidar->id;
+    imu_id_ = imu->id;
+    camera_id_ = camera->id;
+    sink_ = &sink;
+    const int parallel_threads = parameter(config, "parallel_threads", 4);
+    if (parallel_threads <= 0)
+        throw std::runtime_error("parallel_threads must be positive");
+    frontend_->start_standalone(parallel_threads);
+    return compatibility;
+}
+
+cv::Mat R3LiveAdapter::convert_image(const slam_benchmark::ImageFrame &frame) const {
+    if (frame.compressed) {
+        cv::Mat encoded(1, static_cast<int>(frame.data.size()), CV_8UC1,
+                        const_cast<std::byte *>(frame.data.data()));
+        cv::Mat result = cv::imdecode(encoded, cv::IMREAD_COLOR);
+        if (result.empty()) throw std::runtime_error("failed to decode compressed image");
+        return result;
+    }
+    if (!frame.width || !frame.height || !frame.row_stride ||
+        frame.data.size() < static_cast<std::size_t>(frame.row_stride) * frame.height)
+        throw std::runtime_error("invalid raw image buffer");
+    if (frame.encoding == "rgb8" || frame.encoding == "bgr8") {
+        cv::Mat source(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                       CV_8UC3, const_cast<std::byte *>(frame.data.data()), frame.row_stride);
+        if (frame.encoding == "rgb8") {
+            cv::Mat result; cv::cvtColor(source, result, cv::COLOR_RGB2BGR); return result;
+        }
+        return source.clone();
+    }
+    if (frame.encoding == "mono8" || frame.encoding == "8UC1") {
+        cv::Mat source(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                       CV_8UC1, const_cast<std::byte *>(frame.data.data()), frame.row_stride);
+        cv::Mat result; cv::cvtColor(source, result, cv::COLOR_GRAY2BGR); return result;
+    }
+    throw std::runtime_error("unsupported raw camera encoding: " + frame.encoding);
+}
+
+void R3LiveAdapter::process(const slam_benchmark::SensorSample &sample) {
+    if (sample.sensor_id == imu_id_) {
+        const auto *input = std::get_if<slam_benchmark::ImuSample>(&sample.payload);
+        if (!input) throw std::runtime_error("IMU sensor carried a non-IMU payload");
+        ImuData message;
+        message.timestamp = seconds(sample.timestamp_ns);
+        message.angular_velocity = {input->angular_velocity_rad_s[0],
+                                    input->angular_velocity_rad_s[1],
+                                    input->angular_velocity_rad_s[2]};
+        message.linear_acceleration = {input->linear_acceleration_m_s2[0],
+                                       input->linear_acceleration_m_s2[1],
+                                       input->linear_acceleration_m_s2[2]};
+        frontend_->feed_imu(message);
+    } else if (sample.sensor_id == lidar_id_) {
+        const auto started = std::chrono::steady_clock::now();
+        const auto *input = std::get_if<slam_benchmark::PointCloud>(&sample.payload);
+        if (!input) throw std::runtime_error("LiDAR sensor carried a non-cloud payload");
+        if (input->points.size() != input->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        pcl::PointCloud<pcl::PointXYZINormal> cloud;
+        cloud.reserve(input->points.size());
+        for (std::size_t i = 0; i < input->points.size(); ++i) {
+            const auto &source = input->points[i];
+            pcl::PointXYZINormal point;
+            point.x=source.x; point.y=source.y; point.z=source.z;
+            point.intensity=source.intensity;
+            point.curvature=static_cast<float>(input->point_time_offset_ns[i] * 1e-6);
+            cloud.push_back(point);
+        }
+        frontend_->feed_lidar(seconds(sample.timestamp_ns),
+                              std::make_shared<const PointCloudXYZINormal>(std::move(cloud)));
+        sink_->report_timing({sample.timestamp_ns, "lidar_preprocess",
+            std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - started).count()});
+    } else if (sample.sensor_id == camera_id_) {
+        const auto started = std::chrono::steady_clock::now();
+        const auto *input = std::get_if<slam_benchmark::ImageFrame>(&sample.payload);
+        if (!input) throw std::runtime_error("camera sensor carried a non-image payload");
+        cv::Mat image = convert_image(*input);
+        frontend_->process_image(image, seconds(sample.timestamp_ns));
+        sink_->report_timing({sample.timestamp_ns, "image_preprocess",
+            std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - started).count()});
+    }
+    process_ready_updates(sample.timestamp_ns);
+    report_pose(sample.timestamp_ns);
+}
+
+bool R3LiveAdapter::process_ready_updates(
+    slam_benchmark::TimestampNs fallback_timestamp) {
+    bool processed_any = false;
+    while (true) {
+        bool progressed = false;
+        const auto visual_started = std::chrono::steady_clock::now();
+        if (frontend_->process_visual_once()) {
+            const auto timestamp = nanoseconds(
+                frontend_->last_processed_visual_timestamp());
+            sink_->report_timing({timestamp, "visual_update",
+                std::chrono::duration<double, std::milli>(
+                    std::chrono::steady_clock::now() - visual_started).count()});
+            progressed = true;
+        }
+        if (frontend_->process_lidar_once()) {
+            report_frontend_timings();
+            report_pose(fallback_timestamp);
+            progressed = true;
+        }
+        if (!progressed) break;
+        processed_any = true;
+    }
+    return processed_any;
+}
+
+void R3LiveAdapter::report_frontend_timings() {
+    for (auto &&timing : frontend_->drain_timings()) {
+        sink_->report_timing({nanoseconds(timing.timestamp),
+                              std::move(timing.stage), timing.milliseconds});
+    }
+}
+
+void R3LiveAdapter::report_pose(slam_benchmark::TimestampNs fallback_timestamp) {
+    std::unique_lock<std::mutex> lock(frontend_->m_mutex_lio_process, std::try_to_lock);
+    if (!lock || g_lio_state.last_update_time <= 0) return;
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(g_lio_state.last_update_time);
+    if (!trajectory_.empty() && pose.timestamp_ns <= trajectory_.back().timestamp_ns) return;
+    pose.translation_m = {g_lio_state.pos_end.x(), g_lio_state.pos_end.y(),
+                          g_lio_state.pos_end.z()};
+    const Eigen::Quaterniond q(g_lio_state.rot_end);
+    pose.rotation_xyzw = {q.x(), q.y(), q.z(), q.w()};
+    if (pose.timestamp_ns == 0) pose.timestamp_ns = fallback_timestamp;
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void R3LiveAdapter::finalize() {
+    process_ready_updates(0);
+    report_frontend_timings();
+    report_pose(0);
+    frontend_->stop_standalone();
+    sink_->report_final_trajectory(trajectory_);
+}
