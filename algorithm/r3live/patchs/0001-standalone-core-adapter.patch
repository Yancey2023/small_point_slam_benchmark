--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,41 @@
+cmake_minimum_required(VERSION 3.24)
+project(r3live_standalone LANGUAGES C CXX)
+
+find_package(Eigen3 CONFIG REQUIRED)
+find_package(OpenCV REQUIRED COMPONENTS core imgproc calib3d imgcodecs)
+find_package(OpenMP REQUIRED)
+find_package(PCL REQUIRED COMPONENTS common filters kdtree)
+find_package(spdlog CONFIG REQUIRED)
+find_package(yaml-cpp CONFIG REQUIRED)
+
+add_library(r3live_frontend STATIC
+    r3live/src/r3live_lio.cpp
+    r3live/src/r3live_vio.cpp
+    r3live/src/loam/IMU_Processing.cpp
+    r3live/src/loam/include/kd_tree/ikd_Tree.cpp
+    r3live/src/loam/include/FOV_Checker/FOV_Checker.cpp
+    r3live/src/optical_flow/lkpyramid.cpp
+    r3live/src/rgb_map/rgbmap_tracker.cpp
+    r3live/src/rgb_map/image_frame.cpp
+    r3live/src/rgb_map/pointcloud_rgbd.cpp
+    standalone/r3live_standalone.cpp)
+target_compile_features(r3live_frontend PUBLIC cxx_std_20)
+target_compile_definitions(r3live_frontend PUBLIC R3LIVE_STANDALONE=1)
+target_include_directories(r3live_frontend PUBLIC
+    standalone
+    r3live/src
+    r3live/src/loam/include
+    r3live/src/tools
+    r3live/src/rgb_map
+    r3live/src/optical_flow)
+target_link_libraries(r3live_frontend PUBLIC
+    Eigen3::Eigen ${OpenCV_LIBRARIES} ${PCL_LIBRARIES} spdlog::spdlog
+    OpenMP::OpenMP_CXX)
+target_compile_options(r3live_frontend PRIVATE -Wno-deprecated-declarations)
+
+add_executable(r3live_benchmark
+    standalone/main.cpp
+    standalone/r3live_adapter.cpp)
+target_compile_features(r3live_benchmark PRIVATE cxx_std_20)
+target_link_libraries(r3live_benchmark PRIVATE
+    r3live_frontend slam_benchmark::core yaml-cpp::yaml-cpp)
