+#pragma once
+
+#include "r3live.hpp"
+#include <slam_benchmark/algorithm.hpp>
+
+class R3LiveAdapter final : public slam_benchmark::SlamAlgorithm {
+public:
+    [[nodiscard]] std::string_view name() const noexcept override { return "r3live"; }
+    slam_benchmark::InitializationResult initialize(
+        std::span<const slam_benchmark::SensorDefinition> sensors,
+        const std::filesystem::path &config_path,
+        slam_benchmark::ResultSink &sink) override;
+    void process(const slam_benchmark::SensorSample &sample) override;
+    void finalize() override;
+
+private:
+    cv::Mat convert_image(const slam_benchmark::ImageFrame &frame) const;
+    bool process_ready_updates(slam_benchmark::TimestampNs fallback_timestamp);
+    void report_pose(slam_benchmark::TimestampNs timestamp);
+    void report_frontend_timings();
+    slam_benchmark::SensorId lidar_id_{};
+    slam_benchmark::SensorId imu_id_{};
+    slam_benchmark::SensorId camera_id_{};
+    slam_benchmark::ResultSink *sink_{};
+    std::unique_ptr<R3LIVE> frontend_;
+    slam_benchmark::Trajectory trajectory_;
+};
