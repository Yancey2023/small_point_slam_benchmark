+
+R3LIVE::R3LIVE() {
+    dense_map_en = true;
+    NUM_MAX_ITERATIONS = 4;
+    fov_deg = 360.0;
+    m_voxel_downsample_size_surf = 0.3;
+    m_voxel_downsample_size_axis_z = 0.3;
+    filter_size_map_min = 0.4;
+    cube_len = 10000000.0;
+    m_maximum_pt_kdtree_dis = 0.5;
+    m_maximum_res_dis = 0.3;
+    m_planar_check_dis = 0.10;
+    m_long_rang_pt_dis = 500.0;
+    m_lio_update_point_step = 1;
+    m_append_global_map_point_step = 4;
+    m_maximum_image_buffer = 2;
+    m_tracker_minimum_depth = 0.1;
+    m_tracker_maximum_depth = 200.0;
+    m_track_windows_size = 40;
+    m_minumum_rgb_pts_size = 0.05;
+    m_pub_pt_minimum_views = 5;
+    m_image_downsample_ratio = 1.0;
+    esikf_iter_times = 2;
+    m_if_estimate_i2c_extrinsic = 0;
+    m_if_estimate_intrinsic = 0;
+    m_maximum_vio_tracked_pts = 600;
+    m_control_image_freq = 100.0;
+    m_if_record_mvs = 0;
+
+    m_map_rgb_pts.set_minmum_dis(m_minumum_rgb_pts_size);
+    featsFromMap = std::make_shared<PointCloudXYZINormal>();
+    cube_points_add = std::make_shared<PointCloudXYZINormal>();
+    laserCloudFullRes2 = std::make_shared<PointCloudXYZINormal>();
+    laserCloudFullResColor = std::make_shared<pcl::PointCloud<pcl::PointXYZI>>();
+    XAxisPoint_body = Eigen::Vector3f(LIDAR_SP_LEN, 0.0, 0.0);
+    XAxisPoint_world = XAxisPoint_body;
+}
+
+R3LIVE::~R3LIVE() { stop_standalone(); }
+
+void R3LIVE::record_timing(double timestamp, std::string stage, double milliseconds) {
+    stage_timings_.push_back({timestamp, std::move(stage), milliseconds});
+}
+
+std::vector<R3LIVE::StageTiming> R3LIVE::drain_timings() {
+    std::vector<StageTiming> result;
+    result.swap(stage_timings_);
+    return result;
+}
+
+void R3LIVE::start_standalone(int parallel_threads) {
+    omp_set_dynamic(0);
+    omp_set_num_threads(std::max(1, parallel_threads));
+    downSizeFilterSurf.setLeafSize(m_voxel_downsample_size_surf,
+        m_voxel_downsample_size_surf, m_voxel_downsample_size_axis_z);
+    downSizeFilterMap.setLeafSize(filter_size_map_min, filter_size_map_min,
+                                  filter_size_map_min);
+    FOV_DEG = fov_deg + 10;
+    HALF_FOV_COS = std::cos((fov_deg + 10.0) * 0.5 * PI_M / 180.0);
+    for (auto &cloud : featsArray) cloud.reset(new PointCloudXYZINormal());
+    m_imu_process = std::make_shared<ImuProcess>();
+    g_camera_lidar_queue.m_liar_frame_buf = &lidar_buffer;
+    set_initial_state_cov(g_lio_state);
+    m_thread_pool_ptr = std::make_shared<Common_tools::ThreadPool>(
+        std::max(1, parallel_threads), false, false);
+}
+
+void R3LIVE::stop_standalone() {
+    if (!m_thread_pool_ptr) return;
+    wait_render_thread_finish();
+    m_thread_pool_ptr.reset();
+}
