+cmake_minimum_required(VERSION 3.24)
+
+find_package(Eigen3 CONFIG REQUIRED)
+find_package(Sophus CONFIG REQUIRED)
+find_package(TBB CONFIG REQUIRED)
+
+add_library(kiss_icp_algorithm STATIC
+    cpp/kiss_icp/core/Preprocessing.cpp
+    cpp/kiss_icp/core/Registration.cpp
+    cpp/kiss_icp/core/Threshold.cpp
+    cpp/kiss_icp/core/VoxelHashMap.cpp
+    cpp/kiss_icp/core/VoxelUtils.cpp
+    cpp/kiss_icp/pipeline/KissICP.cpp
+)
+target_include_directories(kiss_icp_algorithm PUBLIC cpp)
+target_link_libraries(kiss_icp_algorithm PUBLIC
+    Eigen3::Eigen
+    Sophus::Sophus
+    TBB::tbb
+)
+
+add_executable(kiss_icp_benchmark
+    standalone/kiss_icp_adapter.cpp
+    standalone/main.cpp
+)
+target_link_libraries(kiss_icp_benchmark PRIVATE
+    kiss_icp_algorithm
+    slam_benchmark::core
+    yaml-cpp::yaml-cpp
+    spdlog::spdlog
+)
+
+if(MSVC)
+    target_compile_options(kiss_icp_algorithm PRIVATE /W3 /utf-8)
+    target_compile_options(kiss_icp_benchmark PRIVATE /W4 /utf-8)
+else()
+    target_compile_options(kiss_icp_algorithm PRIVATE -Wall -Wextra)
+    target_compile_options(kiss_icp_benchmark PRIVATE -Wall -Wextra -Wpedantic)
+endif()
