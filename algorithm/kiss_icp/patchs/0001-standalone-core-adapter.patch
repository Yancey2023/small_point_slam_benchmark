diff --git a/standalone/kiss_icp_adapter.cpp b/standalone/kiss_icp_adapter.cpp
new file mode 100644
index 0000000..1ff47c7
--- /dev/null
+++ b/standalone/kiss_icp_adapter.cpp
@@ -0,0 +1,106 @@
+#include "kiss_icp_adapter.hpp"
+
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+namespace {
+template <typename T>
+T parameter(const YAML::Node& root, const char* key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+
+double elapsed_ms(const std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration<double, std::milli>(
+               std::chrono::steady_clock::now() - start)
+        .count();
+}
+}  // namespace
+
+void KissIcpAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    const auto lidar = std::ranges::find(sensors, slam_benchmark::SensorType::Lidar,
+                                         &slam_benchmark::SensorDefinition::type);
+    if (lidar == sensors.end()) throw std::runtime_error("KISS-ICP requires one LiDAR");
+
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    kiss_icp::pipeline::KISSConfig config;
+    config.max_range = parameter(root, "max_range_m", config.max_range);
+    config.min_range = parameter(root, "min_range_m", config.min_range);
+    config.voxel_size = parameter(root, "voxel_size_m", config.voxel_size);
+    config.max_points_per_voxel =
+        parameter(root, "max_points_per_voxel", config.max_points_per_voxel);
+    config.initial_threshold = parameter(root, "initial_threshold", config.initial_threshold);
+    config.min_motion_th = parameter(root, "min_motion_th", config.min_motion_th);
+    config.max_num_iterations =
+        parameter(root, "max_iterations", config.max_num_iterations);
+    config.convergence_criterion =
+        parameter(root, "convergence_criterion", config.convergence_criterion);
+    config.max_num_threads = parameter(root, "max_num_threads", config.max_num_threads);
+    config.deskew = parameter(root, "deskew", true);
+
+    const auto& transform = lidar->calibration.body_from_sensor;
+    Eigen::Matrix3d rotation;
+    rotation << transform[0], transform[1], transform[2], transform[4], transform[5],
+        transform[6], transform[8], transform[9], transform[10];
+    lidar_from_body_ = Sophus::SE3d(rotation, Eigen::Vector3d(
+        transform[3], transform[7], transform[11])).inverse();
+
+    sink_ = &sink;
+    pipeline_ = std::make_unique<kiss_icp::pipeline::KissICP>(config);
+    pipeline_->SetTimingCallback([this](const char* stage, double duration) {
+        sink_->report_timing({current_timestamp_, stage, duration});
+    });
+    spdlog::info("KISS-ICP standalone adapter initialized");
+}
+
+void KissIcpAdapter::process(const slam_benchmark::SensorSample& sample) {
+    const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload);
+    if (cloud == nullptr) return;
+    if (cloud->points.size() != cloud->point_time_offset_ns.size())
+        throw std::runtime_error("point/time array size mismatch");
+
+    current_timestamp_ = sample.timestamp_ns;
+    const auto started = std::chrono::steady_clock::now();
+    std::vector<Eigen::Vector3d> points;
+    std::vector<double> timestamps;
+    points.reserve(cloud->points.size());
+    timestamps.reserve(cloud->points.size());
+    std::int64_t minimum_offset = 0;
+    std::int64_t maximum_offset = 0;
+    for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+        const auto& point = cloud->points[index];
+        if (!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z))
+            continue;
+        points.emplace_back(point.x, point.y, point.z);
+        const auto offset = cloud->point_time_offset_ns[index];
+        timestamps.push_back(static_cast<double>(offset) * 1e-9);
+        minimum_offset = std::min(minimum_offset, offset);
+        maximum_offset = std::max(maximum_offset, offset);
+    }
+    if (minimum_offset == maximum_offset) timestamps.clear();
+    sink_->report_timing({current_timestamp_, "lidar_preprocess", elapsed_ms(started)});
+
+    pipeline_->RegisterFrame(points, timestamps);
+    const Sophus::SE3d world_from_body = pipeline_->pose() * lidar_from_body_;
+    const Eigen::Quaterniond orientation(world_from_body.so3().unit_quaternion());
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = sample.timestamp_ns + static_cast<slam_benchmark::TimestampNs>(
+        std::max<std::int64_t>(0, maximum_offset));
+    pose.translation_m = {world_from_body.translation().x(), world_from_body.translation().y(),
+                          world_from_body.translation().z()};
+    pose.rotation_xyzw = {orientation.x(), orientation.y(), orientation.z(), orientation.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void KissIcpAdapter::finalize() {
+    sink_->report_final_trajectory(trajectory_);
+}
diff --git a/standalone/kiss_icp_adapter.hpp b/standalone/kiss_icp_adapter.hpp
new file mode 100644
index 0000000..4ee0722
--- /dev/null
+++ b/standalone/kiss_icp_adapter.hpp
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "kiss_icp/pipeline/KissICP.hpp"
+
+#include <slam_benchmark/algorithm.hpp>
+
+#include <memory>
+
+class KissIcpAdapter final : public slam_benchmark::SlamAlgorithm {
+public:
+    [[nodiscard]] std::string_view name() const noexcept override { return "kiss_icp"; }
+    void initialize(std::span<const slam_benchmark::SensorDefinition> sensors,
+                    const std::filesystem::path& config_path,
+                    slam_benchmark::ResultSink& sink) override;
+    void process(const slam_benchmark::SensorSample& sample) override;
+    void finalize() override;
+
+private:
+    slam_benchmark::ResultSink* sink_{};
+    std::unique_ptr<kiss_icp::pipeline::KissICP> pipeline_;
+    Sophus::SE3d lidar_from_body_;
+    slam_benchmark::Trajectory trajectory_;
+    slam_benchmark::TimestampNs current_timestamp_{};
+};
