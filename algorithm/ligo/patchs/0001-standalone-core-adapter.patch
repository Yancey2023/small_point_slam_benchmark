diff --git a/standalone/ligo_lio_bridge.cpp b/standalone/ligo_lio_bridge.cpp
new file mode 100644
index 0000000..5474b7b
--- /dev/null
+++ b/standalone/ligo_lio_bridge.cpp
@@ -0,0 +1,113 @@
+#include "ligo_lio_bridge.hpp"
+
+#include "fast_lio_engine.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <optional>
+#include <stdexcept>
+#include <utility>
+
+class LigoLioBridge::Impl {
+public:
+    void initialize(const Options& options, LigoStateCallback state_callback,
+                    LigoTimingCallback timing_callback) {
+        state_callback_ = std::move(state_callback);
+        FastLioEngine::Options engine_options;
+        engine_options.scan_voxel_size = options.scan_voxel_size;
+        engine_options.map_voxel_size = options.map_voxel_size;
+        engine_options.max_iterations = options.max_iterations;
+        engine_options.estimate_extrinsics = options.estimate_extrinsics;
+        engine_options.lidar_rotation <<
+            options.lidar_rotation[0], options.lidar_rotation[1], options.lidar_rotation[2],
+            options.lidar_rotation[3], options.lidar_rotation[4], options.lidar_rotation[5],
+            options.lidar_rotation[6], options.lidar_rotation[7], options.lidar_rotation[8];
+        engine_options.lidar_translation << options.lidar_translation[0],
+            options.lidar_translation[1], options.lidar_translation[2];
+        engine_.set_pose_callback([this](double timestamp, const state_ikfom& state) {
+            LigoState output;
+            output.timestamp_s = timestamp;
+            output.position = {state.pos[0], state.pos[1], state.pos[2]};
+            const auto q = state.rot.coeffs();
+            output.rotation_xyzw = {q[0], q[1], q[2], q[3]};
+            output.velocity = {state.vel[0], state.vel[1], state.vel[2]};
+            output.gyro_bias = {state.bg[0], state.bg[1], state.bg[2]};
+            output.accel_bias = {state.ba[0], state.ba[1], state.ba[2]};
+            output.gravity = {state.grav[0], state.grav[1], state.grav[2]};
+            if (last_imu_) {
+                output.angular_velocity = last_imu_->angular_velocity;
+                output.acceleration = last_imu_->linear_acceleration;
+            }
+            if (state_callback_) state_callback_(output);
+        });
+        engine_.set_timing_callback(std::move(timing_callback));
+        engine_.initialize(engine_options);
+    }
+
+    void add_imu(const LigoImu& input) {
+        last_imu_ = input;
+        auto imu = std::make_shared<ImuData>();
+        imu->header.stamp.seconds = input.timestamp_s;
+        imu->angular_velocity = {input.angular_velocity[0], input.angular_velocity[1],
+                                 input.angular_velocity[2]};
+        imu->linear_acceleration = {input.linear_acceleration[0],
+                                    input.linear_acceleration[1],
+                                    input.linear_acceleration[2]};
+        imu_queue_.push_back(std::move(imu));
+        drain();
+    }
+
+    void add_cloud(LigoCloud input) {
+        MeasureGroup measures;
+        measures.lidar_beg_time = input.timestamp_s;
+        measures.lidar->reserve(input.points.size());
+        double maximum_offset = 0.0;
+        for (const auto& source : input.points) {
+            PointType point;
+            point.x = source.x;
+            point.y = source.y;
+            point.z = source.z;
+            point.intensity = source.intensity;
+            point.normal_x = point.normal_y = point.normal_z = 0.0F;
+            point.curvature = static_cast<float>(source.offset_s * 1000.0);
+            maximum_offset = std::max(maximum_offset, source.offset_s);
+            measures.lidar->push_back(point);
+        }
+        measures.lidar_end_time = measures.lidar_beg_time + maximum_offset;
+        lidar_queue_.push_back(std::move(measures));
+        drain();
+    }
+
+    void drain() {
+        while (!lidar_queue_.empty() && !imu_queue_.empty() &&
+               imu_queue_.back()->header.stamp.toSec() >= lidar_queue_.front().lidar_end_time) {
+            MeasureGroup measures = std::move(lidar_queue_.front());
+            lidar_queue_.pop_front();
+            while (!imu_queue_.empty() &&
+                   imu_queue_.front()->header.stamp.toSec() <= measures.lidar_end_time) {
+                measures.imu.push_back(imu_queue_.front());
+                imu_queue_.pop_front();
+            }
+            if (!measures.imu.empty()) engine_.process(measures);
+        }
+    }
+
+    void finish() { drain(); }
+
+    FastLioEngine engine_;
+    std::deque<ImuData::ConstPtr> imu_queue_;
+    std::deque<MeasureGroup> lidar_queue_;
+    std::optional<LigoImu> last_imu_;
+    LigoStateCallback state_callback_;
+};
+
+LigoLioBridge::LigoLioBridge() : impl_(std::make_unique<Impl>()) {}
+LigoLioBridge::~LigoLioBridge() = default;
+void LigoLioBridge::initialize(const Options& options, LigoStateCallback state_callback,
+                               LigoTimingCallback timing_callback) {
+    impl_->initialize(options, std::move(state_callback), std::move(timing_callback));
+}
+void LigoLioBridge::add_imu(const LigoImu& imu) { impl_->add_imu(imu); }
+void LigoLioBridge::add_cloud(LigoCloud cloud) { impl_->add_cloud(std::move(cloud)); }
+void LigoLioBridge::finish() { impl_->finish(); }
