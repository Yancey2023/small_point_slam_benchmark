new file mode 100644
index 0000000..e4d4e8f
--- /dev/null
+++ b/standalone/ligo_adapter.cpp
@@ -0,0 +1,156 @@
+#include "ligo_adapter.hpp"
+
+#include <slam_benchmark/calibration.hpp>
+
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+
+#include <chrono>
+#include <cmath>
+#include <stdexcept>
+
+namespace {
+
+template <typename T>
+T parameter(const YAML::Node& root, const char* key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+
+}  // namespace
+
+slam_benchmark::InitializationResult LigoAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .gnss = true, .point_time = true,
+                  .all_gnss = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Lidar);
+    const auto imu = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Imu);
+    const auto gnss = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Gnss);
+    if (lidar == sensors.end() || imu == sensors.end() || gnss == sensors.end())
+        throw std::runtime_error("LIGO requires LiDAR, IMU and GNSS");
+
+    sink_ = &sink;
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    LigoLioBridge::Options lio_options;
+    lio_options.scan_voxel_size = parameter(root, "filter_size_scan_m", 0.2);
+    lio_options.map_voxel_size = parameter(root, "map_voxel_size_m", 0.5);
+    lio_options.max_iterations = parameter(root, "max_iterations", 4);
+    lio_options.estimate_extrinsics = parameter(root, "estimate_extrinsics", false);
+    const auto lidar_from_imu =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    lio_options.lidar_rotation = {lidar_from_imu[0], lidar_from_imu[1],
+                                  lidar_from_imu[2], lidar_from_imu[4],
+                                  lidar_from_imu[5], lidar_from_imu[6],
+                                  lidar_from_imu[8], lidar_from_imu[9],
+                                  lidar_from_imu[10]};
+    lio_options.lidar_translation = {lidar_from_imu[3], lidar_from_imu[7],
+                                     lidar_from_imu[11]};
+
+    LigoGnssBridge::Options gnss_options;
+    const auto receiver_from_imu =
+        slam_benchmark::target_from_source(imu->calibration, gnss->calibration);
+    gnss_options.receiver_translation = {receiver_from_imu[3], receiver_from_imu[7],
+                                         receiver_from_imu[11]};
+    gnss_options.sample_period_s = parameter(root, "gnss_sample_period_s", 0.1);
+    gnss_options.local_time_difference_s =
+        parameter(root, "gnss_local_time_difference_s", 18.0);
+    gnss_options.initialization_window_size =
+        parameter(root, "gnss_initialization_window_size", 10);
+    gnss_options.graph_window_size = parameter(root, "gnss_graph_window_size", 30);
+    gnss_options.pseudorange_std_threshold_m =
+        parameter(root, "gnss_pseudorange_std_threshold_m", 30.0);
+    gnss_options.doppler_std_threshold_hz =
+        parameter(root, "gnss_doppler_std_threshold_hz", 30.0);
+    gnss_options.carrier_phase_std_threshold_cycles =
+        parameter(root, "gnss_carrier_phase_std_threshold_cycles", 30.0);
+    gnss_options.elevation_threshold_deg =
+        parameter(root, "gnss_elevation_threshold_deg", 30.0);
+    gnss_options.default_ionosphere_parameters =
+        parameter(root, "gnss_default_ionosphere_parameters",
+                  std::vector<double>{0.1118e-7, 0.2235e-7, -0.4172e-6, 0.6557e-6,
+                                      0.1249e6, -0.4424e6, 0.1507e7, -0.2621e6});
+    gnss_.initialize(gnss_options);
+    lio_.initialize(
+        lio_options, [this](const LigoState& state) { accept_lio_state(state); },
+        [this](double timestamp, const char* stage, double duration) {
+            sink_->report_timing({nanoseconds(timestamp), stage, duration});
+        });
+    spdlog::info("LIGO initialized with {} selected sensor streams",
+                 compatibility.selected_sensor_ids.size());
+    return compatibility;
+}
+
+void LigoAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        lio_.add_imu({static_cast<double>(sample.timestamp_ns) * 1e-9,
+                      imu->angular_velocity_rad_s, imu->linear_acceleration_m_s2});
+        return;
+    }
+    if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        LigoCloud input;
+        input.timestamp_s = static_cast<double>(sample.timestamp_ns) * 1e-9;
+        input.points.reserve(cloud->points.size());
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto& point = cloud->points[index];
+            input.points.push_back({point.x, point.y, point.z, point.intensity,
+                                    static_cast<double>(cloud->point_time_offset_ns[index]) *
+                                        1e-9});
+        }
+        lio_.add_cloud(std::move(input));
+        sink_->report_timing(
+            {sample.timestamp_ns, "lidar_preprocess",
+             std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
+                                                        started)
+                 .count()});
+        return;
+    }
+
+    const auto started = std::chrono::steady_clock::now();
+    gnss_.input(sample);
+    sink_->report_timing(
+        {sample.timestamp_ns, "gnss_preprocess",
+         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started)
+             .count()});
+}
+
+void LigoAdapter::accept_lio_state(const LigoState& state) {
+    local_states_.push_back(state);
+    gnss_.update_lio_state(state);
+    if (const auto global = gnss_.global_state(state)) sink_->report_realtime_pose(pose(*global));
+}
+
+slam_benchmark::Pose LigoAdapter::pose(const LigoState& state) const {
+    return {nanoseconds(state.timestamp_s), state.position, state.rotation_xyzw};
+}
+
+void LigoAdapter::finalize() {
+    lio_.finish();
+    if (!gnss_.ready()) {
+        throw std::runtime_error(
+            "LIGO GNSS initialization failed: raw observation epochs=" +
+            std::to_string(gnss_.observation_epochs()) +
+            ", ephemerides=" + std::to_string(gnss_.ephemerides()));
+    }
+    slam_benchmark::Trajectory trajectory;
+    trajectory.reserve(local_states_.size());
+    for (const auto& local : local_states_) {
+        if (const auto global = gnss_.global_state(local)) trajectory.push_back(pose(*global));
+    }
+    if (trajectory.empty())
+        throw std::runtime_error("LIGO produced no globally referenced poses");
+    spdlog::info("LIGO GNSS fusion completed: {} observation epochs, {} ephemerides, "
+                 "{} optimized epochs, {} trajectory poses",
+                 gnss_.observation_epochs(), gnss_.ephemerides(), gnss_.optimized_epochs(),
+                 trajectory.size());
+    sink_->report_final_trajectory(trajectory);
+}
