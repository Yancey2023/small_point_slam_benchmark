+
+#include <vector>
+
+class LigoAdapter final : public slam_benchmark::SlamAlgorithm {
+public:
+    [[nodiscard]] std::string_view name() const noexcept override { return "ligo"; }
+    slam_benchmark::InitializationResult initialize(
+        std::span<const slam_benchmark::SensorDefinition> sensors,
+        const std::filesystem::path& config_path,
+        slam_benchmark::ResultSink& sink) override;
+    void process(const slam_benchmark::SensorSample& sample) override;
+    void finalize() override;
+
+private:
+    void accept_lio_state(const LigoState& state);
+    [[nodiscard]] slam_benchmark::Pose pose(const LigoState& state) const;
+
+    slam_benchmark::ResultSink* sink_{};
+    LigoLioBridge lio_;
+    LigoGnssBridge gnss_;
+    std::vector<LigoState> local_states_;
+};
