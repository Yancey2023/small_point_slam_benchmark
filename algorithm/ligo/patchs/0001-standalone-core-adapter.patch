+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+struct LigoState {
+    double timestamp_s{};
+    std::array<double, 3> position{};
+    std::array<double, 4> rotation_xyzw{0.0, 0.0, 0.0, 1.0};
+    std::array<double, 3> velocity{};
+    std::array<double, 3> angular_velocity{};
+    std::array<double, 3> acceleration{};
+    std::array<double, 3> gyro_bias{};
+    std::array<double, 3> accel_bias{};
+    std::array<double, 3> gravity{0.0, 0.0, -9.81};
+};
+
+struct LigoImu {
+    double timestamp_s{};
+    std::array<double, 3> angular_velocity{};
+    std::array<double, 3> linear_acceleration{};
+};
+
+struct LigoPoint {
+    float x{};
+    float y{};
+    float z{};
+    float intensity{};
+    double offset_s{};
+};
+
+struct LigoCloud {
+    double timestamp_s{};
+    std::vector<LigoPoint> points;
+};
+
+using LigoStateCallback = std::function<void(const LigoState&)>;
+using LigoTimingCallback = std::function<void(double, const char*, double)>;
