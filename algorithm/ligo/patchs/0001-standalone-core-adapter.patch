+#include "ligo_gnss_bridge.hpp"
+
+#include "GNSS_Processing_fg.h"
+
+#include <gnss_comm/gnss_utility.hpp>
+#include <gtsam/inference/Symbol.h>
+
+#include <Eigen/Geometry>
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace {
+
+gnss_comm::gtime_t time(const slam_benchmark::GnssTime& value) {
+    return gnss_comm::gpst2time(value.week, value.seconds_of_week);
+}
+
+state_output to_upstream(const LigoState& input) {
+    state_output output;
+    output.pos << input.position[0], input.position[1], input.position[2];
+    const Eigen::Quaterniond rotation(input.rotation_xyzw[3], input.rotation_xyzw[0],
+                                      input.rotation_xyzw[1], input.rotation_xyzw[2]);
+    output.rot = rotation.normalized().toRotationMatrix();
+    output.vel << input.velocity[0], input.velocity[1], input.velocity[2];
+    output.omg << input.angular_velocity[0], input.angular_velocity[1],
+        input.angular_velocity[2];
+    output.acc << input.acceleration[0], input.acceleration[1], input.acceleration[2];
+    output.bg << input.gyro_bias[0], input.gyro_bias[1], input.gyro_bias[2];
+    output.ba << input.accel_bias[0], input.accel_bias[1], input.accel_bias[2];
+    output.gravity << input.gravity[0], input.gravity[1], input.gravity[2];
+    return output;
+}
+
+gnss_comm::ObsPtr observation(const slam_benchmark::GnssObservation& source) {
+    auto output = std::make_shared<gnss_comm::Obs>();
+    output->time = time(source.time);
+    output->sat = source.satellite;
+    output->freqs = source.frequencies_hz;
+    output->CN0 = source.carrier_to_noise_db_hz;
+    output->LLI = source.lost_lock_indicators;
+    output->code = source.codes;
+    output->psr = source.pseudoranges_m;
+    output->psr_std = source.pseudorange_std_m;
+    output->cp = source.carrier_phases_cycles;
+    output->cp_std = source.carrier_phase_std_cycles;
+    output->dopp = source.doppler_hz;
+    output->dopp_std = source.doppler_std_hz;
+    output->status = source.tracking_status;
+    return output;
+}
+
+gnss_comm::EphemPtr ephemeris(const slam_benchmark::GnssEphemeris& source) {
+    auto output = std::make_shared<gnss_comm::Ephem>();
+    output->sat = source.satellite;
+    output->ttr = time(source.transmission_time);
+    output->toe = time(source.ephemeris_reference_time);
+    output->toc = time(source.clock_reference_time);
+    output->toe_tow = source.ephemeris_reference_tow_s;
+    output->week = source.week;
+    output->iode = source.issue_of_data_ephemeris;
+    output->iodc = source.issue_of_data_clock;
+    output->health = source.health;
+    output->code = source.code;
+    output->ura = source.user_range_accuracy_m;
+    output->A = source.semi_major_axis_m;
+    output->e = source.eccentricity;
+    output->i0 = source.inclination_rad;
+    output->omg = source.argument_of_perigee_rad;
+    output->OMG0 = source.ascending_node_longitude_rad;
+    output->M0 = source.mean_anomaly_rad;
+    output->delta_n = source.mean_motion_difference_rad_s;
+    output->OMG_dot = source.ascending_node_rate_rad_s;
+    output->i_dot = source.inclination_rate_rad_s;
+    output->cuc = source.latitude_correction_cos_rad;
+    output->cus = source.latitude_correction_sin_rad;
+    output->crc = source.radius_correction_cos_m;
+    output->crs = source.radius_correction_sin_m;
+    output->cic = source.inclination_correction_cos_rad;
+    output->cis = source.inclination_correction_sin_rad;
+    output->af0 = source.clock_bias_s;
+    output->af1 = source.clock_drift_s_s;
+    output->af2 = source.clock_drift_rate_s_s2;
+    output->tgd[0] = source.group_delay_0_s;
+    output->tgd[1] = source.group_delay_1_s;
+    output->A_dot = source.semi_major_axis_rate_m_s;
+    output->n_dot = source.mean_motion_rate_rad_s2;
+    return output;
+}
+
+gnss_comm::GloEphemPtr ephemeris(const slam_benchmark::GnssGlonassEphemeris& source) {
+    auto output = std::make_shared<gnss_comm::GloEphem>();
+    output->sat = source.satellite;
+    output->ttr = time(source.transmission_time);
+    output->toe = time(source.ephemeris_reference_time);
+    output->freqo = source.frequency_channel;
+    output->iode = source.issue_of_data;
+    output->health = source.health;
+    output->age = source.age_days;
+    output->ura = source.user_range_accuracy_m;
+    std::copy(source.position_m.begin(), source.position_m.end(), output->pos);
+    std::copy(source.velocity_m_s.begin(), source.velocity_m_s.end(), output->vel);
+    std::copy(source.acceleration_m_s2.begin(), source.acceleration_m_s2.end(), output->acc);
+    output->tau_n = source.clock_bias_s;
+    output->gamma = source.relative_frequency_bias;
+    output->delta_tau_n = source.inter_frequency_delay_s;
+    return output;
+}
+
+}  // namespace
+
+class LigoGnssBridge::Impl {
+public:
+    void initialize(const Options& options) {
+        process_ = std::make_unique<GNSSProcess>();
+        process_->Tex_imu_r << options.receiver_translation[0],
+            options.receiver_translation[1], options.receiver_translation[2];
+        process_->gravity_init << options.gravity[0], options.gravity[1], options.gravity[2];
+        process_->gnss_sample_period = options.sample_period_s;
+        process_->diff_t_gnss_local = options.local_time_difference_s;
+        process_->wind_size = std::clamp(options.initialization_window_size, 1, WINDOW_SIZE);
+        process_->delete_thred = std::max(options.graph_window_size,
+                                          process_->wind_size + 1);
+        process_->p_assign->gnss_psr_std_threshold = options.pseudorange_std_threshold_m;
+        process_->p_assign->gnss_dopp_std_threshold = options.doppler_std_threshold_hz;
+        process_->p_assign->gnss_cp_std_threshold =
+            options.carrier_phase_std_threshold_cycles / 0.004;
+        process_->p_assign->gnss_elevation_threshold = options.elevation_threshold_deg;
+        process_->p_assign->pvt_is_gt = false;
+        process_->p_assign->initNoises();
+        process_->sqrt_lidar.setIdentity();
+        process_->inputIonoParams(0.0, options.default_ionosphere_parameters);
+    }
+
+    void update_lio_state(const LigoState& state) { local_state_ = state; }
+
+    void input(const slam_benchmark::SensorSample& sample) {
+        if (!process_) throw std::logic_error("LIGO GNSS bridge is not initialized");
+        if (const auto* value = std::get_if<slam_benchmark::GnssEphemeris>(&sample.payload)) {
+            process_->p_assign->inputEphem(ephemeris(*value));
+            ++ephemerides_;
+        } else if (const auto* value =
+                       std::get_if<slam_benchmark::GnssGlonassEphemeris>(&sample.payload)) {
+            process_->p_assign->inputEphem(ephemeris(*value));
+            ++ephemerides_;
+        } else if (const auto* value =
+                       std::get_if<slam_benchmark::GnssIonosphereParameters>(&sample.payload)) {
+            process_->inputIonoParams(static_cast<double>(value->source_timestamp_ns) * 1e-9,
+                                      value->values);
+        } else if (const auto* value =
+                       std::get_if<slam_benchmark::GnssReceiverPvt>(&sample.payload)) {
+            process_->inputpvt(gnss_comm::time2sec(time(value->time)), value->latitude_deg,
+                               value->longitude_deg, value->altitude_m,
+                               value->carrier_solution == 1, value->differential_solution);
+        } else if (const auto* value = std::get_if<slam_benchmark::GnssFix>(&sample.payload)) {
+            process_->inputlla(static_cast<double>(sample.timestamp_ns) * 1e-9,
+                               value->latitude_deg, value->longitude_deg, value->altitude_m);
+        } else if (const auto* value =
+                       std::get_if<slam_benchmark::GnssObservations>(&sample.payload)) {
+            if (!local_state_ || value->observations.empty()) return;
+            std::vector<gnss_comm::ObsPtr> observations;
+            observations.reserve(value->observations.size());
+            for (const auto& source : value->observations)
+                observations.push_back(observation(source));
+            state_output state = to_upstream(*local_state_);
+            process_->processGNSS(observations, state);
+            ++observation_epochs_;
+            if (process_->gnss_ready) {
+                process_->sqrt_lidar.setIdentity();
+                process_->p_assign->process_feat_num = 100;
+                process_->norm_vec_num = 100;
+                if (process_->Evaluate(state)) ++optimized_epochs_;
+            }
+        }
+    }
+
+    bool ready() const { return process_ && process_->gnss_ready; }
+
+    std::optional<LigoState> global_state(const LigoState& local) {
+        if (!ready() || process_->pvt_time.empty()) return std::nullopt;
+        using gtsam::symbol_shorthand::E;
+        using gtsam::symbol_shorthand::P;
+        if (!process_->p_assign->isamCurrentEstimate.exists(P(0)) ||
+            !process_->p_assign->isamCurrentEstimate.exists(E(0))) return std::nullopt;
+        const Eigen::Matrix3d enu_from_local =
+            process_->p_assign->isamCurrentEstimate.at<gtsam::Rot3>(P(0)).matrix();
+        const Eigen::Vector3d anchor =
+            process_->p_assign->isamCurrentEstimate.at<gtsam::Vector3>(E(0));
+        Eigen::Vector3d position(local.position[0], local.position[1], local.position[2]);
+        // Benchmark trajectories are expressed relative to their first global
+        // anchor. Keep LIGO's GNSS-derived orientation while removing the large
+        // absolute ECEF translation before reporting the ENU position.
+        position = gnss_comm::ecef2enu(gnss_comm::ecef2geo(anchor),
+                                       enu_from_local * position);
+        const Eigen::Quaterniond local_rotation(local.rotation_xyzw[3], local.rotation_xyzw[0],
+                                                local.rotation_xyzw[1], local.rotation_xyzw[2]);
+        const Eigen::Quaterniond global_rotation(enu_from_local * local_rotation.toRotationMatrix());
+        LigoState output = local;
+        output.position = {position[0], position[1], position[2]};
+        output.rotation_xyzw = {global_rotation.x(), global_rotation.y(), global_rotation.z(),
+                                global_rotation.w()};
+        return output;
+    }
+
+    std::unique_ptr<GNSSProcess> process_;
+    std::optional<LigoState> local_state_;
+    std::size_t observation_epochs_{};
+    std::size_t ephemerides_{};
+    std::size_t optimized_epochs_{};
+};
+
+LigoGnssBridge::LigoGnssBridge() : impl_(std::make_unique<Impl>()) {}
+LigoGnssBridge::~LigoGnssBridge() = default;
+void LigoGnssBridge::initialize(const Options& options) { impl_->initialize(options); }
+void LigoGnssBridge::update_lio_state(const LigoState& state) { impl_->update_lio_state(state); }
+void LigoGnssBridge::input(const slam_benchmark::SensorSample& sample) { impl_->input(sample); }
+bool LigoGnssBridge::ready() const { return impl_->ready(); }
+std::optional<LigoState> LigoGnssBridge::global_state(const LigoState& state) {
+    return impl_->global_state(state);
+}
+std::size_t LigoGnssBridge::observation_epochs() const { return impl_->observation_epochs_; }
+std::size_t LigoGnssBridge::ephemerides() const { return impl_->ephemerides_; }
+std::size_t LigoGnssBridge::optimized_epochs() const { return impl_->optimized_epochs_; }
