+
+void reset_cov(Eigen::Matrix<double, 24, 24>& covariance) {
+    covariance = Eigen::Matrix<double, 24, 24>::Identity() * 0.1;
+    covariance.block<3, 3>(21, 21).setIdentity();
+    covariance.block<3, 3>(21, 21) *= 0.0001;
+    covariance.block<6, 6>(15, 15).setIdentity();
+    covariance.block<6, 6>(15, 15) *= 0.001;
+}
+
+void reset_cov_output(Eigen::Matrix<double, 30, 30>& covariance) {
+    covariance = Eigen::Matrix<double, 30, 30>::Identity() * 0.01;
+    covariance.block<3, 3>(21, 21).setIdentity();
+    covariance.block<3, 3>(21, 21) *= 0.0001;
+    covariance.block<6, 6>(24, 24).setIdentity();
+    covariance.block<6, 6>(24, 24) *= 0.001;
+}
+
+slam_benchmark::InitializationResult PointLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .point_time = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors,
+                                                      slam_benchmark::SensorType::Lidar);
+    const auto imu = compatibility.selected_sensor(sensors,
+                                                    slam_benchmark::SensorType::Imu);
+    if (lidar == sensors.end() || imu == sensors.end())
+        throw std::runtime_error("Point-LIO requires one LiDAR and one IMU");
+    sink_ = &sink;
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    filter_size_surf_min = parameter(root, "filter_size_scan_m", 0.5);
+    filter_size_map_min = parameter(root, "filter_size_map_m", 0.5);
+    const double map_voxel_size = parameter(root, "map_voxel_size_m", 0.5);
+    extrinsic_est_en = parameter(root, "estimate_extrinsics", false);
+    laser_point_cov = parameter(root, "lidar_measurement_noise", 0.01);
+    acc_cov_input = parameter(root, "accelerometer_noise", 0.1);
+    gyr_cov_input = parameter(root, "gyroscope_noise", 0.1);
+    b_acc_cov = parameter(root, "accelerometer_bias_noise", 0.0001);
+    b_gyr_cov = parameter(root, "gyroscope_bias_noise", 0.0001);
+    initial_map_size_ = parameter<std::size_t>(root, "initial_map_points", 100);
+    ivox_options_.resolution_ = static_cast<float>(map_voxel_size);
+    ivox_options_.nearby_type_ = IVoxType::NearbyType::NEARBY18;
+    ivox_.reset(new IVoxType(ivox_options_));
+    scan_filter_.setLeafSize(filter_size_surf_min, filter_size_surf_min,
+                             filter_size_surf_min);
+
+    const auto transform =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    Lidar_R_wrt_IMU << transform[0], transform[1], transform[2], transform[4],
+        transform[5], transform[6], transform[8], transform[9], transform[10];
+    Lidar_T_wrt_IMU << transform[3], transform[7], transform[11];
+    kf_input.init_dyn_share_modified_2h(get_f_input, df_dx_input, h_model_input);
+    Eigen::Matrix<double, 24, 24> initial_covariance;
+    reset_cov(initial_covariance);
+    kf_input.change_P(initial_covariance);
+    kf_input.x_.offset_R_L_I = Lidar_R_wrt_IMU;
+    kf_input.x_.offset_T_L_I = Lidar_T_wrt_IMU;
+    const auto gravity = root["gravity_m_s2"]
+                             ? root["gravity_m_s2"].as<std::vector<double>>()
+                             : std::vector<double>{0.0, 0.0, -9.81};
+    if (gravity.size() != 3) throw std::runtime_error("gravity_m_s2 must have 3 values");
+    kf_input.x_.gravity << gravity[0], gravity[1], gravity[2];
+    G_m_s2 = kf_input.x_.gravity.norm();
+    process_covariance_ = process_noise_cov_input();
+    spdlog::info("Point-LIO standalone adapter initialized");
+    return compatibility;
+}
+
+void PointLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        auto value = std::make_shared<ImuData>();
+        value->header.stamp.seconds = seconds(sample.timestamp_ns);
+        value->angular_velocity = {imu->angular_velocity_rad_s[0],
+                                   imu->angular_velocity_rad_s[1],
+                                   imu->angular_velocity_rad_s[2]};
+        value->linear_acceleration = {imu->linear_acceleration_m_s2[0],
+                                      imu->linear_acceleration_m_s2[1],
+                                      imu->linear_acceleration_m_s2[2]};
+        imu_queue_.push_back(value);
+        ++imu_initialization_count_;
+        const double count = static_cast<double>(imu_initialization_count_);
+        mean_acceleration_ +=
+            (V3D(value->linear_acceleration.x, value->linear_acceleration.y,
+                 value->linear_acceleration.z) -
+             mean_acceleration_) /
+            count;
+        mean_gyroscope_ +=
+            (V3D(value->angular_velocity.x, value->angular_velocity.y,
+                 value->angular_velocity.z) -
+             mean_gyroscope_) /
+            count;
+        if (imu_initialization_count_ >= 100 && !imu_initialized_) {
+            acc_norm = mean_acceleration_.norm();
+            kf_input.x_.bg = mean_gyroscope_;
+            imu_initialized_ = true;
+        }
+    } else if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        MeasureGroup measures;
+        measures.lidar_beg_time = seconds(sample.timestamp_ns);
+        double maximum_offset = 0.0;
+        measures.lidar->reserve(cloud->points.size());
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            PointType point;
+            const auto& source = cloud->points[index];
+            point.x = source.x;
+            point.y = source.y;
+            point.z = source.z;
+            point.intensity = source.intensity;
+            point.normal_x = point.normal_y = point.normal_z = 0.0F;
+            point.curvature =
+                static_cast<float>(static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-6);
+            maximum_offset = std::max(maximum_offset, point.curvature * 1e-3);
+            measures.lidar->push_back(point);
+        }
+        measures.lidar_last_time = measures.lidar_beg_time + maximum_offset;
+        lidar_queue_.push_back(std::move(measures));
+        sink_->report_timing(
+            {sample.timestamp_ns, "lidar_preprocess", elapsed_ms(started)});
+    }
+    drain();
+}
+
+void PointLioAdapter::drain() {
+    while (imu_initialized_ && !lidar_queue_.empty() && !imu_queue_.empty() &&
+           imu_queue_.back()->header.stamp.toSec() >= lidar_queue_.front().lidar_last_time) {
+        MeasureGroup measures = std::move(lidar_queue_.front());
+        lidar_queue_.pop_front();
+        while (!imu_queue_.empty() &&
+               imu_queue_.front()->header.stamp.toSec() <= measures.lidar_last_time) {
+            measures.imu.push_back(imu_queue_.front());
+            imu_queue_.pop_front();
+        }
+        if (!measures.imu.empty()) process_group(measures);
+    }
+}
+
+void PointLioAdapter::process_group(MeasureGroup& measures) {
+    auto started = std::chrono::steady_clock::now();
+    scan_filter_.setInputCloud(measures.lidar);
+    scan_filter_.filter(*feats_down_body);
+    sink_->report_timing(
+        {nanoseconds(measures.lidar_last_time), "downsampling", elapsed_ms(started)});
+    std::sort(feats_down_body->begin(), feats_down_body->end(),
+              [](const PointType& lhs, const PointType& rhs) {
+                  return lhs.curvature < rhs.curvature;
+              });
+    if (feats_down_body->empty()) return;
+    time_seq = time_compressing<int>(feats_down_body);
+    feats_down_size = static_cast<int>(feats_down_body->size());
+    feats_down_world->resize(feats_down_size);
+    Nearest_Points.resize(feats_down_size);
+    pbody_list.resize(feats_down_size);
+    crossmat_list.resize(feats_down_size);
+    for (int index = 0; index < feats_down_size; ++index) {
+        const PointType& point = feats_down_body->points[index];
+        pbody_list[index] = V3D(point.x, point.y, point.z);
+        V3D imu_point = Lidar_R_wrt_IMU * pbody_list[index] + Lidar_T_wrt_IMU;
+        crossmat_list[index] << SKEW_SYM_MATRX(imu_point);
+        pointBodyToWorld(&point, &feats_down_world->points[index]);
+    }
+    if (!map_initialized_) {
+        ivox_->AddPoints(feats_down_world->points);
+        map_initialized_ = feats_down_world->size() >= initial_map_size_ ||
+                           ivox_->NumValidGrids() >= initial_map_size_;
+        emit_pose(measures.lidar_last_time);
+        return;
+    }
+
+    idx = -1;
+    std::size_t imu_index = 0;
+    point_lio_knn_time_ms = 0.0;
+    const auto propagation_started = std::chrono::steady_clock::now();
+    double filter_duration = 0.0;
+    for (k = 0; k < static_cast<int>(time_seq.size()); ++k) {
+        const int group_end = idx + time_seq[k];
+        const double point_time =
+            measures.lidar_beg_time + feats_down_body->points[group_end].curvature * 1e-3;
+        while (imu_index + 1 < measures.imu.size() &&
+               measures.imu[imu_index + 1]->header.stamp.toSec() <= point_time)
+            ++imu_index;
+        const ImuData& imu = *measures.imu[imu_index];
+        input_in.gyro << imu.angular_velocity.x, imu.angular_velocity.y,
+            imu.angular_velocity.z;
+        input_in.acc << imu.linear_acceleration.x, imu.linear_acceleration.y,
+            imu.linear_acceleration.z;
+        input_in.acc *= G_m_s2 / std::max(acc_norm, 1e-6);
+        if (last_propagation_time_ == 0.0) last_propagation_time_ = point_time;
+        double dt = std::max(0.0, point_time - last_propagation_time_);
+        if (dt > 0.0) {
+            double covariance_dt = dt;
+            kf_input.predict(covariance_dt, process_covariance_, input_in, false, true);
+            kf_input.predict(dt, process_covariance_, input_in, true, false);
+        }
+        last_propagation_time_ = point_time;
+
+        const auto filter_started = std::chrono::steady_clock::now();
+        kf_input.update_iterated_dyn_share_modified();
+        filter_duration += elapsed_ms(filter_started);
+        for (int offset = 0; offset < time_seq[k]; ++offset) {
+            const int point_index = idx + offset + 1;
+            pointBodyToWorld(&feats_down_body->points[point_index],
+                             &feats_down_world->points[point_index]);
+        }
+        idx += time_seq[k];
+    }
+    const double propagation_total = elapsed_ms(propagation_started) - filter_duration;
+    sink_->report_timing({nanoseconds(measures.lidar_last_time), "state_propagation",
+                          std::max(0.0, propagation_total)});
+    sink_->report_timing({nanoseconds(measures.lidar_last_time), "map_search",
+                          point_lio_knn_time_ms});
+    sink_->report_timing({nanoseconds(measures.lidar_last_time), "filter_update",
+                          std::max(0.0, filter_duration - point_lio_knn_time_ms)});
+
+    started = std::chrono::steady_clock::now();
+    add_to_map();
+    sink_->report_timing(
+        {nanoseconds(measures.lidar_last_time), "map_update", elapsed_ms(started)});
+    emit_pose(measures.lidar_last_time);
+}
+
+void PointLioAdapter::add_to_map() {
+    PointVector points;
+    points.reserve(feats_down_world->size());
+    for (std::size_t index = 0; index < feats_down_world->size(); ++index) {
+        const PointType& point = feats_down_world->points[index];
+        bool add = Nearest_Points[index].empty();
+        const Eigen::Vector3f center =
+            ((point.getVector3fMap() / filter_size_map_min).array().floor() + 0.5F) *
+            filter_size_map_min;
+        for (const PointType& nearby : Nearest_Points[index]) {
+            const Eigen::Vector3f distance = nearby.getVector3fMap() - center;
+            if ((distance.array().abs() < 0.5F * filter_size_map_min).all()) {
+                add = false;
+                break;
+            }
+            add = true;
+        }
+        if (add) points.push_back(point);
+    }
+    ivox_->AddPoints(points);
+}
+
+void PointLioAdapter::emit_pose(double timestamp) {
+    const Eigen::Quaterniond quaternion(kf_input.x_.rot);
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(timestamp);
+    pose.translation_m = {kf_input.x_.pos[0], kf_input.x_.pos[1], kf_input.x_.pos[2]};
+    pose.rotation_xyzw = {quaternion.x(), quaternion.y(), quaternion.z(), quaternion.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void PointLioAdapter::finalize() {
+    drain();
+    sink_->report_final_trajectory(trajectory_);
+}
