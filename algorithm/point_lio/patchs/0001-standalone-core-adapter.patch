+#pragma once
+
+#include "Estimator.h"
+
+#include <slam_benchmark/algorithm.hpp>
+
+#include <deque>
+
+class PointLioAdapter final : public slam_benchmark::SlamAlgorithm {
+public:
+    [[nodiscard]] std::string_view name() const noexcept override { return "point_lio"; }
+    slam_benchmark::InitializationResult initialize(std::span<const slam_benchmark::SensorDefinition> sensors,
+                    const std::filesystem::path& config_path,
+                    slam_benchmark::ResultSink& sink) override;
+    void process(const slam_benchmark::SensorSample& sample) override;
+    void finalize() override;
+
+private:
+    using ImuData = MeasureGroup::ImuData;
+    void drain();
+    void process_group(MeasureGroup& measures);
+    void add_to_map();
+    void emit_pose(double timestamp);
+
+    slam_benchmark::ResultSink* sink_{};
+    pcl::VoxelGrid<PointType> scan_filter_;
+    std::deque<ImuData::ConstPtr> imu_queue_;
+    std::deque<MeasureGroup> lidar_queue_;
+    slam_benchmark::Trajectory trajectory_;
+    Eigen::Matrix<double, 24, 24> process_covariance_;
+    V3D mean_acceleration_ = V3D::Zero();
+    V3D mean_gyroscope_ = V3D::Zero();
+    std::size_t imu_initialization_count_ = 0;
+    double last_propagation_time_ = 0.0;
+    std::size_t initial_map_size_ = 100;
+    bool imu_initialized_ = false;
+    bool map_initialized_ = false;
+};
