+#include "voxel_map_engine.hpp"
+
+#include "voxel_map_util.hpp"
+
+#include <pcl/filters/voxel_grid.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <unordered_map>
+#include <utility>
+
+namespace {
+
+constexpr std::size_t kImuInitializationSamples = 200;
+constexpr double kGravity = 9.81;
+
+double elapsed_ms(std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration<double, std::milli>(
+               std::chrono::steady_clock::now() - start)
+        .count();
+}
+
+void delete_tree(OctoTree* tree) {
+    if (tree == nullptr) return;
+    for (OctoTree* leaf : tree->leaves_) delete_tree(leaf);
+    delete tree->plane_ptr_;
+    delete tree;
+}
+
+}  // namespace
+
+class VoxelMapEngine::Impl {
+public:
+    ~Impl() {
+        for (auto& [location, tree] : map_) {
+            (void)location;
+            delete_tree(tree);
+        }
+    }
+
+    void initialize(const Options& options) {
+        options_ = options;
+        scan_filter_.setLeafSize(options.scan_filter_size_m, options.scan_filter_size_m,
+                                 options.scan_filter_size_m);
+    }
+
+    void process(double timestamp, const PointCloudXYZI::Ptr& cloud,
+                 const std::vector<VoxelMapImuSample>& imu_samples) {
+        if (cloud == nullptr || cloud->empty()) return;
+        const double scan_end_time =
+            timestamp + std::max(0.0, static_cast<double>(
+                                          std::max_element(
+                                              cloud->points.begin(), cloud->points.end(),
+                                              [](const PointType& lhs, const PointType& rhs) {
+                                                  return lhs.curvature < rhs.curvature;
+                                              })
+                                              ->curvature) *
+                                          1e-3);
+        auto started = std::chrono::steady_clock::now();
+        const bool imu_ready = initialize_imu(imu_samples);
+        if (imu_ready) undistort(timestamp, scan_end_time, imu_samples, *cloud);
+        report(scan_end_time, "undistortion", elapsed_ms(started));
+        if (!imu_ready) return;
+        propagated_ = state_;
+
+        started = std::chrono::steady_clock::now();
+        scan_filter_.setInputCloud(cloud);
+        scan_filter_.filter(*downsampled_);
+        report(scan_end_time, "downsampling", elapsed_ms(started));
+        if (downsampled_->empty()) return;
+
+        std::vector<M3D> body_covariances;
+        std::vector<M3D> cross_matrices;
+        body_covariances.reserve(downsampled_->size());
+        cross_matrices.reserve(downsampled_->size());
+        for (const PointType& point : downsampled_->points) {
+            V3D body(point.x, point.y, point.z == 0.0F ? 0.001F : point.z);
+            M3D covariance =
+                calcBodyCov(body, options_.range_noise, options_.angle_noise_degrees);
+            body_covariances.push_back(covariance);
+            M3D cross;
+            cross << SKEW_SYM_MATRX(body);
+            cross_matrices.push_back(cross);
+        }
+        if (map_.empty()) {
+            const auto points = map_points(body_covariances, cross_matrices);
+            buildVoxelMap(points, options_.map_voxel_size_m, options_.max_layer,
+                          options_.layer_point_sizes, options_.max_points,
+                          options_.max_points, options_.minimum_eigenvalue_ratio, map_);
+            emit_pose(scan_end_time);
+            return;
+        }
+
+        double search_duration = 0.0;
+        double optimization_duration = 0.0;
+        for (int iteration = 0; iteration < options_.max_iterations; ++iteration) {
+            std::vector<pointWithCov> query;
+            query.reserve(downsampled_->size());
+            for (std::size_t index = 0; index < downsampled_->size(); ++index) {
+                const PointType& point = downsampled_->points[index];
+                pointWithCov value;
+                value.point << point.x, point.y, point.z;
+                value.point_world = state_.rot_end * value.point + state_.pos_end;
+                value.cov = world_covariance(body_covariances[index],
+                                             cross_matrices[index]);
+                value.cov_lidar = body_covariances[index];
+                query.push_back(value);
+            }
+
+            std::vector<ptpl> matches;
+            std::vector<V3D> unmatched;
+            started = std::chrono::steady_clock::now();
+            BuildResidualListOMP(map_, options_.map_voxel_size_m, 3.0, options_.max_layer,
+                                 query, matches, unmatched);
+            search_duration += elapsed_ms(started);
+            if (matches.size() < 3) break;
+
+            started = std::chrono::steady_clock::now();
+            Eigen::MatrixXd jacobian(matches.size(), 6);
+            Eigen::MatrixXd weighted_transpose(6, matches.size());
+            Eigen::VectorXd measurement(matches.size());
+            for (std::size_t index = 0; index < matches.size(); ++index) {
+                const ptpl& match = matches[index];
+                V3D body = match.point;
+                if (body.z() == 0.0) body.z() = 0.001;
+                M3D body_covariance =
+                    calcBodyCov(body, options_.range_noise, options_.angle_noise_degrees);
+                const M3D world_body_covariance =
+                    state_.rot_end * body_covariance * state_.rot_end.transpose();
+                const V3D world = state_.rot_end * body + state_.pos_end;
+                Eigen::Matrix<double, 1, 6> plane_jacobian;
+                plane_jacobian.block<1, 3>(0, 0) = world - match.center;
+                plane_jacobian.block<1, 3>(0, 3) = -match.normal;
+                const double plane_variance =
+                    std::max(1e-12, static_cast<double>(
+                                       plane_jacobian * match.plane_cov *
+                                       plane_jacobian.transpose()));
+                const double variance = std::max(
+                    1e-12, plane_variance +
+                               static_cast<double>(match.normal.transpose() *
+                                                   world_body_covariance * match.normal));
+                const double inverse_variance = 1.0 / variance;
+                M3D cross;
+                cross << SKEW_SYM_MATRX(body);
+                const V3D rotation = cross * state_.rot_end.transpose() * match.normal;
+                jacobian.row(index) << rotation.x(), rotation.y(), rotation.z(),
+                    match.normal.x(), match.normal.y(), match.normal.z();
+                weighted_transpose.col(index) = jacobian.row(index).transpose() *
+                                                inverse_variance;
+                measurement[index] =
+                    -(match.normal.dot(world) + static_cast<double>(match.d));
+            }
+
+            MD(DIM_STATE, DIM_STATE) information = state_.cov.inverse();
+            information.block<6, 6>(0, 0) += weighted_transpose * jacobian;
+            const MD(DIM_STATE, DIM_STATE) posterior = information.inverse();
+            const Eigen::MatrixXd gain =
+                posterior.block<DIM_STATE, 6>(0, 0) * weighted_transpose;
+            const VD(DIM_STATE) prior_error = propagated_ - state_;
+            const VD(DIM_STATE) increment =
+                gain * measurement + prior_error -
+                gain * jacobian * prior_error.block<6, 1>(0, 0);
+            state_ += increment;
+            optimization_duration += elapsed_ms(started);
+            if (increment.block<3, 1>(0, 0).norm() * 57.3 < 0.01 &&
+                increment.block<3, 1>(3, 0).norm() * 100.0 < 0.015) {
+                MD(DIM_STATE, DIM_STATE) correction =
+                    MD(DIM_STATE, DIM_STATE)::Identity();
+                correction.block<DIM_STATE, 6>(0, 0) -= gain * jacobian;
+                state_.cov = correction * state_.cov;
+                break;
+            }
+            if (iteration + 1 == options_.max_iterations) {
+                MD(DIM_STATE, DIM_STATE) correction =
+                    MD(DIM_STATE, DIM_STATE)::Identity();
+                correction.block<DIM_STATE, 6>(0, 0) -= gain * jacobian;
+                state_.cov = correction * state_.cov;
+            }
+        }
+        report(scan_end_time, "map_search", search_duration);
+        report(scan_end_time, "filter_update", optimization_duration);
+
+        started = std::chrono::steady_clock::now();
+        auto points = map_points(body_covariances, cross_matrices);
+        std::sort(points.begin(), points.end(), [](const auto& lhs, const auto& rhs) {
+            return lhs.cov.diagonal().norm() < rhs.cov.diagonal().norm();
+        });
+        updateVoxelMap(points, options_.map_voxel_size_m, options_.max_layer,
+                       options_.layer_point_sizes, options_.max_points,
+                       options_.max_points, options_.minimum_eigenvalue_ratio, map_);
+        report(scan_end_time, "map_update", elapsed_ms(started));
+        emit_pose(scan_end_time);
+    }
+
+    struct ImuPose {
+        double offset_time{};
+        V3D acceleration = V3D::Zero();
+        V3D angular_velocity = V3D::Zero();
+        V3D velocity = V3D::Zero();
+        V3D position = V3D::Zero();
+        M3D rotation = M3D::Identity();
+    };
+
+    bool initialize_imu(const std::vector<VoxelMapImuSample>& samples) {
+        if (imu_initialized_) return true;
+        for (const auto& sample : samples) {
+            ++imu_initialization_samples_;
+            if (imu_initialization_samples_ == 1) {
+                mean_acceleration_ = sample.linear_acceleration;
+                mean_angular_velocity_ = sample.angular_velocity;
+            } else {
+                const double count = static_cast<double>(imu_initialization_samples_);
+                mean_acceleration_ +=
+                    (sample.linear_acceleration - mean_acceleration_) / count;
+                mean_angular_velocity_ +=
+                    (sample.angular_velocity - mean_angular_velocity_) / count;
+            }
+        }
+        if (!samples.empty()) {
+            last_imu_ = samples.back();
+            has_last_imu_ = true;
+        }
+        if (imu_initialization_samples_ < kImuInitializationSamples ||
+            mean_acceleration_.norm() < 1e-6)
+            return false;
+
+        state_.gravity = -mean_acceleration_.normalized() * kGravity;
+        state_.bias_g = mean_angular_velocity_;
+        imu_initialized_ = true;
+        return false;
+    }
+
+    void propagate_imu(const V3D& angular_velocity, const V3D& acceleration,
+                       double dt, M3D& rotation, V3D& position, V3D& velocity) {
+        if (dt <= 0.0) return;
+        const V3D unbiased_gyro = angular_velocity - state_.bias_g;
+        const double acceleration_scale =
+            kGravity / std::max(mean_acceleration_.norm(), 1e-6);
+        const V3D unbiased_acceleration =
+            acceleration * acceleration_scale - state_.bias_a;
+
+        MD(DIM_STATE, DIM_STATE) transition =
+            MD(DIM_STATE, DIM_STATE)::Identity();
+        M3D acceleration_cross;
+        acceleration_cross << SKEW_SYM_MATRX(unbiased_acceleration);
+        transition.block<3, 3>(0, 0) = Exp(unbiased_gyro, -dt);
+        transition.block<3, 3>(0, 9) = -Eye3d * dt;
+        transition.block<3, 3>(3, 6) = Eye3d * dt;
+        transition.block<3, 3>(6, 0) = -rotation * acceleration_cross * dt;
+        transition.block<3, 3>(6, 12) = -rotation * dt;
+        transition.block<3, 3>(6, 15) = Eye3d * dt;
+        MD(DIM_STATE, DIM_STATE) process_noise =
+            MD(DIM_STATE, DIM_STATE)::Zero();
+        const double dt_squared = dt * dt;
+        process_noise.block<3, 3>(0, 0).diagonal().setConstant(
+            options_.gyroscope_noise * dt_squared);
+        process_noise.block<3, 3>(6, 6).diagonal().setConstant(
+            options_.accelerometer_noise * dt_squared);
+        process_noise.block<3, 3>(9, 9).diagonal().setConstant(
+            options_.gyroscope_bias_noise * dt_squared);
+        process_noise.block<3, 3>(12, 12).diagonal().setConstant(
+            options_.accelerometer_bias_noise * dt_squared);
+        state_.cov = transition * state_.cov * transition.transpose() + process_noise;
+
+        rotation *= Exp(unbiased_gyro, dt);
+        const V3D world_acceleration = rotation * unbiased_acceleration + state_.gravity;
+        position += velocity * dt + 0.5 * world_acceleration * dt_squared;
+        velocity += world_acceleration * dt;
+        last_world_acceleration_ = world_acceleration;
+        last_unbiased_gyro_ = unbiased_gyro;
+    }
+
+    void undistort(double scan_start_time, double scan_end_time,
+                   const std::vector<VoxelMapImuSample>& samples,
+                   PointCloudXYZI& cloud) {
+        std::vector<VoxelMapImuSample> imu;
+        imu.reserve(samples.size() + (has_last_imu_ ? 1U : 0U));
+        if (has_last_imu_) imu.push_back(last_imu_);
+        imu.insert(imu.end(), samples.begin(), samples.end());
+        std::sort(imu.begin(), imu.end(), [](const auto& lhs, const auto& rhs) {
+            return lhs.timestamp < rhs.timestamp;
+        });
+
+        std::sort(cloud.points.begin(), cloud.points.end(),
+                  [](const PointType& lhs, const PointType& rhs) {
+                      return lhs.curvature < rhs.curvature;
+                  });
+        M3D rotation = state_.rot_end;
+        V3D position = state_.pos_end;
+        V3D velocity = state_.vel_end;
+        std::vector<ImuPose> poses;
+        poses.reserve(imu.size() + 2);
+        poses.push_back({0.0, last_world_acceleration_, last_unbiased_gyro_,
+                         velocity, position, rotation});
+
+        double integrated_time = scan_start_time;
+        for (std::size_t index = 0; index + 1 < imu.size(); ++index) {
+            const auto& head = imu[index];
+            const auto& tail = imu[index + 1];
+            if (tail.timestamp <= scan_start_time || head.timestamp >= scan_end_time)
+                continue;
+            const double segment_start = std::max(integrated_time, scan_start_time);
+            const double segment_end = std::min(tail.timestamp, scan_end_time);
+            const double dt = segment_end - segment_start;
+            if (dt <= 0.0) continue;
+            const V3D angular_velocity =
+                0.5 * (head.angular_velocity + tail.angular_velocity);
+            const V3D acceleration =
+                0.5 * (head.linear_acceleration + tail.linear_acceleration);
+            propagate_imu(angular_velocity, acceleration, dt, rotation, position,
+                          velocity);
+            integrated_time = segment_end;
+            poses.push_back({integrated_time - scan_start_time,
+                             last_world_acceleration_, last_unbiased_gyro_, velocity,
+                             position, rotation});
+            if (integrated_time >= scan_end_time) break;
+        }
+
+        if (integrated_time < scan_end_time) {
+            const auto& extrapolation = imu.empty() ? last_imu_ : imu.back();
+            const double dt = scan_end_time - integrated_time;
+            propagate_imu(extrapolation.angular_velocity,
+                          extrapolation.linear_acceleration, dt, rotation, position,
+                          velocity);
+            poses.push_back({scan_end_time - scan_start_time,
+                             last_world_acceleration_, last_unbiased_gyro_, velocity,
+                             position, rotation});
+        }
+
+        state_.rot_end = rotation;
+        state_.pos_end = position;
+        state_.vel_end = velocity;
+        for (PointType& point : cloud.points) {
+            const double point_time = std::clamp(
+                static_cast<double>(point.curvature) * 1e-3, 0.0,
+                scan_end_time - scan_start_time);
+            const auto upper = std::upper_bound(
+                poses.begin(), poses.end(), point_time,
+                [](double value, const ImuPose& pose) {
+                    return value < pose.offset_time;
+                });
+            const ImuPose& pose = upper == poses.begin() ? poses.front() : *std::prev(upper);
+            const double dt = point_time - pose.offset_time;
+            const M3D point_rotation = pose.rotation * Exp(pose.angular_velocity, dt);
+            const V3D point_position =
+                pose.position + pose.velocity * dt + 0.5 * pose.acceleration * dt * dt;
+            const V3D source(point.x, point.y, point.z);
+            const V3D corrected =
+                state_.rot_end.transpose() *
+                (point_rotation * source + point_position - state_.pos_end);
+            point.x = static_cast<float>(corrected.x());
+            point.y = static_cast<float>(corrected.y());
+            point.z = static_cast<float>(corrected.z());
+        }
+
+        if (!samples.empty()) {
+            last_imu_ = samples.back();
+            has_last_imu_ = true;
+        }
+    }
+
+    M3D world_covariance(const M3D& body_covariance, const M3D& cross) const {
+        return state_.rot_end * body_covariance * state_.rot_end.transpose() +
+               (-cross) * state_.cov.block<3, 3>(0, 0) * (-cross).transpose() +
+               state_.cov.block<3, 3>(3, 3);
+    }
+
+    std::vector<pointWithCov> map_points(const std::vector<M3D>& covariances,
+                                         const std::vector<M3D>& crosses) const {
+        std::vector<pointWithCov> result;
+        result.reserve(downsampled_->size());
+        for (std::size_t index = 0; index < downsampled_->size(); ++index) {
+            const PointType& point = downsampled_->points[index];
+            const V3D body(point.x, point.y, point.z);
+            pointWithCov value;
+            value.point = state_.rot_end * body + state_.pos_end;
+            value.point_world = value.point;
+            value.cov = world_covariance(covariances[index], crosses[index]);
+            value.cov_lidar = covariances[index];
+            result.push_back(value);
+        }
+        return result;
+    }
+
+    void report(double timestamp, const char* stage, double duration) const {
+        if (timing_callback_) timing_callback_(timestamp, stage, duration);
+    }
+
+    void emit_pose(double timestamp) const {
+        if (pose_callback_) pose_callback_(timestamp, state_);
+    }
+
+    Options options_;
+    StatesGroup state_;
+    StatesGroup propagated_;
+    pcl::VoxelGrid<PointType> scan_filter_;
+    PointCloudXYZI::Ptr downsampled_{new PointCloudXYZI()};
+    std::unordered_map<VOXEL_LOC, OctoTree*> map_;
+    PoseCallback pose_callback_;
+    TimingCallback timing_callback_;
+    VoxelMapImuSample last_imu_;
+    V3D mean_acceleration_ = V3D::Zero();
+    V3D mean_angular_velocity_ = V3D::Zero();
+    V3D last_world_acceleration_ = V3D::Zero();
+    V3D last_unbiased_gyro_ = V3D::Zero();
+    std::size_t imu_initialization_samples_ = 0;
+    bool has_last_imu_ = false;
+    bool imu_initialized_ = false;
+};
+
+VoxelMapEngine::VoxelMapEngine() : impl_(std::make_unique<Impl>()) {}
+VoxelMapEngine::~VoxelMapEngine() = default;
+void VoxelMapEngine::initialize(const Options& options) { impl_->initialize(options); }
+void VoxelMapEngine::set_pose_callback(PoseCallback callback) {
+    impl_->pose_callback_ = std::move(callback);
+}
+void VoxelMapEngine::set_timing_callback(TimingCallback callback) {
+    impl_->timing_callback_ = std::move(callback);
+}
+void VoxelMapEngine::process(double timestamp, const PointCloudXYZI::Ptr& cloud,
+                             const std::vector<VoxelMapImuSample>& imu_samples) {
+    impl_->process(timestamp, cloud, imu_samples);
+}
