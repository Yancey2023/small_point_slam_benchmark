--- /dev/null
+++ b/standalone/voxel_map_adapter.cpp
@@ -0,0 +1,173 @@
+#include "voxel_map_adapter.hpp"
+
+#include <slam_benchmark/calibration.hpp>
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+#include <omp.h>
+
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+namespace {
+
+double seconds(slam_benchmark::TimestampNs value) {
+    return static_cast<double>(value) * 1e-9;
+}
+
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+
+template <typename T>
+T required_parameter(const YAML::Node& root, const char* key) {
+    if (!root[key]) throw std::runtime_error(std::string("missing parameter: ") + key);
+    return root[key].as<T>();
+}
+
+}  // namespace
+
+slam_benchmark::InitializationResult VoxelMapAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .point_time = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = std::ranges::find(sensors, slam_benchmark::SensorType::Lidar,
+                                         &slam_benchmark::SensorDefinition::type);
+    const auto imu = std::ranges::find(sensors, slam_benchmark::SensorType::Imu,
+                                       &slam_benchmark::SensorDefinition::type);
+    if (lidar == sensors.end() || imu == sensors.end())
+        throw std::runtime_error("PV-LIO requires one LiDAR and one IMU");
+    sink_ = &sink;
+    lidar_id_ = lidar->id;
+    imu_id_ = imu->id;
+    const auto transform =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    for (int row = 0; row < 4; ++row)
+        for (int column = 0; column < 4; ++column)
+            imu_from_lidar_(row, column) = transform[row * 4 + column];
+
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    const int parallel_threads = required_parameter<int>(root, "parallel_threads");
+    if (parallel_threads <= 0) {
+        throw std::runtime_error("parallel_threads must be positive");
+    }
+    omp_set_dynamic(0);
+    omp_set_num_threads(parallel_threads);
+    VoxelMapEngine::Options options;
+    options.scan_filter_size_m = required_parameter<double>(root, "filter_size_scan_m");
+    options.map_voxel_size_m = required_parameter<double>(root, "map_voxel_size_m");
+    options.max_layer = required_parameter<int>(root, "max_layer");
+    options.max_points = required_parameter<int>(root, "max_points_per_voxel");
+    options.max_iterations = required_parameter<int>(root, "max_iterations");
+    options.minimum_eigenvalue_ratio =
+        required_parameter<float>(root, "min_eigenvalue_ratio");
+    options.range_noise = required_parameter<float>(root, "range_noise_m");
+    options.angle_noise_degrees = required_parameter<float>(root, "angle_noise_deg");
+    options.gyroscope_noise = required_parameter<double>(root, "gyroscope_noise");
+    options.accelerometer_noise = required_parameter<double>(root, "accelerometer_noise");
+    options.gyroscope_bias_noise = required_parameter<double>(root, "gyroscope_bias_noise");
+    options.accelerometer_bias_noise =
+        required_parameter<double>(root, "accelerometer_bias_noise");
+    options.layer_point_sizes =
+        required_parameter<std::vector<int>>(root, "layer_point_sizes");
+    if (options.scan_filter_size_m <= 0.0 || options.map_voxel_size_m <= 0.0 ||
+        options.max_layer < 0 || options.max_points <= 0 || options.max_iterations <= 0 ||
+        options.layer_point_sizes.empty())
+        throw std::runtime_error("VoxelMap parameters must be positive");
+    while (options.layer_point_sizes.size() <= static_cast<std::size_t>(options.max_layer))
+        options.layer_point_sizes.push_back(options.layer_point_sizes.back());
+
+    engine_.set_pose_callback(
+        [this](double timestamp, const StatesGroup& state) { accept_pose(timestamp, state); });
+    engine_.set_timing_callback([this](double timestamp, const char* stage, double duration) {
+        sink_->report_timing({nanoseconds(timestamp), stage, duration});
+    });
+    engine_.initialize(options);
+    spdlog::info("PV-LIO parameters: scan filter={} m, map voxel={} m, "
+                 "iterations={}, compute threads={}", options.scan_filter_size_m,
+                 options.map_voxel_size_m, options.max_iterations, parallel_threads);
+    spdlog::info("PV-LIO standalone adapter initialized");
+    return {};
+}
+
+void VoxelMapAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        if (sample.sensor_id != imu_id_) return;
+        VoxelMapImuSample converted;
+        converted.timestamp = seconds(sample.timestamp_ns);
+        converted.angular_velocity << imu->angular_velocity_rad_s[0],
+            imu->angular_velocity_rad_s[1], imu->angular_velocity_rad_s[2];
+        converted.linear_acceleration << imu->linear_acceleration_m_s2[0],
+            imu->linear_acceleration_m_s2[1], imu->linear_acceleration_m_s2[2];
+        imu_queue_.push_back(std::move(converted));
+        drain();
+        return;
+    }
+    const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload);
+    if (cloud == nullptr || sample.sensor_id != lidar_id_) return;
+    if (cloud->points.size() != cloud->point_time_offset_ns.size())
+        throw std::runtime_error("point/time array size mismatch");
+    const auto started = std::chrono::steady_clock::now();
+    PointCloudXYZI::Ptr converted(new PointCloudXYZI());
+    converted->reserve(cloud->points.size());
+    double maximum_offset = 0.0;
+    for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+        const auto& source = cloud->points[index];
+        const Eigen::Vector4d transformed =
+            imu_from_lidar_ * Eigen::Vector4d(source.x, source.y, source.z, 1.0);
+        PointType point;
+        point.x = transformed.x();
+        point.y = transformed.y();
+        point.z = transformed.z();
+        point.intensity = source.intensity;
+        point.normal_x = point.normal_y = point.normal_z = 0.0F;
+        const double offset_ms =
+            static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-6;
+        point.curvature = static_cast<float>(offset_ms);
+        maximum_offset = std::max(maximum_offset, offset_ms * 1e-3);
+        converted->push_back(point);
+    }
+    sink_->report_timing(
+        {sample.timestamp_ns, "lidar_preprocess",
+         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
+                                                   started)
+             .count()});
+    const double start_time = seconds(sample.timestamp_ns);
+    lidar_queue_.push_back({start_time, start_time + maximum_offset,
+                            std::move(converted)});
+    drain();
+}
+
+void VoxelMapAdapter::drain() {
+    while (!lidar_queue_.empty() && !imu_queue_.empty() &&
+           imu_queue_.back().timestamp >= lidar_queue_.front().end_time) {
+        LidarFrame frame = std::move(lidar_queue_.front());
+        lidar_queue_.pop_front();
+        std::vector<VoxelMapImuSample> measurements;
+        while (!imu_queue_.empty() && imu_queue_.front().timestamp <= frame.end_time) {
+            measurements.push_back(std::move(imu_queue_.front()));
+            imu_queue_.pop_front();
+        }
+        if (!measurements.empty())
+            engine_.process(frame.start_time, frame.cloud, measurements);
+    }
+}
+
+void VoxelMapAdapter::accept_pose(double timestamp, const StatesGroup& state) {
+    const Eigen::Quaterniond quaternion(state.rot_end);
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(timestamp);
+    pose.translation_m = {state.pos_end.x(), state.pos_end.y(), state.pos_end.z()};
+    pose.rotation_xyzw = {quaternion.x(), quaternion.y(), quaternion.z(), quaternion.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void VoxelMapAdapter::finalize() {
+    drain();
+    sink_->report_final_trajectory(trajectory_);
+}
