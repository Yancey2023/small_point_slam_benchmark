+#pragma once
+
+#include "voxel_map_engine.hpp"
+
+#include <slam_benchmark/algorithm.hpp>
+
+#include <deque>
+
+class VoxelMapAdapter final : public slam_benchmark::SlamAlgorithm {
+public:
+    [[nodiscard]] std::string_view name() const noexcept override {
+        return "pv_lio";
+    }
+    slam_benchmark::InitializationResult initialize(std::span<const slam_benchmark::SensorDefinition> sensors,
+                    const std::filesystem::path& config_path,
+                    slam_benchmark::ResultSink& sink) override;
+    void process(const slam_benchmark::SensorSample& sample) override;
+    void finalize() override;
+
+private:
+    struct LidarFrame {
+        double start_time{};
+        double end_time{};
+        PointCloudXYZI::Ptr cloud;
+    };
+
+    void drain();
+    void accept_pose(double timestamp, const StatesGroup& state);
+
+    slam_benchmark::ResultSink* sink_{};
+    VoxelMapEngine engine_;
+    Eigen::Matrix4d imu_from_lidar_ = Eigen::Matrix4d::Identity();
+    slam_benchmark::SensorId lidar_id_{};
+    slam_benchmark::SensorId imu_id_{};
+    std::deque<VoxelMapImuSample> imu_queue_;
+    std::deque<LidarFrame> lidar_queue_;
+    slam_benchmark::Trajectory trajectory_;
+};
