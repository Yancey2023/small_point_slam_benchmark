+
+struct Odometry {
+    double timestamp{};
+    Eigen::Vector3f position = Eigen::Vector3f::Zero();
+    Eigen::Vector3f velocity = Eigen::Vector3f::Zero();
+    Eigen::Vector3f acceleration = Eigen::Vector3f::Zero();
+    Eigen::Matrix3f orientation = Eigen::Matrix3f::Identity();
+    Eigen::Vector3f angular_velocity = Eigen::Vector3f::Zero();
+};
+
+struct ImuStamped {
+    double timestamp{};
+    Eigen::Vector3f angular_velocity = Eigen::Vector3f::Zero();
+    Eigen::Vector3f linear_acceleration = Eigen::Vector3f::Zero();
+};
+
+struct PointStamped {
+    double timestamp{};
+    Eigen::Vector3f position = Eigen::Vector3f::Zero();
+};
+
+struct MapPlane {
+    Eigen::Vector3f center = Eigen::Vector3f::Zero();
