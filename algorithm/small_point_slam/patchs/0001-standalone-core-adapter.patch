--- /dev/null
+++ b/standalone/small_point_slam_adapter.cpp
@@ -0,0 +1,236 @@
+#include "small_point_slam_adapter.hpp"
+
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+#ifndef SLAM_BENCHMARK_PARALLEL_THREADS
+#define SLAM_BENCHMARK_PARALLEL_THREADS 4
+#endif
+
+namespace {
+    double seconds(slam_benchmark::TimestampNs timestamp) {
+        return static_cast<double>(timestamp) * 1e-9;
+    }
+
+    slam_benchmark::TimestampNs nanoseconds(double timestamp) {
+        return static_cast<slam_benchmark::TimestampNs>(std::llround(timestamp * 1e9));
+    }
+
+    double elapsed_ms(std::chrono::steady_clock::time_point started) {
+        return std::chrono::duration<double, std::milli>(
+                       std::chrono::steady_clock::now() - started)
+                .count();
+    }
+
+    Eigen::Matrix3f rotation(const slam_benchmark::SensorCalibration &calibration) {
+        const auto &value = calibration.body_from_sensor;
+        Eigen::Matrix3f result;
+        result << value[0], value[1], value[2], value[4], value[5], value[6],
+                value[8], value[9], value[10];
+        return result;
+    }
+
+    Eigen::Vector3f translation(const slam_benchmark::SensorCalibration &calibration) {
+        const auto &value = calibration.body_from_sensor;
+        return Eigen::Vector3f(static_cast<float>(value[3]),
+                               static_cast<float>(value[7]),
+                               static_cast<float>(value[11]));
+    }
+
+    small_point_slam::standalone::SensorExtrinsic extrinsic(
+            const slam_benchmark::SensorCalibration &calibration) {
+        return {rotation(calibration), translation(calibration)};
+    }
+
+    YAML::Node camera_model(const slam_benchmark::SensorDefinition &sensor) {
+        const auto &calibration = sensor.calibration;
+        if (calibration.intrinsics.size() != 4 || calibration.image_width == 0 ||
+            calibration.image_height == 0) {
+            throw std::invalid_argument(
+                    "camera calibration requires [fx, fy, cx, cy] intrinsics and resolution");
+        }
+        YAML::Node model;
+        model["cam_model"] = "Pinhole";
+        model["cam_width"] = calibration.image_width;
+        model["cam_height"] = calibration.image_height;
+        model["scale"] = 1.0;
+        model["cam_fx"] = calibration.intrinsics[0];
+        model["cam_fy"] = calibration.intrinsics[1];
+        model["cam_cx"] = calibration.intrinsics[2];
+        model["cam_cy"] = calibration.intrinsics[3];
+        for (std::size_t index = 0; index < 4; ++index) {
+            model["cam_d" + std::to_string(index)] =
+                    index < calibration.distortion.size() ? calibration.distortion[index] : 0.0;
+        }
+        return model;
+    }
+
+    cv::Mat convert_image(const slam_benchmark::ImageFrame &frame) {
+        if (frame.compressed) {
+            const auto *begin = reinterpret_cast<const std::uint8_t *>(frame.data.data());
+            const std::vector<std::uint8_t> encoded(begin, begin + frame.data.size());
+            cv::Mat image = cv::imdecode(encoded, cv::IMREAD_COLOR);
+            if (image.empty()) throw std::runtime_error("failed to decode compressed camera image");
+            return image;
+        }
+        if (frame.width == 0 || frame.height == 0 || frame.row_stride == 0)
+            throw std::runtime_error("invalid raw camera image dimensions");
+        const auto *data = reinterpret_cast<const std::uint8_t *>(frame.data.data());
+        if (frame.encoding == "mono8") {
+            return cv::Mat(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                           CV_8UC1, const_cast<std::uint8_t *>(data), frame.row_stride)
+                    .clone();
+        }
+        if (frame.encoding == "rgb8" || frame.encoding == "bgr8") {
+            cv::Mat image(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                          CV_8UC3, const_cast<std::uint8_t *>(data), frame.row_stride);
+            if (frame.encoding == "rgb8") {
+                cv::Mat converted;
+                cv::cvtColor(image, converted, cv::COLOR_RGB2BGR);
+                return converted;
+            }
+            return image.clone();
+        }
+        throw std::runtime_error("unsupported raw camera encoding: " + frame.encoding);
+    }
+}// namespace
+
+slam_benchmark::InitializationResult SmallPointSlamAdapter::initialize(
+        std::span<const slam_benchmark::SensorDefinition> sensors,
+        const std::filesystem::path &config_path,
+        slam_benchmark::ResultSink &sink) {
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    const bool use_imu = root["enable_imu"].as<bool>(true);
+    const bool use_camera = !lio_only_ && root["use_camera"].as<bool>(true);
+    const bool use_wheel_speed =
+            !lio_only_ && root["enable_wheel_speed"].as<bool>(true);
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+            sensors, {.lidar = true,
+                      .point_time = true,
+                      .all_lidars = true,
+                      .optional_imu = use_imu,
+                      .optional_camera = use_camera,
+                      .optional_wheel_speed = use_wheel_speed});
+    if (!compatibility) return compatibility;
+
+    sink_ = &sink;
+    lidar_indices_.clear();
+    imu_id_.reset();
+    camera_id_.reset();
+    wheel_speed_id_.reset();
+    std::vector<small_point_slam::standalone::SensorExtrinsic> lidars;
+    std::optional<Eigen::Matrix3f> imu_rotation;
+    std::optional<small_point_slam::standalone::CameraConfiguration> camera;
+    for (const auto &sensor: sensors) {
+        if (!compatibility.sensor_selected(sensor.id)) continue;
+        if (sensor.type == slam_benchmark::SensorType::Lidar) {
+            lidar_indices_.emplace_back(sensor.id, lidars.size());
+            lidars.push_back(extrinsic(sensor.calibration));
+        } else if (sensor.type == slam_benchmark::SensorType::Imu) {
+            imu_id_ = sensor.id;
+            imu_rotation = rotation(sensor.calibration);
+        } else if (sensor.type == slam_benchmark::SensorType::Camera) {
+            camera_id_ = sensor.id;
+            camera = small_point_slam::standalone::CameraConfiguration{
+                    extrinsic(sensor.calibration), camera_model(sensor)};
+        } else if (sensor.type == slam_benchmark::SensorType::WheelSpeed) {
+            wheel_speed_id_ = sensor.id;
+        }
+    }
+
+    const int parallel_threads = root["parallel_threads"]
+                                         ? root["parallel_threads"].as<int>()
+                                         : SLAM_BENCHMARK_PARALLEL_THREADS;
+    if (parallel_threads <= 0) throw std::runtime_error("parallel_threads must be positive");
+    tbb_control_ = std::make_unique<tbb::global_control>(
+            tbb::global_control::max_allowed_parallelism,
+            static_cast<std::size_t>(parallel_threads));
+    engine_ = std::make_unique<small_point_slam::standalone::SmallPointSlamEngine>(
+            root, lidars, imu_rotation, wheel_speed_id_.has_value(), camera);
+    engine_->set_pose_callback([this](double timestamp,
+                                      const small_point_slam::State &state) {
+        accept_pose(timestamp, state);
+    });
+    engine_->set_timing_callback([this](double timestamp, const char *stage,
+                                        double duration_ms) {
+        sink_->report_timing({nanoseconds(timestamp), stage, duration_ms});
+    });
+    spdlog::info(
+            "{} initialized with {} LiDAR(s), IMU={}, camera={}, wheel_speed={}, threads={}",
+            algorithm_name_, lidars.size(), imu_id_.has_value(), camera_id_.has_value(),
+            wheel_speed_id_.has_value(), parallel_threads);
+    return compatibility;
+}
+
+void SmallPointSlamAdapter::process(const slam_benchmark::SensorSample &sample) {
+    if (!engine_) throw std::logic_error("Small Point SLAM is not initialized");
+    if (const auto *imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        if (!imu_id_ || sample.sensor_id != *imu_id_) return;
+        const auto started = std::chrono::steady_clock::now();
+        common::ImuStamped converted;
+        converted.timestamp = seconds(sample.timestamp_ns);
+        converted.angular_velocity = Eigen::Vector3f(
+                static_cast<float>(imu->angular_velocity_rad_s[0]),
+                static_cast<float>(imu->angular_velocity_rad_s[1]),
+                static_cast<float>(imu->angular_velocity_rad_s[2]));
+        converted.linear_acceleration = Eigen::Vector3f(
+                static_cast<float>(imu->linear_acceleration_m_s2[0]),
+                static_cast<float>(imu->linear_acceleration_m_s2[1]),
+                static_cast<float>(imu->linear_acceleration_m_s2[2]));
+        engine_->add_imu(converted);
+        sink_->report_timing({sample.timestamp_ns, "imu_preprocess", elapsed_ms(started)});
+    } else if (const auto *cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        const auto source = std::ranges::find_if(
+                lidar_indices_, [&](const auto &entry) { return entry.first == sample.sensor_id; });
+        if (source == lidar_indices_.end()) return;
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        std::vector<common::PointStamped> converted;
+        converted.reserve(cloud->points.size());
+        const double base_timestamp = seconds(sample.timestamp_ns);
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto &point = cloud->points[index];
+            if (!std::isfinite(point.x) || !std::isfinite(point.y) ||
+                !std::isfinite(point.z)) continue;
+            converted.push_back({base_timestamp + static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-9,
+                                 Eigen::Vector3f(point.x, point.y, point.z)});
+        }
+        sink_->report_timing({sample.timestamp_ns, "lidar_preprocess", elapsed_ms(started)});
+        engine_->add_point_cloud(source->second, converted);
+    } else if (const auto *wheel = std::get_if<slam_benchmark::WheelSpeed>(&sample.payload)) {
+        if (!wheel_speed_id_ || sample.sensor_id != *wheel_speed_id_) return;
+        engine_->add_wheel_speed({seconds(sample.timestamp_ns), wheel->linear_m_s, 0.0,
+                                  wheel->angular_rad_s});
+    } else if (const auto *frame = std::get_if<slam_benchmark::ImageFrame>(&sample.payload)) {
+        if (!camera_id_ || sample.sensor_id != *camera_id_) return;
+        const auto started = std::chrono::steady_clock::now();
+        engine_->add_image({seconds(sample.timestamp_ns), convert_image(*frame)});
+        sink_->report_timing({sample.timestamp_ns, "image_preprocess", elapsed_ms(started)});
+    } else {
+        return;
+    }
+    engine_->handle_once();
+}
+
+void SmallPointSlamAdapter::accept_pose(double timestamp,
+                                        const small_point_slam::State &state) {
+    const Eigen::Quaterniond orientation(state.rotation);
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(timestamp);
+    pose.translation_m = {state.position.x(), state.position.y(), state.position.z()};
+    pose.rotation_xyzw = {orientation.x(), orientation.y(), orientation.z(), orientation.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void SmallPointSlamAdapter::finalize() {
+    if (!engine_) return;
+    engine_->finalize();
+    sink_->report_final_trajectory(trajectory_);
+}
