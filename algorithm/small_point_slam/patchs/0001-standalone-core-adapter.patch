+
+add_library(small_point_slam_algorithm STATIC
+    "${NAVIGATION_ROOT}/src/localization/map/cached_ivox.cpp"
+    "${NAVIGATION_ROOT}/src/localization/observation/imu.cpp"
+    "${NAVIGATION_ROOT}/src/localization/observation/point_cloud.cpp"
+    "${NAVIGATION_ROOT}/src/localization/small_point_slam/eskf.cpp"
+    "${NAVIGATION_ROOT}/src/localization/small_point_slam/estimator.cpp"
+    "${NAVIGATION_ROOT}/src/localization/small_point_slam/parameters.cpp"
+    small_point_slam_engine.cpp
+)
+target_compile_features(small_point_slam_algorithm PUBLIC cxx_std_20)
+target_compile_definitions(small_point_slam_algorithm PUBLIC USE_PERFORMANCE_STATS)
+target_include_directories(small_point_slam_algorithm BEFORE PUBLIC
+    "${CMAKE_CURRENT_SOURCE_DIR}/include"
+    "${NAVIGATION_ROOT}/src"
+    "${CMAKE_CURRENT_SOURCE_DIR}"
+)
+target_link_libraries(small_point_slam_algorithm PUBLIC
+    Eigen3::Eigen
+    TBB::tbb
+    small_gicp::small_gicp
+    yaml-cpp::yaml-cpp
+    spdlog::spdlog
+)
+
+add_executable(small_point_slam_benchmark
+    main.cpp
+    small_point_slam_adapter.cpp
+)
