+namespace small_point_slam::standalone {
+
+    struct SensorExtrinsic {
+        Eigen::Matrix3f rotation{Eigen::Matrix3f::Identity()};
+        Eigen::Vector3f translation{Eigen::Vector3f::Zero()};
+    };
+
+    struct CameraConfiguration {
+        SensorExtrinsic extrinsic;
+        YAML::Node model;
+    };
+
+    class SmallPointSlamEngine {
+    public:
+        using PoseCallback = std::function<void(double, const State &)>;
+        using TimingCallback = std::function<void(double, const char *, double)>;
+
+        SmallPointSlamEngine(const YAML::Node &config,
+                             const std::vector<SensorExtrinsic> &lidars,
+                             const std::optional<Eigen::Matrix3f> &imu_rotation,
+                             bool wheel_speed_available,
+                             const std::optional<CameraConfiguration> &camera);
+
+        void add_imu(const common::ImuStamped &sample);
+        void add_point_cloud(std::size_t sensor_index,
+                             const std::vector<common::PointStamped> &cloud);
+        void add_wheel_speed(const common::WheelSpeed &sample);
+        void add_image(const common::ImageStamped &sample);
+        void handle_once();
+        void finalize();
+        void set_pose_callback(PoseCallback callback);
+        void set_timing_callback(TimingCallback callback);
+
+    private:
+        void initialize_if_ready();
+        void process_ready_events(bool drain);
+        void report_pose_if_changed(bool updated);
+        void flush_timings(double timestamp);
+
+        Parameters parameters_;
+        PerformanceStats performance_stats_;
+        Estimator estimator_;
+        observation::ImuObservation imu_;
+        std::vector<observation::PointCloudObservation> point_clouds_;
+        std::optional<observation::WheelSpeedObservation> wheel_speed_;
+        std::optional<observation::ImageObservation> image_;
+        Eigen::Matrix<State::ValueType, State::DIM, State::DIM> process_noise_;
+        std::array<double, static_cast<std::size_t>(PerfTimer::Count)> previous_time_ns_{};
+        double initialization_timestamp_{};
+        std::size_t initialization_map_size_{};
+        double current_timestamp_{};
+        double last_pose_timestamp_{-1.0};
+        bool initialized_{};
+        PoseCallback pose_callback_;
+        TimingCallback timing_callback_;
+    };
+
+}// namespace small_point_slam::standalone
