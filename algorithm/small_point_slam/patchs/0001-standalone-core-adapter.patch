diff --git a/standalone/small_point_slam_engine.cpp b/standalone/small_point_slam_engine.cpp
new file mode 100644
index 0000000..6e91d63
--- /dev/null
+++ b/standalone/small_point_slam_engine.cpp
@@ -0,0 +1,261 @@
+#include "small_point_slam_engine.hpp"
+
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace small_point_slam::standalone {
+    namespace {
+
+        YAML::Node normalized_config(const YAML::Node &input) {
+            YAML::Node result = YAML::Clone(input);
+            result["min_distance"] = input["min_range_m"].as<float>();
+            result["max_distance"] = input["max_range_m"].as<float>();
+            result["space_downsample_leaf_size"] = input["filter_size_scan_m"].as<float>();
+            result["map_resolution"] = input["map_voxel_size_m"].as<float>();
+            result["batch_update_max_iterated_times"] = input["max_iterations"].as<std::size_t>();
+            result["point_plane_distance_cov"] = input["lidar_measurement_noise"].as<double>();
+            result["imu_meas_acc_cov"] = input["accelerometer_noise"].as<double>();
+            result["imu_meas_omg_cov"] = input["gyroscope_noise"].as<double>();
+            result["ba_cov"] = input["accelerometer_bias_noise"].as<double>();
+            result["bg_cov"] = input["gyroscope_bias_noise"].as<double>();
+            return result;
+        }
+
+        enum class EventType { None,
+                               Imu,
+                               Point,
+                               WheelSpeed,
+                               Image };
+
+        struct NextEvent {
+            EventType type{EventType::None};
+            std::size_t sensor_index{};
+            double timestamp{std::numeric_limits<double>::max()};
+        };
+
+    }// namespace
+
+    SmallPointSlamEngine::SmallPointSlamEngine(
+            const YAML::Node &config, const std::vector<SensorExtrinsic> &lidars,
+            const std::optional<Eigen::Matrix3f> &imu_rotation,
+            bool wheel_speed_available,
+            const std::optional<CameraConfiguration> &camera) {
+        if (lidars.empty()) throw std::invalid_argument("at least one LiDAR is required");
+
+        YAML::Node effective = normalized_config(config);
+        effective["enable_imu"] = config["enable_imu"].as<bool>(true) && imu_rotation.has_value();
+        effective["enable_wheel_speed"] =
+                config["enable_wheel_speed"].as<bool>(true) && wheel_speed_available;
+        effective["enable_image_update"] =
+                config["enable_image_update"].as<bool>(true) && camera.has_value();
+        parameters_.read_parameters(effective);
+
+        estimator_.parameters = &parameters_;
+        estimator_.performance_stats = &performance_stats_;
+        estimator_.kf.debug = parameters_.debug_eskf;
+        estimator_.kf.debug_point_window_start = parameters_.debug_point_window_start;
+        estimator_.kf.debug_point_window_end = parameters_.debug_point_window_end;
+        estimator_.kf.debug_point_update_row_stride = parameters_.debug_point_row_stride;
+        process_noise_ = estimator_.process_noise_cov();
+        if (!parameters_.enable_imu) {
+            process_noise_.block<3, 3>(State::velocity_index, State::velocity_index)
+                    .diagonal()
+                    .fill(parameters_.imu_off_velocity_cov);
+            process_noise_.block<3, 3>(State::omg_index, State::omg_index)
+                    .diagonal()
+                    .fill(parameters_.imu_off_omg_cov);
+            process_noise_.block<3, 3>(State::acceleration_index, State::acceleration_index)
+                    .diagonal()
+                    .fill(parameters_.imu_off_acceleration_cov);
+            process_noise_.block<3, 3>(State::bg_index, State::bg_index).setZero();
+            process_noise_.block<3, 3>(State::ba_index, State::ba_index).setZero();
+            process_noise_(State::wheel_k_index, State::wheel_k_index) = 0.0;
+        }
+
+        point_clouds_.resize(lidars.size());
+        for (std::size_t index = 0; index < lidars.size(); ++index) {
+            point_clouds_[index].initialize(&parameters_, lidars[index].rotation,
+                                            lidars[index].translation, &performance_stats_);
+            point_clouds_[index].set_dense_output_enabled(false);
+        }
+        imu_.initialize(&parameters_, imu_rotation.value_or(Eigen::Matrix3f::Identity()),
+                        &performance_stats_);
+        if (parameters_.enable_wheel_speed) {
+            wheel_speed_.emplace();
+            wheel_speed_->initialize(&parameters_, &performance_stats_);
+        }
+        if (camera) {
+            image_.emplace();
+            image_->initialize(camera->model, parameters_, camera->extrinsic.rotation,
+                               camera->extrinsic.translation, &performance_stats_);
+        }
+        estimator_.reset();
+    }
+
+    void SmallPointSlamEngine::add_imu(const common::ImuStamped &sample) {
+        imu_.initialize_data(sample);
+    }
+
+    void SmallPointSlamEngine::add_point_cloud(
+            std::size_t sensor_index, const std::vector<common::PointStamped> &cloud) {
+        point_clouds_.at(sensor_index).initialize_data(cloud);
+    }
+
+    void SmallPointSlamEngine::add_wheel_speed(const common::WheelSpeed &sample) {
+        if (wheel_speed_) wheel_speed_->initialize_data(sample);
+    }
+
+    void SmallPointSlamEngine::add_image(const common::ImageStamped &sample) {
+        if (image_) image_->initialize_data(sample);
+    }
+
+    void SmallPointSlamEngine::initialize_if_ready() {
+        for (auto &point_cloud: point_clouds_) {
+            point_cloud.run_initialization_once(estimator_, initialization_timestamp_,
+                                                initialization_map_size_);
+        }
+        imu_.run_initialization_once(initialization_timestamp_);
+        if (wheel_speed_) wheel_speed_->run_initialization_once(initialization_timestamp_);
+        if (image_) image_->run_initialization_once(initialization_timestamp_);
+        if (initialization_timestamp_ <= 0.0 ||
+            initialization_map_size_ < parameters_.init_map_size ||
+            !imu_.initialization_ready()) return;
+
+        initialized_ = true;
+        current_timestamp_ = initialization_timestamp_;
+        estimator_.kf.init_timestamp(initialization_timestamp_);
+        imu_.initialize_filter_state(estimator_.kf);
+        estimator_.kf.align_to_gravity();
+        for (auto &point_cloud: point_clouds_) {
+            point_cloud.finish_initialization(initialization_timestamp_, estimator_);
+        }
+        spdlog::info("Small Point SLAM initialized with {} LiDARs and {} map points",
+                     point_clouds_.size(), initialization_map_size_);
+    }
+
+    void SmallPointSlamEngine::handle_once() {
+        if (!initialized_) {
+            initialize_if_ready();
+            flush_timings(initialization_timestamp_);
+            return;
+        }
+        process_ready_events(false);
+        flush_timings(current_timestamp_);
+    }
+
+    void SmallPointSlamEngine::finalize() {
+        if (!initialized_) initialize_if_ready();
+        if (initialized_) process_ready_events(true);
+        flush_timings(current_timestamp_);
+    }
+
+    void SmallPointSlamEngine::process_ready_events(bool drain) {
+        bool updated = false;
+        const auto synchronized_sources_ready = [&] {
+            if (parameters_.enable_imu && !imu_.has_data()) return false;
+            if (std::ranges::any_of(point_clouds_, [](const auto &cloud) {
+                    return !cloud.has_filter_data();
+                })) return false;
+            if (wheel_speed_ && !wheel_speed_->has_data()) return false;
+            if (image_ && !image_->has_data()) return false;
+            return true;
+        };
+        const auto any_source_ready = [&] {
+            return imu_.has_data() ||
+                   std::ranges::any_of(point_clouds_, [](const auto &cloud) {
+                       return cloud.has_filter_data();
+                   }) ||
+                   (wheel_speed_ && wheel_speed_->has_data()) || (image_ && image_->has_data());
+        };
+
+        while (drain ? any_source_ready() : synchronized_sources_ready()) {
+            NextEvent next;
+            const auto consider = [&next](EventType type, std::size_t sensor_index,
+                                          double timestamp) {
+                if (timestamp <= next.timestamp) next = {type, sensor_index, timestamp};
+            };
+            if (parameters_.enable_imu && imu_.has_data())
+                consider(EventType::Imu, 0, imu_.timestamp());
+            for (std::size_t index = 0; index < point_clouds_.size(); ++index) {
+                if (point_clouds_[index].has_filter_data())
+                    consider(EventType::Point, index, point_clouds_[index].filter_timestamp());
+            }
+            if (wheel_speed_ && wheel_speed_->has_data())
+                consider(EventType::WheelSpeed, 0, wheel_speed_->timestamp());
+            if (image_ && image_->has_data())
+                consider(EventType::Image, 0, image_->timestamp());
+            if (next.type == EventType::None) break;
+
+            observation::UpdateResult result = observation::UpdateResult::Updated;
+            if (next.type == EventType::Imu) {
+                result = imu_.run_update_once(estimator_.kf, process_noise_, current_timestamp_);
+            } else if (next.type == EventType::Point) {
+                std::vector<PointWithNormal> visual_points;
+                result = point_clouds_[next.sensor_index].run_update_once(
+                        estimator_, process_noise_, current_timestamp_, image_.has_value(),
+                        visual_points);
+                if (image_) image_->append_visual_points(visual_points);
+            } else if (next.type == EventType::WheelSpeed) {
+                result = wheel_speed_->run_update_once(estimator_.kf, process_noise_,
+                                                       current_timestamp_);
+            } else if (next.type == EventType::Image) {
+                result = image_->run_update_once(estimator_, process_noise_, current_timestamp_,
+                                                 parameters_.enable_image_update, {}, {});
+            }
+            if (result == observation::UpdateResult::PredictionFailed)
+                throw std::runtime_error("Small Point SLAM filter prediction failed");
+            updated = updated || result == observation::UpdateResult::Updated;
+        }
+        report_pose_if_changed(updated);
+    }
+
+    void SmallPointSlamEngine::report_pose_if_changed(bool updated) {
+        if (!updated || !pose_callback_ || current_timestamp_ <= last_pose_timestamp_) return;
+        pose_callback_(current_timestamp_, estimator_.kf.x);
+        last_pose_timestamp_ = current_timestamp_;
+    }
+
+    void SmallPointSlamEngine::flush_timings(double timestamp) {
+        if (!timing_callback_ || timestamp <= 0.0) return;
+        const auto delta = [this](PerfTimer timer) {
+            const std::size_t index = static_cast<std::size_t>(timer);
+            const double total = performance_stats_.get_time_stat(timer).total_time_ns;
+            const double value = std::max(0.0, total - previous_time_ns_[index]);
+            previous_time_ns_[index] = total;
+            return value * 1e-6;
+        };
+
+        delta(PerfTimer::DataPreprocessing);
+        const double downsampling = delta(PerfTimer::PreprocessVoxelDownsample);
+        const double state_propagation = delta(PerfTimer::FilterPrediction);
+        const double imu_update = delta(PerfTimer::ImuUpdate);
+        const double point_update = delta(PerfTimer::PointCloudUpdate);
+        const double wheel_update = delta(PerfTimer::WheelOdometryUpdate);
+        const double image_update = delta(PerfTimer::ImageUpdate);
+        const double lookup = delta(PerfTimer::MapLookup);
+        const double residual = delta(PerfTimer::ResidualCalculation);
+        const double map_update = delta(PerfTimer::MapUpdate);
+        delta(PerfTimer::PlaneConstruction);
+
+        const auto report = [this, timestamp](const char *stage, double duration_ms) {
+            if (duration_ms > 0.0) timing_callback_(timestamp, stage, duration_ms);
+        };
+        report("downsampling", downsampling);
+        report("state_propagation", state_propagation);
+        report("map_search", lookup + residual);
+        report("filter_update", imu_update + wheel_update + image_update +
+                                        std::max(0.0, point_update - lookup - residual));
+        report("map_update", map_update);
+    }
+
+    void SmallPointSlamEngine::set_pose_callback(PoseCallback callback) {
+        pose_callback_ = std::move(callback);
+    }
+
+    void SmallPointSlamEngine::set_timing_callback(TimingCallback callback) {
+        timing_callback_ = std::move(callback);
+    }
+
+}// namespace small_point_slam::standalone
