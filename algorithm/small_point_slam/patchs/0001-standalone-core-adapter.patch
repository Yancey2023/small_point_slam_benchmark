+    Eigen::Vector3f normal = Eigen::Vector3f::UnitZ();
+    float minimum_eigenvalue{};
+    float middle_eigenvalue{};
+    float maximum_eigenvalue{};
+    Eigen::Matrix3f normal_covariance = Eigen::Matrix3f::Zero();
+    float alpha{0.8F};
+};
+
