diff --git a/src/common/spdlog_stream.h b/src/common/spdlog_stream.h
new file mode 100644
index 0000000..3597319
--- /dev/null
+++ b/src/common/spdlog_stream.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <spdlog/spdlog.h>
+
+#include <ostream>
+#include <sstream>
+#include <utility>
+
+namespace zjloc::common {
+
+class SpdlogStream {
+public:
+    explicit SpdlogStream(spdlog::level::level_enum level) : level_(level) {}
+    SpdlogStream(const SpdlogStream&) = delete;
+    SpdlogStream(SpdlogStream&&) = default;
+    ~SpdlogStream() { spdlog::log(level_, "{}", stream_.str()); }
+
+    template <typename T>
+    SpdlogStream& operator<<(T&& value) {
+        stream_ << std::forward<T>(value);
+        return *this;
+    }
+
+    SpdlogStream& operator<<(std::ostream& (*manipulator)(std::ostream&)) {
+        manipulator(stream_);
+        return *this;
+    }
+
+private:
+    spdlog::level::level_enum level_;
+    std::ostringstream stream_;
+};
+
+}  // namespace zjloc::common
