@@ -0,0 +1,109 @@
+#include "ct_lio_adapter.hpp"
+
+#include <slam_benchmark/calibration.hpp>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+namespace {
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+}  // namespace
+
+slam_benchmark::InitializationResult CtLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .point_time = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Lidar);
+    const auto imu = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Imu);
+    if (lidar == sensors.end() || imu == sensors.end()) {
+        return slam_benchmark::InitializationResult::unsupported("CT-LIO requires one LiDAR and one IMU");
+    }
+    sink_ = &sink;
+    const auto transform =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    Vec3d translation(transform[3], transform[7], transform[11]);
+    Mat3d rotation;
+    rotation << transform[0], transform[1], transform[2],
+        transform[4], transform[5], transform[6],
+        transform[8], transform[9], transform[10];
+    odometry_.init(config_path.string(), translation, rotation);
+    std::function<bool(std::string&, SE3&, double)> pose_callback =
+        [this](std::string& topic, SE3& state, double timestamp) {
+            if (topic != "laser") return true;
+            const Eigen::Quaterniond quaternion(state.rotationMatrix());
+            slam_benchmark::Pose pose;
+            pose.timestamp_ns = time_origin_ns_ + nanoseconds(timestamp);
+            pose.translation_m = {state.translation().x(), state.translation().y(),
+                                  state.translation().z()};
+            pose.rotation_xyzw = {quaternion.x(), quaternion.y(), quaternion.z(), quaternion.w()};
+            trajectory_.push_back(pose);
+            sink_->report_realtime_pose(pose);
+            return true;
+    };
+    odometry_.setFunc(pose_callback);
+    odometry_.setTimingFunc([this](const char* stage, double timestamp, double duration_ms) {
+        sink_->report_timing(
+            {time_origin_ns_ + nanoseconds(timestamp), stage, duration_ms});
+    });
+    spdlog::info("CT-LIO standalone adapter initialized");
+    return compatibility;
+}
+
+void CtLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (time_origin_ns_ == 0) time_origin_ns_ = sample.timestamp_ns;
+    const double sample_time = static_cast<double>(sample.timestamp_ns - time_origin_ns_) * 1e-9;
+    const auto started = std::chrono::steady_clock::now();
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        odometry_.pushData(std::make_shared<zjloc::IMU>(
+            sample_time,
+            Eigen::Vector3d(imu->angular_velocity_rad_s[0], imu->angular_velocity_rad_s[1],
+                            imu->angular_velocity_rad_s[2]),
+            Eigen::Vector3d(imu->linear_acceleration_m_s2[0], imu->linear_acceleration_m_s2[1],
+                            imu->linear_acceleration_m_s2[2])));
+        const double elapsed = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count();
+        sink_->report_timing({sample.timestamp_ns, "imu_preprocess", elapsed});
+    } else if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size()) {
+            throw std::runtime_error("point/time array size mismatch");
+        }
+        std::vector<point3D> points;
+        points.reserve(cloud->points.size());
+        const auto [minimum, maximum] = std::ranges::minmax(cloud->point_time_offset_ns);
+        const double span = std::max(1e-9, static_cast<double>(maximum - minimum) * 1e-9);
+        const double begin = sample_time + static_cast<double>(minimum) * 1e-9;
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto& source = cloud->points[index];
+            if (!std::isfinite(source.x) || !std::isfinite(source.y) || !std::isfinite(source.z)) continue;
+            point3D point;
+            point.raw_point = {source.x, source.y, source.z};
+            point.point = point.raw_point;
+            point.intensity = source.intensity;
+            point.ring = source.ring;
+            point.relative_time = static_cast<double>(cloud->point_time_offset_ns[index] - minimum) * 1e-9;
+            point.alpha_time = point.relative_time / span;
+            point.timespan = span;
+            point.timestamp = begin + point.relative_time;
+            points.push_back(point);
+        }
+        odometry_.pushData(std::move(points), {begin, span});
+        const double elapsed = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count();
+        sink_->report_timing({sample.timestamp_ns, "lidar_preprocess", elapsed});
+    }
+    odometry_.processAvailable();
+}
+
+void CtLioAdapter::finalize() {
+    odometry_.processAvailable();
+    sink_->report_final_trajectory(trajectory_);
+}
