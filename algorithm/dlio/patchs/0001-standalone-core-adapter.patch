+
+struct DlioImuSample {
+    double timestamp{};
+    Eigen::Vector3d angular_velocity = Eigen::Vector3d::Zero();
+    Eigen::Vector3d linear_acceleration = Eigen::Vector3d::Zero();
+};
+
+class DlioEngine {
+public:
+    struct Options {
+        double scan_filter_size_m = 0.2;
+        double map_filter_size_m = 0.2;
+        int max_iterations = 6;
+        int threads = 4;
+        int correspondence_randomness = 20;
+        double max_correspondence_distance_m = 0.5;
+        double keyframe_distance_m = 0.1;
+        double keyframe_rotation_deg = 1.0;
+        std::size_t submap_keyframes = 25;
+        bool deskew = true;
+    };
+
+    using PoseCallback =
+        std::function<void(double, const Eigen::Isometry3d&)>;
+    using TimingCallback = std::function<void(double, const char*, double)>;
+
+    DlioEngine();
+    ~DlioEngine();
+    DlioEngine(const DlioEngine&) = delete;
+    DlioEngine& operator=(const DlioEngine&) = delete;
+
+    void initialize(const Options& options);
+    void set_pose_callback(PoseCallback callback);
+    void set_timing_callback(TimingCallback callback);
+    void process(double scan_start, pcl::PointCloud<PointType>::Ptr cloud,
+                 const std::vector<double>& point_offsets,
+                 const std::vector<DlioImuSample>& imu_samples);
+    void finalize();
+
+private:
+    class Impl;
+    std::unique_ptr<Impl> impl_;
+};
