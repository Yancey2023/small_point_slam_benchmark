+#pragma once
+
+#include <Eigen/Core>
+#include <Eigen/Geometry>
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <vector>
+
+namespace faster_lio::standalone {
+
+struct TimedPoint {
+    Eigen::Vector3f position = Eigen::Vector3f::Zero();
+    float intensity = 0.0F;
+    double offset_seconds = 0.0;
+};
+
+struct ImuMeasurement {
+    double timestamp = 0.0;
+    Eigen::Vector3d acceleration = Eigen::Vector3d::Zero();
+    Eigen::Vector3d angular_velocity = Eigen::Vector3d::Zero();
+};
+
+struct Scan {
+    double begin_time = 0.0;
+    double end_time = 0.0;
+    std::vector<TimedPoint> points;
+    std::vector<ImuMeasurement> imu;
+};
+
+struct PoseState {
+    Eigen::Vector3d translation = Eigen::Vector3d::Zero();
+    Eigen::Quaterniond rotation = Eigen::Quaterniond::Identity();
+};
+
+class FasterLioEngine {
+public:
+    struct Options {
+        double scan_voxel_size = 0.5;
+        double map_voxel_size = 0.3;
+        double ivox_resolution = 0.5;
+        int ivox_nearby_type = 18;
+        int max_iterations = 4;
+        bool estimate_extrinsics = false;
+        Eigen::Vector3d lidar_translation = Eigen::Vector3d::Zero();
+        Eigen::Matrix3d lidar_rotation = Eigen::Matrix3d::Identity();
+        Eigen::Vector3d gyroscope_covariance = Eigen::Vector3d::Constant(0.1);
+        Eigen::Vector3d accelerometer_covariance = Eigen::Vector3d::Constant(0.1);
+        Eigen::Vector3d gyroscope_bias_covariance = Eigen::Vector3d::Constant(0.0001);
+        Eigen::Vector3d accelerometer_bias_covariance = Eigen::Vector3d::Constant(0.0001);
+    };
+
+    using PoseCallback = std::function<void(double, const PoseState&)>;
+    using TimingCallback = std::function<void(double, const char*, double)>;
+
+    FasterLioEngine();
+    ~FasterLioEngine();
+    FasterLioEngine(const FasterLioEngine&) = delete;
+    FasterLioEngine& operator=(const FasterLioEngine&) = delete;
+
+    void initialize(const Options& options);
+    void process(const Scan& scan);
+    void set_pose_callback(PoseCallback callback);
+    void set_timing_callback(TimingCallback callback);
+
+private:
+    class Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace faster_lio::standalone
