diff --git a/standalone/faster_lio_adapter.cpp b/standalone/faster_lio_adapter.cpp
new file mode 100644
index 0000000..1845f26
--- /dev/null
+++ b/standalone/faster_lio_adapter.cpp
@@ -0,0 +1,152 @@
+#include "faster_lio_adapter.hpp"
+
+#include <slam_benchmark/calibration.hpp>
+#include <spdlog/spdlog.h>
+#include <yaml-cpp/yaml.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <ranges>
+#include <stdexcept>
+
+#ifndef SLAM_BENCHMARK_PARALLEL_THREADS
+#define SLAM_BENCHMARK_PARALLEL_THREADS 4
+#endif
+
+namespace {
+double seconds(slam_benchmark::TimestampNs value) {
+    return static_cast<double>(value) * 1e-9;
+}
+
+slam_benchmark::TimestampNs nanoseconds(double value) {
+    return static_cast<slam_benchmark::TimestampNs>(std::llround(value * 1e9));
+}
+
+template <typename T>
+T parameter(const YAML::Node& root, const char* key, T fallback) {
+    return root[key] ? root[key].as<T>() : fallback;
+}
+}  // namespace
+
+slam_benchmark::InitializationResult FasterLioAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true, .imu = true, .point_time = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors,
+                                                      slam_benchmark::SensorType::Lidar);
+    const auto imu = compatibility.selected_sensor(sensors,
+                                                    slam_benchmark::SensorType::Imu);
+    if (lidar == sensors.end() || imu == sensors.end())
+        throw std::runtime_error("Faster-LIO requires one LiDAR and one IMU");
+
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    const int parallel_threads = parameter(
+        root, "parallel_threads", SLAM_BENCHMARK_PARALLEL_THREADS);
+    if (parallel_threads <= 0) {
+        throw std::runtime_error("parallel_threads must be positive");
+    }
+    tbb_control_ = std::make_unique<tbb::global_control>(
+        tbb::global_control::max_allowed_parallelism,
+        static_cast<std::size_t>(parallel_threads));
+    faster_lio::standalone::FasterLioEngine::Options options;
+    options.scan_voxel_size = parameter(root, "filter_size_scan_m", 0.5);
+    options.map_voxel_size = parameter(root, "filter_size_map_m", 0.5);
+    options.ivox_resolution = parameter(root, "map_voxel_size_m", 0.5);
+    options.ivox_nearby_type = parameter(root, "ivox_nearby_type", 18);
+    options.max_iterations = parameter(root, "max_iterations", 4);
+    options.estimate_extrinsics = parameter(root, "estimate_extrinsics", false);
+    options.gyroscope_covariance.setConstant(parameter(root, "gyroscope_noise", 0.1));
+    options.accelerometer_covariance.setConstant(parameter(root, "accelerometer_noise", 0.1));
+    options.gyroscope_bias_covariance.setConstant(
+        parameter(root, "gyroscope_bias_noise", 0.0001));
+    options.accelerometer_bias_covariance.setConstant(
+        parameter(root, "accelerometer_bias_noise", 0.0001));
+    const auto transform =
+        slam_benchmark::target_from_source(imu->calibration, lidar->calibration);
+    options.lidar_rotation << transform[0], transform[1], transform[2], transform[4],
+        transform[5], transform[6], transform[8], transform[9], transform[10];
+    options.lidar_translation << transform[3], transform[7], transform[11];
+
+    sink_ = &sink;
+    engine_.set_pose_callback(
+        [this](double timestamp, const auto& state) { accept_pose(timestamp, state); });
+    engine_.set_timing_callback([this](double timestamp, const char* stage, double duration) {
+        sink_->report_timing({nanoseconds(timestamp), stage, duration});
+    });
+    engine_.initialize(options);
+    spdlog::info("Faster-LIO standalone adapter initialized with {} compute threads",
+                 parallel_threads);
+    return compatibility;
+}
+
+void FasterLioAdapter::process(const slam_benchmark::SensorSample& sample) {
+    if (const auto* imu = std::get_if<slam_benchmark::ImuSample>(&sample.payload)) {
+        const auto started = std::chrono::steady_clock::now();
+        faster_lio::standalone::ImuMeasurement value;
+        value.timestamp = seconds(sample.timestamp_ns);
+        value.angular_velocity << imu->angular_velocity_rad_s[0],
+            imu->angular_velocity_rad_s[1], imu->angular_velocity_rad_s[2];
+        value.acceleration << imu->linear_acceleration_m_s2[0],
+            imu->linear_acceleration_m_s2[1], imu->linear_acceleration_m_s2[2];
+        imu_queue_.push_back(value);
+        const double duration = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count();
+        sink_->report_timing({sample.timestamp_ns, "imu_preprocess", duration});
+    } else if (const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload)) {
+        if (cloud->points.size() != cloud->point_time_offset_ns.size())
+            throw std::runtime_error("point/time array size mismatch");
+        const auto started = std::chrono::steady_clock::now();
+        faster_lio::standalone::Scan scan;
+        scan.begin_time = seconds(sample.timestamp_ns);
+        scan.end_time = scan.begin_time;
+        scan.points.reserve(cloud->points.size());
+        for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+            const auto& source = cloud->points[index];
+            if (!std::isfinite(source.x) || !std::isfinite(source.y) || !std::isfinite(source.z))
+                continue;
+            const double offset = static_cast<double>(cloud->point_time_offset_ns[index]) * 1e-9;
+            scan.points.push_back({Eigen::Vector3f(source.x, source.y, source.z),
+                                   source.intensity, offset});
+            scan.end_time = std::max(scan.end_time, scan.begin_time + offset);
+        }
+        std::ranges::sort(scan.points, {}, &faster_lio::standalone::TimedPoint::offset_seconds);
+        lidar_queue_.push_back(std::move(scan));
+        const double duration = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count();
+        sink_->report_timing({sample.timestamp_ns, "lidar_preprocess", duration});
+    }
+    drain();
+}
+
+void FasterLioAdapter::drain() {
+    while (!lidar_queue_.empty() && !imu_queue_.empty() &&
+           imu_queue_.back().timestamp >= lidar_queue_.front().end_time) {
+        auto scan = std::move(lidar_queue_.front());
+        lidar_queue_.pop_front();
+        while (!imu_queue_.empty() && imu_queue_.front().timestamp <= scan.end_time) {
+            scan.imu.push_back(imu_queue_.front());
+            imu_queue_.pop_front();
+        }
+        if (!scan.imu.empty()) engine_.process(scan);
+    }
+}
+
+void FasterLioAdapter::accept_pose(
+    double timestamp, const faster_lio::standalone::PoseState& state) {
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(timestamp);
+    pose.translation_m = {state.translation.x(), state.translation.y(), state.translation.z()};
+    pose.rotation_xyzw = {state.rotation.x(), state.rotation.y(),
+                          state.rotation.z(), state.rotation.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void FasterLioAdapter::finalize() {
+    drain();
+    sink_->report_final_trajectory(trajectory_);
+}
