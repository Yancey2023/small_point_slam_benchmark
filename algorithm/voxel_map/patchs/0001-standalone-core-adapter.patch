+#pragma once
+
+#include "common_lib.h"
+
+#include <functional>
+#include <memory>
+#include <vector>
+
+class VoxelMapEngine {
+public:
+    struct Options {
+        double scan_filter_size_m = 0.5;
+        double map_voxel_size_m = 1.0;
+        int max_layer = 2;
+        int max_points = 100;
+        int max_iterations = 4;
+        float minimum_eigenvalue_ratio = 0.01F;
+        float range_noise = 0.02F;
+        float angle_noise_degrees = 0.05F;
+        std::vector<int> layer_point_sizes{20, 10, 10};
+    };
+
+    using PoseCallback = std::function<void(double, const StatesGroup&)>;
+    using TimingCallback = std::function<void(double, const char*, double)>;
+
+    VoxelMapEngine();
+    ~VoxelMapEngine();
+    VoxelMapEngine(const VoxelMapEngine&) = delete;
+    VoxelMapEngine& operator=(const VoxelMapEngine&) = delete;
+
+    void initialize(const Options& options);
+    void set_pose_callback(PoseCallback callback);
+    void set_timing_callback(TimingCallback callback);
+    void process(double timestamp, const PointCloudXYZI::Ptr& cloud);
+
+private:
+    class Impl;
+    std::unique_ptr<Impl> impl_;
+};
