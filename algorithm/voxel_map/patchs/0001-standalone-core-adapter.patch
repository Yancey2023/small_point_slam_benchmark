+slam_benchmark::InitializationResult VoxelMapAdapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path& config_path,
+    slam_benchmark::ResultSink& sink) {
+    auto compatibility = slam_benchmark::check_dataset_compatibility(
+        sensors, {.lidar = true});
+    if (!compatibility) return compatibility;
+    const auto lidar = compatibility.selected_sensor(sensors, slam_benchmark::SensorType::Lidar);
+    if (lidar == sensors.end()) return slam_benchmark::InitializationResult::unsupported("VoxelMap requires a LiDAR");
+    sink_ = &sink;
+    lidar_id_ = lidar->id;
+    const auto& transform = lidar->calibration.body_from_sensor;
+    for (int row = 0; row < 4; ++row)
+        for (int column = 0; column < 4; ++column)
+            body_from_lidar_(row, column) = transform[row * 4 + column];
+
+    const YAML::Node root = YAML::LoadFile(config_path.string());
+    const int parallel_threads = required_parameter<int>(root, "parallel_threads");
+    if (parallel_threads <= 0) {
+        throw std::runtime_error("parallel_threads must be positive");
+    }
+    omp_set_dynamic(0);
+    omp_set_num_threads(parallel_threads);
+    VoxelMapEngine::Options options;
+    options.scan_filter_size_m = required_parameter<double>(root, "filter_size_scan_m");
+    options.map_voxel_size_m = required_parameter<double>(root, "map_voxel_size_m");
+    options.max_layer = required_parameter<int>(root, "max_layer");
+    options.max_points = required_parameter<int>(root, "max_points_per_voxel");
+    options.max_iterations = required_parameter<int>(root, "max_iterations");
+    options.minimum_eigenvalue_ratio =
+        required_parameter<float>(root, "min_eigenvalue_ratio");
+    options.range_noise = required_parameter<float>(root, "range_noise_m");
+    options.angle_noise_degrees = required_parameter<float>(root, "angle_noise_deg");
+    options.layer_point_sizes =
+        required_parameter<std::vector<int>>(root, "layer_point_sizes");
+    if (options.scan_filter_size_m <= 0.0 || options.map_voxel_size_m <= 0.0 ||
+        options.max_layer < 0 || options.max_points <= 0 || options.max_iterations <= 0 ||
+        options.layer_point_sizes.empty())
+        throw std::runtime_error("VoxelMap parameters must be positive");
+    while (options.layer_point_sizes.size() <= static_cast<std::size_t>(options.max_layer))
+        options.layer_point_sizes.push_back(options.layer_point_sizes.back());
+
+    engine_.set_pose_callback(
+        [this](double timestamp, const StatesGroup& state) { accept_pose(timestamp, state); });
+    engine_.set_timing_callback([this](double timestamp, const char* stage, double duration) {
+        sink_->report_timing({nanoseconds(timestamp), stage, duration});
+    });
+    engine_.initialize(options);
+    spdlog::info("VoxelMap parameters: scan filter={} m, map voxel={} m, "
+                 "iterations={}, compute threads={}",
+                 options.scan_filter_size_m, options.map_voxel_size_m,
+                 options.max_iterations, parallel_threads);
+    spdlog::info("VoxelMap standalone adapter initialized");
+    return compatibility;
+}
+
+void VoxelMapAdapter::process(const slam_benchmark::SensorSample& sample) {
+    const auto* cloud = std::get_if<slam_benchmark::PointCloud>(&sample.payload);
+    if (cloud == nullptr || sample.sensor_id != lidar_id_) return;
+    const auto started = std::chrono::steady_clock::now();
+    PointCloudXYZI::Ptr converted(new PointCloudXYZI());
+    converted->reserve(cloud->points.size());
+    for (std::size_t index = 0; index < cloud->points.size(); ++index) {
+        const auto& source = cloud->points[index];
+        const Eigen::Vector4d transformed =
+            body_from_lidar_ * Eigen::Vector4d(source.x, source.y, source.z, 1.0);
+        PointType point;
+        point.x = transformed.x();
+        point.y = transformed.y();
+        point.z = transformed.z();
+        point.intensity = source.intensity;
+        point.normal_x = point.normal_y = point.normal_z = 0.0F;
+        point.curvature = 0.0F;
+        converted->push_back(point);
+    }
+    sink_->report_timing(
+        {sample.timestamp_ns, "lidar_preprocess",
+         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
+                                                   started)
+             .count()});
+    engine_.process(seconds(sample.timestamp_ns), converted);
+}
+
+void VoxelMapAdapter::accept_pose(double timestamp, const StatesGroup& state) {
+    const Eigen::Quaterniond quaternion(state.rot_end);
+    slam_benchmark::Pose pose;
+    pose.timestamp_ns = nanoseconds(timestamp);
+    pose.translation_m = {state.pos_end.x(), state.pos_end.y(), state.pos_end.z()};
+    pose.rotation_xyzw = {quaternion.x(), quaternion.y(), quaternion.z(), quaternion.w()};
+    trajectory_.push_back(pose);
+    sink_->report_realtime_pose(pose);
+}
+
+void VoxelMapAdapter::finalize() {
+    sink_->report_final_trajectory(trajectory_);
+}
