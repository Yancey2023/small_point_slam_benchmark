-      y_body(0) = 0;
-    }
-  }
-  y_body.normalize();
-  Eigen::Vector3d z_body = x_body.cross(y_body);
-  Eigen::Matrix3d rot;
-
-  rot << x_body(0), x_body(1), x_body(2), y_body(0), y_body(1), y_body(2),
