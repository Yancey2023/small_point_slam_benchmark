+slam_benchmark::InitializationResult FastLivo2Adapter::initialize(
+    std::span<const slam_benchmark::SensorDefinition> sensors,
+    const std::filesystem::path &config_path,
+    slam_benchmark::ResultSink &sink) {
+  auto compatibility = slam_benchmark::check_dataset_compatibility(
+      sensors, {.lidar = true, .imu = true, .camera = true,
+                .point_time = true});
+  if (!compatibility) return compatibility;
+
+  const auto lidar = compatibility.selected_sensor(
+      sensors, slam_benchmark::SensorType::Lidar);
+  const auto imu = compatibility.selected_sensor(
+      sensors, slam_benchmark::SensorType::Imu);
+  const auto camera = compatibility.selected_sensor(
+      sensors, slam_benchmark::SensorType::Camera);
+  if (lidar == sensors.end() || imu == sensors.end() || camera == sensors.end())
+    return slam_benchmark::InitializationResult::unsupported("FAST-LIVO2 requires LiDAR, IMU and camera inputs");
+  if (camera->calibration.intrinsics.size() != 4 ||
+      camera->calibration.image_width == 0 ||
+      camera->calibration.image_height == 0)
+    return slam_benchmark::InitializationResult::unsupported(
+        "FAST-LIVO2 相机标定需要 [fx, fy, cx, cy] 内参和有效分辨率");
+
+  const YAML::Node root = YAML::LoadFile(config_path.string());
+  const YAML::Node preprocessing = root["preprocessing"];
+  const YAML::Node imu_config = root["imu"];
+  const YAML::Node map = root["pointcloud_map"];
+  const YAML::Node visual = root["visual_tracking"];
+  const YAML::Node runtime = root["runtime_behavior"];
+
+  StandaloneFastLivo2Config config;
+  config.parallel_threads = parameter(root, "parallel_threads", 4);
+  if (config.parallel_threads <= 0)
+    throw std::runtime_error("parallel_threads must be positive");
+  config.camera_scale = parameter(root, "camera_scale", 0.5);
+  config.point_filter_num = parameter(
+      preprocessing, "lidar_point_sampling_stride", 1);
+  config.lidar_voxel_size = parameter(
+      preprocessing, "lidar_downsample_voxel_size", 0.1);
+  config.blind = parameter(preprocessing, "minimum_lidar_range", 0.8);
+  config.imu_initialization_frames = parameter(
+      imu_config, "imu_integration_frame_count", 30);
+  config.accelerometer_covariance = parameter(
+      imu_config, "accelerometer_covariance", 0.5);
+  config.gyroscope_covariance = parameter(
+      imu_config, "gyroscope_covariance", 0.3);
+  config.accelerometer_bias_covariance = parameter(
+      imu_config, "accelerometer_bias_covariance", 0.0001);
+  config.gyroscope_bias_covariance = parameter(
+      imu_config, "gyroscope_bias_covariance", 0.0001);
+  config.visual_iterations = parameter(visual, "max_iterations", 5);
+  config.visual_grid_size = parameter(visual, "grid_size", 30);
+  config.visual_patch_size = parameter(visual, "patch_size", 8);
+  config.visual_pyramid_levels = parameter(
+      visual, "patch_pyramid_levels", 4);
+  config.visual_outlier_threshold = parameter(
+      visual, "outlier_threshold", 1000.0);
+  config.visual_image_covariance = parameter(
+      visual, "image_point_covariance", 100.0);
+  config.inverse_exposure_covariance = parameter(
+      visual, "inverse_exposure_covariance", 0.1);
+  config.exposure_estimation = parameter(
+      visual, "enable_exposure_estimation", true);
+  config.gravity_alignment = parameter(
+      runtime, "enable_gravity_alignment", false);
+
+  config.voxel_map.max_iterations_ = parameter(map, "max_iterations", 5);
+  config.voxel_map.dept_err_ = parameter(map, "depth_error_degrees", 0.02);
+  config.voxel_map.beam_err_ = parameter(map, "beam_error_degrees", 0.05);
+  config.voxel_map.planner_threshold_ = parameter(
+      map, "plane_detection_threshold", 0.0025);
+  config.voxel_map.sigma_num_ = parameter(
+      map, "residual_sigma_multiplier", 3.0);
+  config.voxel_map.max_voxel_size_ = parameter(map, "max_voxel_size", 0.5);
+  config.voxel_map.max_layer_ = parameter(map, "max_octree_depth", 2);
+  config.voxel_map.max_points_num_ = parameter(
+      map, "max_points_per_voxel", 50);
+  config.voxel_map.layer_init_num_ = map["initialization_point_count_per_depth"]
+      ? map["initialization_point_count_per_depth"].as<std::vector<int>>()
+      : std::vector<int>{5, 5, 5, 5, 5};
+  config.voxel_map.is_pub_plane_map_ = false;
+  config.voxel_map.map_sliding_en = parameter(map, "enable_map_sliding", false);
+  config.voxel_map.half_map_size = parameter(map, "half_map_size", 100);
+  config.voxel_map.sliding_thresh = parameter(map, "sliding_threshold", 8.0);
+
+  const auto imu_from_lidar = slam_benchmark::target_from_source(
+      imu->calibration, lidar->calibration);
+  const auto camera_from_lidar = slam_benchmark::target_from_source(
+      camera->calibration, lidar->calibration);
+  config.imu_from_lidar_rotation = rotation(imu_from_lidar);
+  config.imu_from_lidar_translation = translation(imu_from_lidar);
+  config.camera_from_lidar_rotation = rotation(camera_from_lidar);
+  config.camera_from_lidar_translation = translation(camera_from_lidar);
+  config.camera_width = static_cast<int>(camera->calibration.image_width);
+  config.camera_height = static_cast<int>(camera->calibration.image_height);
+  std::copy_n(camera->calibration.intrinsics.begin(), 4,
+              config.camera_intrinsics.begin());
+  std::fill(config.camera_distortion.begin(), config.camera_distortion.end(), 0.0);
+  std::copy_n(camera->calibration.distortion.begin(),
+              std::min<std::size_t>(5, camera->calibration.distortion.size()),
+              config.camera_distortion.begin());
+
+  lidar_id_ = lidar->id;
+  imu_id_ = imu->id;
+  camera_id_ = camera->id;
+  sink_ = &sink;
+  frontend_ = std::make_unique<LIVMapper>(config);
+  return compatibility;
+}
+
+cv::Mat FastLivo2Adapter::convertImage(
+    const slam_benchmark::ImageFrame &frame) const {
+  if (frame.compressed) {
+    cv::Mat encoded(1, static_cast<int>(frame.data.size()), CV_8UC1,
+                    const_cast<std::byte *>(frame.data.data()));
+    cv::Mat result = cv::imdecode(encoded, cv::IMREAD_COLOR);
+    if (result.empty())
+      throw std::runtime_error("failed to decode compressed image");
+    return result;
+  }
+  if (!frame.width || !frame.height || !frame.row_stride ||
+      frame.data.size() < static_cast<std::size_t>(frame.row_stride) * frame.height)
+    throw std::runtime_error("invalid raw image buffer");
+  if (frame.encoding == "rgb8" || frame.encoding == "bgr8") {
+    cv::Mat source(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                   CV_8UC3, const_cast<std::byte *>(frame.data.data()),
+                   frame.row_stride);
+    if (frame.encoding == "rgb8") {
+      cv::Mat result;
+      cv::cvtColor(source, result, cv::COLOR_RGB2BGR);
+      return result;
+    }
+    return source.clone();
+  }
+  if (frame.encoding == "mono8" || frame.encoding == "8UC1") {
+    cv::Mat source(static_cast<int>(frame.height), static_cast<int>(frame.width),
+                   CV_8UC1, const_cast<std::byte *>(frame.data.data()),
+                   frame.row_stride);
+    cv::Mat result;
+    cv::cvtColor(source, result, cv::COLOR_GRAY2BGR);
+    return result;
+  }
+  throw std::runtime_error("unsupported raw camera encoding: " + frame.encoding);
+}
+
+void FastLivo2Adapter::process(const slam_benchmark::SensorSample &sample) {
+  if (sample.sensor_id == imu_id_) {
+    const auto *input = std::get_if<slam_benchmark::ImuSample>(&sample.payload);
+    if (!input) throw std::runtime_error("IMU sensor carried a non-IMU payload");
+    frontend_->feedImu(
+        {input->angular_velocity_rad_s[0], input->angular_velocity_rad_s[1],
+         input->angular_velocity_rad_s[2]},
+        {input->linear_acceleration_m_s2[0],
+         input->linear_acceleration_m_s2[1],
+         input->linear_acceleration_m_s2[2]},
+        seconds(sample.timestamp_ns));
+  } else if (sample.sensor_id == lidar_id_) {
+    const auto started = std::chrono::steady_clock::now();
+    const auto *input = std::get_if<slam_benchmark::PointCloud>(&sample.payload);
+    if (!input)
+      throw std::runtime_error("LiDAR sensor carried a non-cloud payload");
+    if (input->points.size() != input->point_time_offset_ns.size())
+      throw std::runtime_error("point/time array size mismatch");
+    auto cloud = std::make_shared<PointCloudXYZI>();
+    cloud->reserve(input->points.size());
+    for (std::size_t index = 0; index < input->points.size(); ++index) {
+      const auto &source = input->points[index];
+      PointType point;
+      point.x = source.x;
+      point.y = source.y;
+      point.z = source.z;
+      point.intensity = source.intensity;
+      point.curvature = static_cast<float>(
+          input->point_time_offset_ns[index] * 1e-6);
+      cloud->push_back(point);
+    }
+    frontend_->feedLidar(cloud, seconds(sample.timestamp_ns));
+    sink_->report_timing({
+        sample.timestamp_ns, "lidar_preprocess",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count()});
+  } else if (sample.sensor_id == camera_id_) {
+    const auto started = std::chrono::steady_clock::now();
+    const auto *input = std::get_if<slam_benchmark::ImageFrame>(&sample.payload);
+    if (!input)
+      throw std::runtime_error("camera sensor carried a non-image payload");
+    frontend_->feedImage(convertImage(*input), seconds(sample.timestamp_ns));
+    sink_->report_timing({
+        sample.timestamp_ns, "image_preprocess",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - started).count()});
+  }
+
+  frontend_->processAvailable();
+  for (const auto &timing : frontend_->drainTimings()) {
+    sink_->report_timing(
+        {nanoseconds(timing.timestamp), timing.stage, timing.duration_ms});
+  }
+  reportPose();
+}
+
+void FastLivo2Adapter::reportPose() {
+  if (!frontend_->initialized() || frontend_->stateTimestamp() <= 0.0) return;
+  slam_benchmark::Pose pose;
+  pose.timestamp_ns = nanoseconds(frontend_->stateTimestamp());
+  if (!trajectory_.empty() &&
+      pose.timestamp_ns <= trajectory_.back().timestamp_ns) return;
+  const auto &state = frontend_->state();
+  pose.translation_m = {state.pos_end.x(), state.pos_end.y(), state.pos_end.z()};
+  const Eigen::Quaterniond rotation(state.rot_end);
+  pose.rotation_xyzw = {rotation.x(), rotation.y(), rotation.z(), rotation.w()};
+  trajectory_.push_back(pose);
+  sink_->report_realtime_pose(pose);
+}
+
+void FastLivo2Adapter::finalize() {
+  frontend_->processAvailable();
+  for (const auto &timing : frontend_->drainTimings()) {
+    sink_->report_timing(
+        {nanoseconds(timing.timestamp), timing.stage, timing.duration_ms});
+  }
+  reportPose();
+  sink_->report_final_trajectory(trajectory_);
+}
