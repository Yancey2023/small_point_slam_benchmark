+void LIVMapper::feedLidar(const PointCloudXYZI::ConstPtr &cloud,
+                          double timestamp)
+{
+  auto filtered = std::make_shared<PointCloudXYZI>();
+  p_pre->process(cloud, filtered);
+  if (filtered->size() <= 1) return;
+  lid_raw_data_buffer.push_back(std::move(filtered));
+  lid_header_time_buffer.push_back(timestamp);
+  last_timestamp_lidar = timestamp;
+}
+
+void LIVMapper::feedImu(const V3D &angular_velocity,
+                        const V3D &linear_acceleration, double timestamp)
+{
+  if (last_timestamp_lidar < 0.0 || timestamp < last_timestamp_imu) return;
+  auto message = std::make_shared<ImuData>();
+  message->timestamp = timestamp;
+  message->angular_velocity = angular_velocity;
+  message->linear_acceleration = linear_acceleration;
+  imu_buffer.push_back(message);
+  last_timestamp_imu = timestamp;
+}
+
+void LIVMapper::feedImage(const cv::Mat &image, double timestamp)
+{
+  if (last_timestamp_lidar < 0.0 || timestamp <= last_timestamp_img + 0.02)
+    return;
+  img_buffer.push_back(image.clone());
+  img_time_buffer.push_back(timestamp);
+  last_timestamp_img = timestamp;
+}
+
+bool LIVMapper::processAvailable()
+{
+  bool processed = false;
+  while (sync_packages(LidarMeasures))
+  {
+    handleFirstFrame();
+    processImu();
+    stateEstimationAndMapping();
+    processed = true;
+  }
+  return processed;
 }
 
