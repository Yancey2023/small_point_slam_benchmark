+#include "preprocess.h"
+
+#include <algorithm>
+#include <cmath>
+
+Preprocess::Preprocess()
+    : lidar_type(AVIA), point_filter_num(1), blind(0.01),
+      blind_sqr(blind * blind), feature_enabled(false),
+      given_offset_time(true) {}
+
+Preprocess::~Preprocess() = default;
+
+void Preprocess::set(bool feat_en, int lid_type, double bld, int pfilt_num) {
+  feature_enabled = feat_en;
+  lidar_type = lid_type;
+  blind = bld;
+  blind_sqr = blind * blind;
+  point_filter_num = std::max(1, pfilt_num);
+}
+
+void Preprocess::process(const PointCloudXYZI::ConstPtr &input,
+                         PointCloudXYZI::Ptr &output) {
+  output->clear();
+  output->reserve(input->size());
+  std::size_t valid = 0;
+  float previous_time_ms = 0.0F;
+  for (const auto &source : input->points) {
+    PointType point = source;
+    if (!std::isfinite(point.x) || !std::isfinite(point.y) ||
+        !std::isfinite(point.z) || !std::isfinite(point.curvature))
+      continue;
+    if (point.curvature < previous_time_ms ||
+        point.curvature - previous_time_ms >= 1.0F)
+      point.curvature = previous_time_ms + (valid == 0 ? 0.0F : 0.004166667F);
+    previous_time_ms = point.curvature;
+    ++valid;
+    if (valid % static_cast<std::size_t>(point_filter_num) != 0) continue;
+    const double squared_range = point.x * point.x + point.y * point.y +
+                                 point.z * point.z;
+    if (squared_range >= blind_sqr) output->push_back(point);
+  }
+}
