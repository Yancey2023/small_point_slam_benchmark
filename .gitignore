# Third-party source trees populated by FetchContent. Their build trees stay
# under /build/.
/3rdparty_downloads/

# Downloaded upstream trees and generated patched source trees.
/algorithm_downloads/
/algorithm/*/source/

# Dataset payloads and benchmark outputs (manifests remain tracked).
/datasets/**/data/
/results/*
!/results/README.md

# Build/editor/Python artifacts.
/build/
/CMakeFiles/
/CMakeCache.txt
/out/
/.cache/
/.idea/
/.vscode/
__pycache__/
*.py[cod]
*.user
.DS_Store

# pnpm/Vite generated artifacts.
/node_modules/
/frontend/node_modules/
/frontend/dist/
/frontend/dist-server/
/frontend/vite.config.js
