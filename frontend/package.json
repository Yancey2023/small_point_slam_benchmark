{
  "name": "@slam-benchmark/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:static": "pnpm validate:report && vite --mode static",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "build:static": "pnpm typecheck && pnpm validate:report && vite build --mode static",
    "export:static": "pnpm generate:report && pnpm build:static",
    "generate:report": "node --import tsx server/generate-static-report.ts",
    "preview:static": "pnpm build:static && vite preview --mode static",
    "validate:report": "node --import tsx server/validate-static-report.ts",
    "start": "node dist-server/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.41",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.11.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
